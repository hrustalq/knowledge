# --- api ---
DATABASE_URL=postgresql://knowledge:knowledge@localhost:5432/knowledge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=knowledge
S3_FORCE_PATH_STYLE=true
# Origin browsers reach the bucket at, when it is not S3_ENDPOINT (production:
# the public site, proxied to MinIO). Empty = presign against S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# Max JSON/urlencoded request body. Unset, Express defaults to 100 kB — which is
# what made a large paste fail on every prose surface. Counts BYTES, not
# characters (Cyrillic is 2 bytes each), so keep it well above the DTO caps.
HTTP_BODY_LIMIT=2mb
ARCADE_URL=http://localhost:2480
ARCADE_DB=knowledge
ARCADE_USER=root
ARCADE_PASSWORD=playwithdata
# 'stub' is a hashed bag of words: it exists so the pipeline runs end to end with
# zero external deps, and it is NOT a retrieval model. It has no semantics, and at
# 384 buckets a real corpus collides hard — measured on a 467-page import, 18,888
# distinct terms filled all 384 buckets ~49 deep, giving 49% recall@1 when querying
# each page by its own exact title. Any real deployment wants a real embedder.
#
# Local, free, nothing leaves the machine (bge-m3 is multilingual, good on Russian):
#   ollama pull bge-m3
#   EMBEDDINGS_PROVIDER=openai-compatible
#   EMBEDDINGS_BASE_URL=http://localhost:11434/v1
#   EMBEDDINGS_MODEL=bge-m3
#   EMBEDDINGS_DIM=1024
# EMBEDDINGS_DIM must equal the model's output width: the worker builds the chunk
# vector index for exactly this dimension (#304), and ArcadeDB refuses to store a
# vector of any other length, so a wrong value here fails every indexing job with
# "Vector dimension does not match index dimension". Changing it rebuilds the
# index on the worker's next boot (vectors of the old length stay stored, are never
# ranked, and drop out as the sweeper re-embeds their pages). Changing
# provider/model/dim changes the embedding signature, and the stale sweeper
# reindexes on that drift.
EMBEDDINGS_PROVIDER=stub
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIM=384
# --- LLM relation extraction (Phase 4; 'none' disables, 'openai-compatible' needs BASE_URL with /v1) ---
# At 'none' the worker still runs the step, but only to clear stale edges — it
# creates none. Frontmatter relations:/tags: are then the ONLY source of graph
# edges, so a corpus imported from Confluence/Notion (no frontmatter) ends up with
# zero edges and every graph feature — related documents, impact analysis,
# expandGraph, explore_document_graph — returns empty by construction.
# Local: ollama pull qwen2.5:7b, then BASE_URL=http://localhost:11434/v1
EXTRACTOR_PROVIDER=none
EXTRACTOR_BASE_URL=
EXTRACTOR_MODEL=
EXTRACTOR_API_KEY=
EXTRACTOR_MIN_CONFIDENCE=0.5
EXTRACTOR_MAX_CHUNKS=20
# --- Phase 5 governance ---
# none = dev mode (anonymous admin, web app works with the demo workspace);
# api-key = Bearer <key> auth (create keys with 'make auth-bootstrap email=...')
AUTH_MODE=none
# Auth flow (login/signup/reset — active with AUTH_MODE=api-key)
AUTH_SESSION_TTL_HOURS=720
# #102: single-use kt_ ticket lifetime for ?token= on SSE / <img> URLs
AUTH_URL_TICKET_TTL_SEC=60
AUTH_RESET_TTL_MIN=30
AUTH_SIGNUP_ENABLED=true
# Workspace new signups auto-join (empty disables); demo workspace by default
AUTH_DEFAULT_WORKSPACE_ID=11111111-1111-4111-8111-111111111111
AUTH_DEFAULT_ROLE=viewer
# Base of every link a mail carries (verify, reset, invite, notifications)
WEB_BASE_URL=http://localhost:5173
AUTH_VERIFY_TTL_HOURS=48
AUTH_INVITE_TTL_HOURS=72
# true = an unconfirmed session can only reach /me, logout and resend-verification
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Enterprise SSO (#75, docs/features/54). Off by default: password + API keys only.
# Needs AUTH_MODE=api-key, and SETTINGS_ENCRYPTION_KEY to store a provider's client secret.
AUTH_SSO_ENABLED=false
# true = issuer/discovery/token URLs may be private addresses (on-prem Keycloak)
AUTH_SSO_ALLOW_PRIVATE_URLS=false
# Lifetime of one login transaction (start -> IdP -> callback), seconds
AUTH_SSO_STATE_TTL_SEC=600
# false = only SSO signs in; AUTH_BREAK_GLASS_EMAILS still may use a password
AUTH_PASSWORD_LOGIN_ENABLED=true
# Comma-separated addresses always allowed a password (the way back in when the IdP is down)
AUTH_BREAK_GLASS_EMAILS=
# LDAP / Active Directory bind sign-in as a provider kind (#75). Needs AUTH_SSO_ENABLED.
AUTH_LDAP_ENABLED=false
# true = plain ldap:// without StartTLS is accepted (sends passwords in clear; lab only)
AUTH_LDAP_ALLOW_INSECURE=false
# SCIM 2.0 provisioning (#75) at /v1/scim/v2 with per-workspace kscim_ tokens. Needs AUTH_MODE=api-key.
AUTH_SCIM_ENABLED=false
# Largest SCIM list page a client may ask for (count)
AUTH_SCIM_MAX_PAGE=200
# Mailer (docs/features/41): log = print messages to the worker log, send nothing.
# To see real mail locally: make infra-up-mailpit, then MAIL_TRANSPORT=smtp and
# MAIL_SMTP_URL=smtp://localhost:1025 — the inbox is http://localhost:8025
MAIL_TRANSPORT=log
MAIL_SMTP_URL=
# Credentials beside a credential-free URL, verbatim (no URL-encoding). Never
# both these and user:pass@ in MAIL_SMTP_URL — the API refuses to boot.
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=Knowledge <no-reply@localhost>
MAIL_NOTIFICATIONS_ENABLED=true
# Optional BM25 full-text alongside vectors: none | opensearch
# (start OpenSearch with 'make infra-up-opensearch')
FULLTEXT_PROVIDER=none
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=knowledge-chunks
# A search waits this long for BM25, then answers from vectors alone (#173)
FULLTEXT_TIMEOUT_MS=1500
# Worker stale sweeper: re-enqueue stuck/failed jobs, reindex on embedding drift
STALE_SWEEP_ENABLED=true
STALE_INDEXING_TIMEOUT_MIN=15
STALE_MAX_ATTEMPTS=5
# Page restrictions in search (#76). A caller's hidden/reachable page list goes
# to ArcadeDB and OpenSearch as a predicate up to this length; past it the
# stores filter in memory and search over-fetches by SEARCH_ACL_OVERFETCH.
ACL_DENY_LIST_MAX=5000
SEARCH_ACL_OVERFETCH=5
# Cap on candidates per leg for the one refill round after the permission filter
SEARCH_ACL_MAX_FETCH=500
# Worker tick copying changed restrictions onto ArcadeDB/OpenSearch chunk stamps
ACL_RESTAMP_TICK_MS=30000
ACL_RESTAMP_BATCH=200
# Live connections (SSE/WS) re-read a caller's page visibility after this many
# ms; an acl.changed event clears it at once.
ACL_CACHE_TTL_MS=5000
# Pending access requests expire after this many days.
ACCESS_REQUEST_TTL_DAYS=30
# Page verification & knowledge health (docs/features/39 + 40). Defaults a
# workspace's Knowledge health › Settings tab can override; not ceilings.
# Days a verification stamp holds before it reads "expired" (0 = never)
VERIFICATION_DEFAULT_REVIEW_DAYS=90
# Remind the owner this many days before a stamp expires
VERIFICATION_REMIND_BEFORE_DAYS=7
# No write / comment / verification for this long = "inactive" (0 disables)
PAGE_INACTIVE_AFTER_DAYS=180
# A head revision with at most this many body characters is an "empty" page
EMPTY_PAGE_MAX_CHARS=40
# API-side sweeper: expiry reminders, expiry notices, body_chars catch-up
VERIFICATION_SWEEP_ENABLED=true
# Multiply search scores by the page's verification state (false = pre-#66 order)
SEARCH_TRUST_RANKING=true
# Absolute cosine floor for the vector leg (#401): a semantic match below it is
# not a result, so a question nothing answers comes back empty. Model-specific:
# about 0.4 for bge-m3; keep 0 (off) on the stub embedder. A workspace may
# override it on Knowledge health → Settings.
SEARCH_MIN_COSINE=0
# Trusted-operator graph query row cap (POST /v1/graph/query)
GRAPH_QUERY_MAX_ROWS=200
# --- web (SSR) ---
API_URL_INTERNAL=http://localhost:3000
# --- AI assistant (docs/features/09; 'none' disables review/suggest, related always works) ---
# none | deepseek | gen-api | openai-compatible. All use the official `openai`
# SDK; the named ones only pre-fill the base URL and a default model, so
# ASSISTANT_API_KEY is all they need:
#   deepseek  https://api.deepseek.com     + deepseek-chat
#   gen-api   https://proxy.gen-api.ru/v1  + gpt-4-1  (gen-api.ru — an
#             OpenAI-compatible aggregator: one key reaches claude-sonnet-4-5,
#             gemini-2-5-flash and the rest by setting ASSISTANT_MODEL)
# `openai-compatible` needs ASSISTANT_BASE_URL (must include /v1) + ASSISTANT_MODEL.
ASSISTANT_PROVIDER=none
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
# Tool harness (/v1/assistant/ask): max tool executions per request + upstream timeout.
# Was 6 — one question spent it on search -> read x2 -> explore -> list_relations
# and then had to answer from half the evidence it asked for. Ceiling is 64.
ASSISTANT_MAX_TOOL_CALLS=24
# Answer confidence (docs/features/38): a cited page whose head changed longer ago
# than this many days counts as stale evidence. Lowers the badge, hides nothing.
ANSWER_STALE_SOURCE_DAYS=180
# Votes (thumbs up/down with a reason) and implicit low-confidence signals on
# answers, stored in answer_feedback with the question text. false refuses votes
# and records nothing.
ANSWER_FEEDBACK_ENABLED=true
# Purge feedback rows and closed knowledge issues older than this many days.
ANSWER_FEEDBACK_RETENTION_DAYS=180
# Usage & search analytics (#79): page views, searches and MCP tool calls as rows
# in PostgreSQL. A ceiling: a workspace may turn it off, never on past this.
ANALYTICS_ENABLED=true
# HMAC key that counts readers without naming them. Empty: derived from
# SETTINGS_ENCRYPTION_KEY; both empty, unique readers reset on every restart.
ANALYTICS_READER_SECRET=
# Per-view cap on a web view's active read time (ms).
ANALYTICS_READ_TIME_CAP_MS=1800000
# A page older than this nobody opened in the app within it is "unread"; one no
# search returned either is "dead" (knowledge health, project analytics).
ANALYTICS_DEAD_PAGE_DAYS=90
# Days analytics rows are kept (a ceiling: a workspace may only shorten it).
ANALYTICS_RETENTION_DAYS=180
# After this many days a recorded search keeps its hash and loses its text.
ANALYTICS_QUERY_TEXT_DAYS=90
# Knowledge issues (page reports, docs/features/38): reports one principal may
# file per 24 h, and sentinel report checks one workspace may have waiting —
# past the second a report stays open for a person instead of queueing a run.
KNOWLEDGE_ISSUE_DAILY_LIMIT=50
KNOWLEDGE_ISSUE_MAX_PENDING_CHECKS=10
# Coverage gaps (the surveyor agent, docs/features/38): how many days of answer
# feedback a run reads, the smallest cluster it reports, the cosine similarity two
# questions must reach to count as one topic, and the most signals read per run.
# The surveyor refuses to run on EMBEDDINGS_PROVIDER=stub.
COVERAGE_WINDOW_DAYS=30
COVERAGE_MIN_CLUSTER_SIZE=3
COVERAGE_SIMILARITY=0.82
COVERAGE_MAX_QUESTIONS=2000
# Styleguides (#74): most rules per styleguide; most violations one lint reports.
STYLEGUIDE_MAX_RULES=50
LINT_MAX_FINDINGS=15
# Style lint of merge requests (#74): the ceiling and default policy (off | warn |
# block — block holds a merge on unresolved error-severity violations), and how many checks one workspace may have waiting.
STYLE_LINT_POLICY=off
LINT_MAX_PENDING_PER_WORKSPACE=20
# Quality auditor (#74): most pages one run scores (one model call each at most),
# days a score stands before an unchanged page is re-scored (ai_settings may
# override), the mean-embedding cosine two pages must reach to count as
# near-duplicates (not measured on EMBEDDINGS_PROVIDER=stub), and the overall
# score below which a page becomes a finding.
QUALITY_AUDIT_MAX_PAGES=200
QUALITY_AUDIT_DAYS=7
QUALITY_DUPLICATE_THRESHOLD=0.92
QUALITY_FINDING_THRESHOLD=50
# The arbiter (#81): the chunk cosine two passages from different pages must
# reach to be judged (0.1 lower when the pages share an entity; not run on
# EMBEDDINGS_PROVIDER=stub), the judge confidence below which a contradiction
# is dropped, and the most pairs one run judges (one model call each).
CONTRADICTION_MIN_SIMILARITY=0.82
CONTRADICTION_MIN_CONFIDENCE=0.7
CONTRADICTION_MAX_PAIRS_PER_RUN=20
# Community summaries (#81): off by default — the atlas agent spends one model
# call per community it summarises (at most COMMUNITY_MAX_PER_RUN per run).
COMMUNITY_SUMMARIES_ENABLED=false
COMMUNITY_MAX_PER_RUN=30
# Ceiling for the page menu's "Open in ChatGPT / Claude / Cursor" (issue #68).
# false hides them in every workspace, whatever its AI settings say.
AI_EXTERNAL_ACTIONS_ENABLED=true
# Longest page put inline into an "Open in…" URL; longer pages go to the clipboard.
AI_ACTION_INLINE_MAX_CHARS=6000
# --- Agent-session memory (issue #73): coding agents propose what they learned as MRs ---
# ENABLED and the two limits are ceilings for each workspace's AI settings.
CAPTURE_ENABLED=true
CAPTURE_PER_KEY_PER_HOUR=30
CAPTURE_PER_WORKSPACE_PER_DAY=500
# Cosine vs the nearest page: >= DEDUPE is a duplicate candidate, >= AMEND amends that page.
# Measured on bge-m3 (make backtest ARGS="--captures", docs/features/50 §Calibration).
CAPTURE_DEDUPE_THRESHOLD=0.92
CAPTURE_AMEND_THRESHOLD=0.8
CAPTURE_MAX_CHARS=8000
CAPTURE_SWEEP_INTERVAL_MS=60000
CAPTURE_STALE_MS=300000
# --- API reference documents (#78): refused above these at finalize and ingestion ---
API_SPEC_MAX_BYTES=5000000
API_SPEC_MAX_OPERATIONS=2000
# The try-it proxy (#78) for APIs that refuse CORS. A CEILING the workspace's
# API settings can only narrow: off | allowlist (source policies) | open.
API_TRY_PROXY_MODE=off
API_TRY_ALLOW_PRIVATE_URLS=false
API_TRY_TIMEOUT_MS=15000
API_TRY_MAX_RESPONSE_BYTES=1000000
API_TRY_RATE_PER_MINUTE=30
# The QA server runner (#483): off | on. A CEILING; a workspace still opts in, and
# its steps go out through the try-it proxy's mode and source policies.
API_TEST_RUNNER_MODE=off
ASSISTANT_TIMEOUT_MS=60000
# --- AI settings (docs/features/12): per-workspace overrides of the ASSISTANT_* block ---
# AES-256-GCM key for provider credentials stored in the DB. Empty = the UI cannot
# save API keys (everything else still works). Generate: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# Allow MCP plugin URLs on private/loopback ranges (self-hosted MCP servers)
AI_PLUGINS_ALLOW_PRIVATE_URLS=false

# --- Web research (docs/features/25): the assistant's web_search / web_fetch ---
# WEB_ACCESS_MODE is a CEILING, not a default: a workspace may narrow it in AI
# settings and can never widen past it. `off` (the default) does not offer the
# two web tools to the model at all, so an existing deployment is unchanged.
#   off        the web tools do not exist
#   allowlist  an unlisted domain is refused; policy rows say what MAY be fetched
#   open       an unlisted domain is fetched; policy rows say what may NOT be
WEB_ACCESS_MODE=off
# SearXNG JSON endpoint. `make infra-up-searxng` runs one on :8888.
# Unset means fetching a named URL still works and searching does not.
WEB_SEARCH_URL=
# Allow web targets on private/loopback ranges (self-hosted SearXNG, intranet).
WEB_ALLOW_PRIVATE_URLS=false
WEB_FETCH_MAX_BYTES=2000000
WEB_TIMEOUT_MS=15000

# --- AI-readable output (issue #68) ---
# Plain-markdown reads for agents: GET /v1/documents/:id/markdown, Accept:
# text/markdown on /content, and /v1/llms.txt + workspace/project llms.txt and
# llms-full.txt. false 404s them.
AI_READABLE_ENABLED=true
# llms-full.txt caps (pages, bytes) and parallel S3 reads while streaming it.
LLMS_FULL_MAX_DOCS=2000
LLMS_FULL_MAX_BYTES=20000000
AI_READABLE_FETCH_CONCURRENCY=8
# --- Share links (docs/features/43, issue #77) ---
# Ceiling over the per-workspace switch in Settings -> Publishing, which is off
# until an admin turns it on. false refuses new links and 404s existing ones.
PUBLIC_SHARING_ENABLED=true
# Longest a link may live, in days; 0 = no cap (a "never" link is then allowed).
SHARE_LINK_MAX_TTL_DAYS=0
# How long a password-unlocked link stays open in one browser (minutes).
SHARE_UNLOCK_TTL_MIN=720
# Anonymous /v1/public routes: requests per IP per minute, and password attempts
# per IP and link per 15 minutes. Counted in Redis.
PUBLIC_RATE_LIMIT_PER_MIN=120
PUBLIC_UNLOCK_ATTEMPTS_PER_15MIN=10
# Exports a share link's readers may ask for in an hour (#161), per IP and link
# and per link across every address. Fails closed: with Redis down, none start.
PUBLIC_EXPORTS_PER_HOUR_PER_IP=5
PUBLIC_EXPORTS_PER_HOUR_PER_LINK=30
# --- Published sites (docs/features/44, issue #77) ---
# Ceiling over the per-workspace switch in Settings -> Publishing (off until an
# admin turns it on). false refuses to publish and 404s every live site.
PUBLIC_SITES_ENABLED=true
# Serve sites at <slug>.<PUBLISH_BASE_DOMAIN> (e.g. docs.example.com). Empty =
# path mode: ${WEB_BASE_URL}/pub/<slug>. The web SSR reads it too. In dev,
# docs.localhost works without DNS: browsers resolve *.localhost to loopback.
PUBLISH_BASE_DOMAIN=
# A live version rebuilds this long after the last change it saw (ms).
SITE_BUILD_DEBOUNCE_MS=30000
# Most pages one site version publishes.
SITE_MAX_PAGES=2000
# Web SSR: memory for cached site page renders, revalidated with the API on
# every request (issue #77 phase 2b-2). 0 turns the cache off.
SITE_RENDER_CACHE_MB=32
# --- Chat bots (issue #71) ---
# Master switch. Off: the bot webhook answers 404 and no question is answered;
# bots can still be prepared under Settings -> Chat bots.
CHAT_ENABLED=false
# Unanswered after this many seconds -> failed, and the placeholder says so.
CHAT_ANSWER_TIMEOUT_SECONDS=120
# Source links printed under one answer (0-10).
CHAT_MAX_SOURCES=5
# Lifetime of the link code the bot sends an unlinked account.
CHAT_LINK_CODE_TTL_MINUTES=15
# Questions per person per minute across every bot; the next gets "slow down".
CHAT_RATE_LIMIT_PER_USER_PER_MINUTE=10
# How often (ms) subscribed groups are checked for page / merge request news.
CHAT_DIGEST_TICK_MS=60000
# Bot API host: point at a self-hosted Bot API server or a proxy when
# api.telegram.org is not reachable from this host. The webhook itself is
# ${API_PUBLIC_URL}/v1/chat/<integrationId>/webhook and must be public HTTPS.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Time (self-hosted, Mattermost-shaped): the API holds one websocket per enabled
# Time bot. Allow a Time server on a private/loopback address (an in-house
# server is the usual case; the default refuses it as an SSRF shape).
CHAT_ALLOW_PRIVATE_URLS=false
# How often (ms) open Time websockets are compared with the enabled bots.
CHAT_SOCKET_SYNC_MS=15000
# Harvest (#82): `capture` in a chat thread proposes what it settled as captures.
# false answers `capture` with a notice. The thread read is capped at
# HARVEST_MAX_MESSAGES (root + newest replies); HARVEST_RATE_PER_HOUR is per person.
HARVEST_ENABLED=true
HARVEST_MAX_MESSAGES=200
HARVEST_RATE_PER_HOUR=10
# Telegram: a DM `/capture` reads what was forwarded in the last
# HARVEST_FORWARD_WINDOW_SEC; a listening group's messages are kept, masked,
# for CHAT_LISTEN_TTL_DAYS.
HARVEST_FORWARD_WINDOW_SEC=120
CHAT_LISTEN_TTL_DAYS=7
# Automatic harvest (#340): a binding an admin opts in has its quiet listening
# threads harvested by the API's sweeper, as that admin. HARVEST_AUTO_ENABLED is
# the ceiling over every binding's switch. A thread is due once it holds
# HARVEST_AUTO_MIN_MESSAGES new kept messages and has been quiet for
# HARVEST_AUTO_QUIET_MINUTES; at most HARVEST_AUTO_MAX_PER_TICK harvests per
# binding per minute.
HARVEST_AUTO_ENABLED=true
HARVEST_AUTO_MIN_MESSAGES=8
HARVEST_AUTO_QUIET_MINUTES=60
HARVEST_AUTO_MAX_PER_TICK=1
# Searchable chat (#339): an admin makes a bound group searchable (the bot tells
# the group first); its messages are kept masked for at most
# CHAT_SEARCH_RETENTION_DAYS (a workspace may only shorten it). Off: nothing
# new is kept and no binding can be switched on.
CHAT_SEARCH_ENABLED=true
CHAT_SEARCH_RETENTION_DAYS=90
# The worker indexes a thread in windows of at most CHAT_SEARCH_WINDOW_MESSAGES,
# split at CHAT_SEARCH_WINDOW_GAP_MIN minutes of silence; the last window waits
# until the thread has been quiet for CHAT_SEARCH_SETTLE_MIN minutes.
CHAT_SEARCH_WINDOW_MESSAGES=20
CHAT_SEARCH_WINDOW_GAP_MIN=30
CHAT_SEARCH_SETTLE_MIN=10
CHAT_SEARCH_TICK_SEC=60
# Sites on their own hostnames (custom domains, proven by a DNS TXT record).
# Needs a front proxy that routes those hosts here with TLS: Caddy on-demand TLS,
# see Caddyfile.sites.example. false hides the feature and resolves no custom host.
SITE_CUSTOM_DOMAINS=true
# PublishingSweeper tick (ms): re-checks pending domains, requeues lost builds.
PUBLISHING_SWEEP_INTERVAL_MS=60000
# How long a site sign-in lasts (minutes): a member through the app, or a
# visitor through a customer-signed JWT (never past the token's own exp).
SITE_VISITOR_TTL_MIN=1440
# Ask on published sites: the most answers one site may give a day (a ceiling
# over each site's own budget; 0 turns Ask off everywhere), and questions per
# minute from one address.
PUBLIC_ASK_DAILY_BUDGET=200
PUBLIC_ASK_RATE_PER_MIN=6
# --- Export (docs/features/45, issue #77 phase 2c) ---
# PDF goes through a Gotenberg sidecar: make infra-up-gotenberg, then
# http://localhost:3100. Empty = no PDF (ZIP and HTML still work).
GOTENBERG_URL=
# Where the worker reaches the web server, which renders an export's HTML.
WEB_INTERNAL_URL=http://localhost:5173
# Most pages and bytes (attachments included) one export may hold.
EXPORT_MAX_PAGES=500
EXPORT_MAX_BYTES=268435456
# How long a finished export can be downloaded before its file is deleted.
EXPORT_TTL_HOURS=72
# Exports one worker builds at once, and the wall clock one may take (ms).
EXPORT_CONCURRENCY=2
EXPORT_TIMEOUT_MS=600000
# --- Embeds (docs/features/64) ---
# Items per embed group (more stay links, with a warning), the Figma render
# scale and longest side of a snapshot, text kept per item, and the hours
# between checks of pinned frames for design changes.
EMBED_MAX_ITEMS=24
EMBED_SNAPSHOT_SCALE=2
EMBED_SNAPSHOT_MAX_PX=4096
EMBED_TEXT_MAX_BYTES=2048
EMBED_CHECK_INTERVAL_HOURS=6
# --- Agents (docs/features/20) ---
# Background agent schedules. Off by default: the failure mode of unattended AI
# is an avalanche, not a slow queue. A schedule also needs an owner — runs
# execute as that user and are capped by their role.
AGENT_SCHEDULE_ENABLED=false
# Event-triggered runs (#70): a page merged or indexed, a merge request opened,
# a connector synced, a signed webhook, an @mention. Kill switch for all of them —
# the worker's listener, the webhook route (404 while off) and mention runs (an
# @mention then gets the ordinary reply). Off by default; each trigger is also
# off until an admin enables it, and needs an owner to run as.
AGENT_TRIGGERS_ENABLED=false
# Triggered runs one workspace may have in flight at once.
AGENT_TRIGGER_MAX_ACTIVE=5
# Cooldown (minutes) a new trigger starts with, per page / merge request / connector.
AGENT_TRIGGER_COOLDOWN_MINUTES=60
# Signed agent webhooks: largest accepted body (bytes) and the replay window
# (seconds) X-Knowledge-Timestamp must fall within.
AGENT_WEBHOOK_MAX_BYTES=65536
AGENT_WEBHOOK_TOLERANCE_SECONDS=300
# Approved agent learnings (team corrections) one prompt takes, newest first. 0 turns them off.
AGENT_LEARNINGS_MAX=20
# --- Learner (#305) ---
# A fifth process (make dev-learner; the `learner` compose service) that clusters
# findings people kept dismissing and has the `coach` agent draft each recurring
# one as a PROPOSED learning an admin reviews, and flags active learnings that did
# not lower dismissals for archiving. It never activates or archives anything.
# Off by default: off, the process idles. It wakes every LEARNER_TICK_MS (ms) and
# passes over each workspace once a day. A cluster is dismissed findings of one
# agent in one project within LEARNER_WINDOW_DAYS at LEARNER_CLUSTER_THRESHOLD raw
# cosine, from LEARNER_MIN_DISMISSALS findings and LEARNER_MIN_PEOPLE dismissers.
# The threshold is calibrated for bge-m3 by `make backtest ARGS="--learner"`.
# LEARNER_MIN_RUNS runs on each side of an activation before the archive check.
LEARNER_ENABLED=false
LEARNER_TICK_MS=900000
LEARNER_WINDOW_DAYS=30
LEARNER_CLUSTER_THRESHOLD=0.7
LEARNER_MIN_DISMISSALS=3
LEARNER_MIN_PEOPLE=2
LEARNER_MIN_RUNS=20
# Re-read a repo connector's AGENTS.md / CLAUDE.md / .cursorrules after each sync into
# DISABLED skills (an enabled one changes only when an admin accepts the upstream diff).
REPO_GUIDANCE_IMPORT_ENABLED=true
# --- Dependent auto-reindex fan-out cap (docs/features/04; 0 disables) ---
DEPENDENT_REINDEX_MAX=20
# --- Merge gating: approvals required to merge (author's own never counts; 0 disables) ---
MR_REQUIRED_APPROVALS=1
# --- Live tracked-entity updates over WebSocket (/v1/events/ws) ---
LIVE_WS_ENABLED=true
# Server-side tracking config: comma-separated event types (exact or 'prefix.*'), '*' = all
LIVE_TRACKED_EVENTS=*
LIVE_WS_MAX_SUBSCRIPTIONS=8
# --- Real-time co-editing of drafts over /v1/collab (#80, docs/features/56) ---
# Off by default: the socket refuses with 4503 and nothing collab-related starts.
COLLAB_ENABLED=false
# Persist a shared draft this long after the last edit, and at least this often while typing.
COLLAB_STORE_DEBOUNCE_MS=2000
COLLAB_STORE_MAX_DEBOUNCE_MS=10000
# Encoded Y state ceiling per draft (8 MiB); a draft above it stops saving and its peers are closed (reason too-large).
COLLAB_MAX_DOC_BYTES=8388608
# Re-judge open connections this often: a demoted editor turns read-only, a revoked key is closed.
COLLAB_REAUTH_INTERVAL_SECONDS=300
# A draft edited since its last checkpoint is copied to MinIO at most this often; this many copies are kept.
COLLAB_CHECKPOINT_INTERVAL_MINUTES=15
COLLAB_CHECKPOINT_KEEP=20
# A draft with nothing unpublished, untouched this many days, is dropped (it reseeds on next open).
COLLAB_DRAFT_RETENTION_DAYS=30

# --- Dynamic document workflows (docs/features/17) ---
# Auto-start triggers are off per definition by default; this caps how many
# triggered runs one workspace may have in flight, because the failure mode of
# an event trigger is an LLM avalanche rather than a slow queue.
WORKFLOW_AUTOSTART_MAX_ACTIVE=5
# How long a node may sit claimed before the sweeper assumes the worker died and
# re-queues it. Generous: re-queueing a live step pays for the model call twice.
WORKFLOW_NODE_STALE_MS=900000
# Repo events (docs/features/32) may re-trigger the same workflow for the same
# page; page events may not. This bounds how often — an issue that opens, closes
# and reopens is three pieces of news, but a flow that closes an issue when it
# finishes makes the far side move, and that comes back as another event.
WORKFLOW_REPO_RETRIGGER_COOLDOWN_MINUTES=60

# --- Internationalization (docs/features/18) ---------------------------------
# Interface + API language when a request carries no ?lang=, no kn_lang cookie
# and no usable Accept-Language. Also the language worker-generated prose
# defaults to. Supported: en, ru.
I18N_DEFAULT_LOCALE=en

# --- Connectors (docs/features/19): external systems as sources/destinations ---
# Confluence, Jira, Notion and markdown/git repos, pulled and pushed per workspace.
# Credentials are encrypted with SETTINGS_ENCRYPTION_KEY (see the AI settings block above).
# Allow connector base URLs / git remotes on private ranges (on-prem Confluence, self-hosted GitLab)
CONNECTOR_ALLOW_PRIVATE_URLS=false
# Ceilings for one sync run
CONNECTOR_SYNC_MAX_ITEMS=1000
CONNECTOR_SYNC_TIMEOUT_MS=600000
# Worker sweeper for connectors with a sync interval set
CONNECTOR_SCHEDULE_ENABLED=true
# Items per checkpoint: how often a run saves its place, re-enqueues itself to
# beat the timeout on a large space, and notices a pause (docs/features/26)
CONNECTOR_SYNC_BATCH=25
# Minutes between ACL-only refreshes for a connector mirroring access (#76),
# unless the connector sets its own interval
CONNECTOR_ACL_SYNC_DEFAULT_MIN=60
# Trace every upstream request, every level of the tree walk, and the decision
# taken for each page. Verbose; for diagnosing a sync that pulled nothing.
CONNECTOR_DEBUG=false

# --- Code research (docs/features/31) ---
# A repository the assistant reads through the code tools is downloaded once
# and kept in memory. How long that snapshot stays fresh, and how much all the
# snapshots in one process may hold before the least recently used is dropped.
CODE_SNAPSHOT_TTL_MS=600000
CODE_SNAPSHOT_MAX_BYTES=268435456

# --- Repo wiki (docs/features/46) ---
# Ceilings on what a repository's .knowledge/wiki.yml (or a connector override)
# may ask for. Effort low = no AI calls, medium = one summary per page, high =
# medium plus reading the code. Diagram nodes cap every generated Mermaid chart.
WIKI_MAX_EFFORT=medium
WIKI_DIAGRAM_MAX_NODES=40
# Code-tool calls one section may make at effort high (lowers the agent's own budget).
WIKI_HIGH_EFFORT_MAX_TOOL_CALLS=24
# A push-triggered wiki run waits this long; pushes inside the window fold into it.
WIKI_PUSH_DEBOUNCE_MS=120000
# Release notes: tags generated on the first sync, and commits read per release.
CHANGELOG_MAX_RELEASES=20
CHANGELOG_MAX_COMMITS_PER_RELEASE=500

# Where this API is reachable from outside: the base of every callback and
# webhook URL it hands out (GitHub App below, chat-bot webhooks above). Behind
# a proxy that mounts the API under /api, include that suffix.
API_PUBLIC_URL=http://localhost:3000

# --- GitHub App (docs/features/28): the repository picker ---
# Optional. With GITHUB_APP_ID empty the picker is not offered and repository
# connectors keep taking a personal access token, exactly as before — so leaving
# this whole block unset is a supported configuration, not a broken one.
#
# Register at https://github.com/settings/apps/new with:
#   Callback URL and Setup URL: $API_PUBLIC_URL/v1/connectors/github/callback
#   Request user authorization (OAuth) during installation: on
#   Repository permissions -> Contents: Read-only (Read and write to push back)
# Then install it on the account or org whose repositories you want to reach.
#
# For work items and repo-event triggers (docs/features/32), additionally:
#   Repository permissions -> Issues: Read and write
#   Repository permissions -> Pull requests: Read and write
#   Organization permissions -> Projects: Read and write (Projects v2 boards)
#   Webhook -> Active: on
#   Webhook URL: $API_PUBLIC_URL/v1/connectors/github/webhook
#   Subscribe to events: Issues, Issue comment, Pull request,
#                        Pull request review, Push, Release, Project v2 item
GITHUB_APP_ID=
# The slug in the App's public URL, github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem GitHub generates. A .env file cannot hold newlines, so pass either
# base64 of the whole file (recommended) or one line with literal \n escapes:
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
# The App's webhook secret, from the same settings page. Empty means the
# App-level webhook refuses every delivery rather than trusting an unsigned one,
# so work items and repo-event triggers stay off until this is set.
GITHUB_APP_WEBHOOK_SECRET=
# Override for GitHub Enterprise Server
GITHUB_API_URL=https://api.github.com

# --- Tracker handoff (#424) ----------------------------------------------------
# Status sync between handed-off tickets and their knowledge objects: an
# API-side sweeper polls one tracker connector per tick (webhooks only make it
# faster), resolves a report/conflict whose ticket closed, and moves a ticket
# whose object was resolved here. false is the kill switch.
WORK_ITEM_SYNC_ENABLED=true
WORK_ITEM_SYNC_TICK_MS=15000
# Tickets the handoff rules (workspace settings) may create per tick, all
# workspaces together. 0 turns rule-driven handoff off everywhere.
WORK_ITEM_AUTOCREATE_MAX_PER_TICK=20

# --- Observability: structured logs, correlation, backtest streams -----------
# Every process emits one JSON object per line, carrying the trace id that links
# a browser action to the API request to the worker job it queued.
#
# Minimum level on stdout: trace|debug|info|warn|error|fatal|silent. The MCP
# process writes to stderr instead — its stdout carries JSON-RPC frames, and a
# single stray byte there corrupts the transport.
LOG_LEVEL=info
# Coloured, human-readable lines instead of JSON. On by default outside
# production: JSON is right for something that greps and aggregates, and wrong
# for a person watching a terminal. The record itself is identical either way —
# only the rendering changes — so turning this off in dev loses nothing but
# legibility. Colour is forced rather than auto-detected, because `make dev`
# pipes every process through turbo and stdout is therefore not a TTY.
LOG_PRETTY=true
# Directory for the measurement stream — one ops-<service>-YYYY-MM-DD.jsonl per
# service per day, read by the backtest harness. Gitignored.
#
# Leave it unset: the default is <repo root>/logs, resolved from the
# observability package's own location rather than the current directory. Each
# process starts somewhere different (the API in apps/api, the SSR server in
# apps/web), so a relative path here puts half of every cross-process trace in
# one file and half in another. Set it only to an absolute path.
# LOG_DIR=
# Also persist error-level records to ops_events, so failures are queryable in
# SQL beside audit_logs / activity_log. The stdout stream is unaffected either way.
OPS_SINK_ENABLED=true
# Write the search / ai / ingest measurement events to LOG_DIR. Deliberately
# separate from LOG_LEVEL: these are measurements rather than diagnostics, and a
# full corpus re-index emits tens of thousands of them.
OPS_JSONL_ENABLED=true
