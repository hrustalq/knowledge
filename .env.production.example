# Template for /srv/knowledge/.env on knowledge-prod.
#
# This file is a TEMPLATE and is committed. The real file lives ONLY on the VPS,
# is owned by the deploy user, and is chmod 600. No deployment workflow reads or
# writes it — rotating a secret means editing it over SSH and redeploying.
#
#   scp .env.production.example deploy@knowledge-prod:/srv/knowledge/.env
#   ssh deploy@knowledge-prod 'chmod 600 /srv/knowledge/.env && vi /srv/knowledge/.env'
#
# Hostnames below are Docker service names, resolvable only inside the compose
# network. The API validates all of this with zod at boot and FAILS FAST, so an
# incomplete file shows up as a restart-looping container, not a degraded app.

# ---------------------------------------------------------------- datastores
POSTGRES_USER=knowledge
POSTGRES_DB=knowledge
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://knowledge:CHANGE_ME@postgres:5432/knowledge?schema=public

REDIS_URL=redis://redis:6379

# MinIO root credentials AND the app's S3 credentials — the same pair.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# openssl rand -hex 16
S3_ACCESS_KEY=CHANGE_ME
# openssl rand -hex 32
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=knowledge
S3_FORCE_PATH_STYLE=true

ARCADE_URL=http://arcadedb:2480
ARCADE_DB=knowledge
ARCADE_USER=root
# openssl rand -hex 24
ARCADE_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------- auth
# MUST be api-key in production. The default `none` injects a synthetic
# principal with FULL ACCESS to every workspace — on a public domain that is an
# open read/write knowledge base. Create the first user with:
#   docker compose run --rm api node dist/scripts/bootstrap-auth.main.js --email you@example.com
AUTH_MODE=api-key
AUTH_SIGNUP_ENABLED=false
AUTH_SESSION_TTL_HOURS=720
AUTH_RESET_TTL_MIN=60
AUTH_DEFAULT_ROLE=viewer
WEB_BASE_URL=https://knowledge.hrustalq.dev

# ------------------------------------------------------------------- secrets
# AES-256-GCM key encrypting every stored AI-provider and connector credential.
# openssl rand -base64 32
# Losing or changing this makes those rows permanently undecryptable.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# -------------------------------------------------------------- embeddings/AI
# `stub` gives deterministic hash vectors and a working end-to-end pipeline with
# zero external dependencies. Switch to openai-compatible when you have a key —
# EMBEDDINGS_DIM must then match the model's real width or search silently
# returns nothing.
EMBEDDINGS_PROVIDER=stub
EMBEDDINGS_DIM=768

EXTRACTOR_PROVIDER=none
ASSISTANT_PROVIDER=none

# ------------------------------------------------------------------ optional
# Both stay off: OpenSearch and SearXNG do not fit in 3.8 GB beside a build.
FULLTEXT_PROVIDER=none
WEB_ACCESS_MODE=off

# ------------------------------------------------------------------- runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Structured JSON logs in production; pretty-printing is for a terminal.
LOG_PRETTY=false
I18N_DEFAULT_LOCALE=en

STALE_SWEEP_ENABLED=true
AGENT_SCHEDULE_ENABLED=false
CONNECTOR_SCHEDULE_ENABLED=false
LIVE_WS_ENABLED=true
