# The keys production runs with. The values live in the GitHub `production`
# environment (Settings -> Environments), not in this file and not on the box:
# deploy.yml renders ~/Homelab/infra/knowledge/.env from that environment's
# variables and secrets on every deploy (#134), so a hand edit on the Mac mini
# lasts only until the next release. Rotating a secret = change it there, redeploy.
#
# A key given a value below is REQUIRED: the deploy fails before building if the
# environment lacks it, or if a value still contains CHANGE_ME. A key left empty
# here is optional (GitHub refuses empty values; absent means the code default).
# GitHub also refuses names starting GITHUB_: store those as GH_* (GH_APP_ID for
# GITHUB_APP_ID) and the deploy renames them back.
#
# Fill the environment from this template plus an existing .env — later files
# win, CHANGE_ME and empty values are skipped; dry run unless --apply:
#   ssh macmini 'cat ~/Homelab/infra/knowledge/.env' |
#     node scripts/env-to-github.mjs .env.production.example - [--apply]
#
# Hostnames below are Docker service names, resolvable only inside the compose
# network. The API validates all of this with zod at boot and FAILS FAST, so an
# incomplete file shows up as a restart-looping container, not a degraded app.

# ---------------------------------------------------------------- datastores
POSTGRES_USER=knowledge
POSTGRES_DB=knowledge
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://knowledge:CHANGE_ME@postgres:5432/knowledge?schema=public

REDIS_URL=redis://redis:6379

# MinIO root credentials AND the app's S3 credentials — the same pair.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# openssl rand -hex 16
S3_ACCESS_KEY=CHANGE_ME
# openssl rand -hex 32
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=knowledge
S3_FORCE_PATH_STYLE=true
# Origin browsers reach the bucket at: presigned upload/download URLs are signed
# for it, and the Caddyfile routes /<S3_BUCKET>/* on it to MinIO. Without it
# every URL points at http://minio:9000 and uploads and attachments fail (#144).
S3_PUBLIC_ENDPOINT=https://knowledge.hrustalq.dev
# S3_PUBLIC_ENDPOINT's host, which Caddy hands MinIO as Host so the signatures
# match. docker-compose.prod.yml defaults it to knowledge.hrustalq.dev; set it
# only if S3_PUBLIC_ENDPOINT moves.
# S3_PUBLIC_HOST=

ARCADE_URL=http://arcadedb:2480
ARCADE_DB=knowledge
ARCADE_USER=root
# openssl rand -hex 24
ARCADE_PASSWORD=CHANGE_ME

# The Cloudflare Worker's proof that a request came through it (#174): Caddy
# believes the visitor's address and host from X-Knowledge-* only alongside it.
# Store it as a SECRET in the production environment AND as the Worker's
# binding: EDGE_SECRET=<same value> deploy/edge/deploy.sh. Hex only (the
# Caddyfile's header matcher treats a leading/trailing * as a wildcard).
# Rotate: new value -> Worker (deploy.sh) -> environment -> redeploy; in between,
# requests count against Cloudflare's address as they did before #174.
# openssl rand -hex 32
EDGE_SECRET=CHANGE_ME

# SearXNG's server.secret_key (docker-compose.prod.yml passes it to searxng).
# openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME

# ---------------------------------------------------------------------- auth
# MUST be api-key in production. The default `none` injects a synthetic
# principal with FULL ACCESS to every workspace — on a public domain that is an
# open read/write knowledge base. Create the first user with:
#   docker compose run --rm api node dist/scripts/bootstrap-auth.main.js --email you@example.com
AUTH_MODE=api-key
AUTH_SIGNUP_ENABLED=false
AUTH_SESSION_TTL_HOURS=720
# #102: single-use kt_ ticket lifetime for ?token= on SSE / <img> URLs
AUTH_URL_TICKET_TTL_SEC=60
AUTH_RESET_TTL_MIN=60
AUTH_DEFAULT_ROLE=viewer
WEB_BASE_URL=https://knowledge.hrustalq.dev
# Lifetimes of the mailed links (docs/features/41)
AUTH_VERIFY_TTL_HOURS=48
AUTH_INVITE_TTL_HOURS=72
# true = an unconfirmed session can only reach /me, logout and resend-verification
AUTH_REQUIRE_VERIFIED_EMAIL=false
# Enterprise SSO (#75, docs/features/54). Off by default: password + API keys only.
# Needs AUTH_MODE=api-key, and SETTINGS_ENCRYPTION_KEY to store a provider's client secret.
AUTH_SSO_ENABLED=false
# true = issuer/discovery/token URLs may be private addresses (on-prem Keycloak)
AUTH_SSO_ALLOW_PRIVATE_URLS=false
# Lifetime of one login transaction (start -> IdP -> callback), seconds
AUTH_SSO_STATE_TTL_SEC=600
# false = only SSO signs in; AUTH_BREAK_GLASS_EMAILS still may use a password
AUTH_PASSWORD_LOGIN_ENABLED=true
# Comma-separated addresses always allowed a password (the way back in when the IdP is down)
AUTH_BREAK_GLASS_EMAILS=
# LDAP / Active Directory bind sign-in as a provider kind (#75). Needs AUTH_SSO_ENABLED.
AUTH_LDAP_ENABLED=false
# true = plain ldap:// without StartTLS is accepted (sends passwords in clear; lab only)
AUTH_LDAP_ALLOW_INSECURE=false
# SCIM 2.0 provisioning (#75) at /v1/scim/v2 with per-workspace kscim_ tokens. Needs AUTH_MODE=api-key.
AUTH_SCIM_ENABLED=false
# Largest SCIM list page a client may ask for (count)
AUTH_SCIM_MAX_PAGE=200

# ---------------------------------------------------------------------- mail
# log = print every message to the worker log, send nothing (the default).
# smtp = send through MAIL_SMTP_URL. smtps://…:465 is implicit TLS,
# smtp://…:587 upgrades with STARTTLS. Keep the URL credential-free (a plain
# variable, e.g. smtps://smtp.timeweb.ru:465) and put the login in
# MAIL_SMTP_USER (variable) + MAIL_SMTP_PASS (secret), verbatim. user:pass@ in
# the URL still works, URL-encoded, but never both: the API refuses to boot.
# Prove the box can reach the relay before relying on it:
#   docker compose exec api node dist/scripts/send-test-mail.main.js --to you@example.com
MAIL_TRANSPORT=log
MAIL_SMTP_URL=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# The From domain needs SPF + DKIM at the provider, or mail lands in spam.
MAIL_FROM=Knowledge <no-reply@hrustalq.dev>
# Operator switch for mention / review / assignment mail (auth mail unaffected)
MAIL_NOTIFICATIONS_ENABLED=true

# ------------------------------------------------------------------- secrets
# AES-256-GCM key encrypting every stored AI-provider and connector credential.
# openssl rand -base64 32
# Losing or changing this makes those rows permanently undecryptable.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# -------------------------------------------------------------- embeddings/AI
# bge-m3 (1024-d) served by Ollama.app on the host itself (#257): nothing
# leaves the box, Metal does the work, and it sits outside Colima's 10 GiB.
# Containers reach the host as host.docker.internal; the /v1 suffix is required,
# because the provider appends /embeddings. EMBEDDINGS_DIM must match the
# model's real width or search silently returns nothing.
#
# On the host: `ollama pull bge-m3`, and the LaunchAgent
# ~/Library/LaunchAgents/dev.hrustalq.ollama-keepalive.plist sets
# OLLAMA_KEEP_ALIVE=-1 at login and restarts Ollama.app, because Ollama's /v1
# endpoint ignores a per-request keep_alive. `ollama ps` should say Forever.
#
# Rollback: set EMBEDDINGS_PROVIDER=stub and EMBEDDINGS_DIM=768 in the
# environment (the other two are then ignored) and redeploy. The signature
# changes, so StaleSweeper reindexes every branch head back on its own.
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIM=1024
# Search relevance floor (#401), measured for bge-m3 on the prod corpus:
# off-topic queries top out near 0.37, real questions start near 0.49. Back to
# 0 on any rollback to the stub embedder, or every search comes back empty.
SEARCH_MIN_COSINE=0.4

EXTRACTOR_PROVIDER=none
ASSISTANT_PROVIDER=none

# ------------------------------------------------------------------ optional
# Opt-in services in docker-compose.prod.yml. Compose reads this from the .env
# beside the compose file, so the deploy's `up -d` starts exactly these.
COMPOSE_PROFILES=gotenberg,opensearch

# PDF export (docs/features/45). Empty = the PDF format is not offered.
GOTENBERG_URL=http://gotenberg:3000

# BM25 keyword search fused with vector search. It carries exact terms the
# vector leg can miss, and every page during a reindex. It is a pulled image (no
# build) held to a 512 MB heap in a 1.5 GB container. `none` turns it off;
# drop `opensearch` from COMPOSE_PROFILES too.
FULLTEXT_PROVIDER=opensearch
OPENSEARCH_URL=http://opensearch:9200

# Web research (docs/features/25). SearXNG holds ~90 MB, against ArcadeDB's
# ~550 MB.
#
# WEB_ACCESS_MODE is a CEILING, not a default: a workspace may narrow it in AI
# settings but can never widen past it. `open` fetches any domain a policy row
# does not deny; `allowlist` refuses every domain a row does not permit, which
# with an empty source_policies table means fetching nothing at all.
WEB_ACCESS_MODE=open
# Compose-network name of the searxng service. Without it, fetching a named URL
# still works and searching does not.
WEB_SEARCH_URL=http://searxng:8080

# ------------------------------------------------------------------- runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Structured JSON logs in production; pretty-printing is for a terminal.
LOG_PRETTY=false
I18N_DEFAULT_LOCALE=en

STALE_SWEEP_ENABLED=true
AGENT_SCHEDULE_ENABLED=false
AGENT_TRIGGERS_ENABLED=false
CONNECTOR_SCHEDULE_ENABLED=false
# The learner (#305) runs only with COMPOSE_PROFILES naming `learner` AND
# LEARNER_ENABLED=true. Every LEARNER_* has a default in env.ts, so these stay
# commented and the deploy's environment check asks for nothing new; set the
# ones you change in the GitHub `production` environment, not here.
# LEARNER_ENABLED=false
# LEARNER_TICK_MS=900000
# LEARNER_WINDOW_DAYS=30
# LEARNER_CLUSTER_THRESHOLD=0.7
# LEARNER_MIN_DISMISSALS=3
# LEARNER_MIN_PEOPLE=2
# LEARNER_MIN_RUNS=20
# Decision pre-filters (#530, docs/features/67): `gen-api` lets a workspace
# route a GenAPI profile to Decisions in AI settings; gen-api keeps request
# content and forwards it to TypeSafe (US). Defaults to none in env.ts, so it
# stays commented; set it in the GitHub `production` environment to turn on.
# DECISION_PROVIDER=none
# Memos (#551, docs/features/68): off until a speech server is set. A
# self-hosted one on the mini, e.g. http://192.168.20.10:8000/v1 (speaches),
# or TRANSCRIPTION_PROVIDER=gen-api with TRANSCRIPTION_API_KEY alone (#584).
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_BASE_URL=
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_API_KEY=
LIVE_WS_ENABLED=true
# Co-editing (docs/features/56): one shared draft per page and branch, served
# by the API at /v1/collab on the same /api route as /v1/events/ws. Drafts
# live in Postgres, peers fan out over the existing Redis.
COLLAB_ENABLED=true

# ------------------------------------------------- GitHub App (features/30)
# Optional. Leave GITHUB_APP_ID empty and the repository picker is simply not
# offered — git connectors keep asking for a personal access token, which is a
# supported configuration rather than a degraded one.
#
# Register at https://github.com/settings/apps/new with Callback URL and Setup
# URL both set to $API_PUBLIC_URL/v1/connectors/github/callback, "Request user
# authorization (OAuth) during installation" ON, "Redirect on update" ON,
# "Where can this GitHub App be installed?" -> Any account (otherwise no org
# can install it), permissions per connectors/github/github-access.ts, and the
# webhook ON at $API_PUBLIC_URL/v1/connectors/github/webhook (features/32).
#
# All five keys below go together (plus SETTINGS_ENCRYPTION_KEY). Set some but
# not all and the repository step names the missing ones to an admin (#552).
#
# Where this API is reachable from a browser. Note the /api suffix: Caddy
# proxies /api/* to the container and strips the prefix, so this is the public
# origin of the API even though the container itself serves /v1/*.
API_PUBLIC_URL=https://knowledge.hrustalq.dev/api
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Compose's env_file cannot hold a multi-line value, so the .pem must be
# base64-encoded onto one line:
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com

# ------------------------------------------- Figma OAuth app (features/64)
# Optional, left empty here so the deploy check does not demand it: set the id
# as a GH `production` variable and the secret as a secret. Publish the app as
# PRIVATE (a draft app works only for its developer and plan admins), redirect
# URL $API_PUBLIC_URL/v1/connectors/figma/callback, scopes folders:read
# file_content:read file_metadata:read current_user:read. Empty id = PAT only.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------- published sites
# docs/features/44. Empty = path mode, https://knowledge.hrustalq.dev/pub/<slug>.
# This deployment's TLS ends at Cloudflare (Worker -> Funnel -> Caddy on plain
# HTTP), so Caddy cannot issue certificates for other hosts: a base domain or a
# custom domain needs the edge to route those hosts here first (a wildcard
# route, Cloudflare for SaaS). Until then keep both off. docker-compose.prod.yml
# hands PUBLISH_BASE_DOMAIN to the web container too.
PUBLISH_BASE_DOMAIN=
SITE_CUSTOM_DOMAINS=false

# ----------------------------------------------------------------- chat bots
# docs/features/47. Off in this deployment. api.telegram.org cannot be reached
# from this host (its RU egress drops the connection), so a Telegram bot could
# not register its webhook or reply. Before switching this on, point
# TELEGRAM_API_BASE_URL at a self-hosted Bot API server or a proxy this host
# can reach. Telegram then delivers to $API_PUBLIC_URL/v1/chat/<id>/webhook.
# Bot tokens are stored under SETTINGS_ENCRYPTION_KEY. A Time server on the
# private network also needs CHAT_ALLOW_PRIVATE_URLS=true.
CHAT_ENABLED=false
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# CHAT_ALLOW_PRIVATE_URLS=false
