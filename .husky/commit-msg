# Conventional Commits gate. See commitlint.config.js and CONTRIBUTING.md#commits.
#
# This is cheap (no build, no infra) unlike the pre-push hook, so it runs on every
# commit rather than being deferred to CI. It has to: the release bump is chosen
# from `git log <lastTag>..dev`, and a malformed subject is only discoverable at
# release time, when the author has moved on.
pnpm exec commitlint --edit "$1"
