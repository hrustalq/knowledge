# Reverse proxy for knowledge.hrustalq.dev on the Mac mini.
#
# The public path is a Cloudflare Worker on knowledge.hrustalq.dev, which
# forwards to this Mac mini's Tailscale Funnel URL, which Funnel delivers to
# 127.0.0.1:8088 -> this container. TLS ends at Cloudflare and again at Funnel,
# so Caddy serves plain HTTP and issues no certificates.
#
# The whole browser surface of this app is /api/* — verified in three places:
#   apps/web/src/api/http.ts:86-88   baseURL defaults to '/api'
#   apps/web/src/api/live.ts:24-25   WebSocket is wss://<host>/api/v1/events/ws
#   apps/web/src/lib/api.ts:378-384  resolveAssetUrl prefixes attachments/avatars
# In development the Vite middleware strips that prefix (vite.config.ts:19).
# The one other path a browser follows is a presigned object URL under
# /<S3_BUCKET>/, which goes straight to MinIO (#144, route below).
# Production server.js installs NO such proxy, so stripping it is this file's job
# and `handle_path` must mirror Vite's rewrite exactly.

{
	auto_https off
	servers {
		# Funnel reaches Caddy through Docker's loopback port forward, so the
		# peer is always private. Trusting it is what makes reverse_proxy pass
		# the X-Forwarded-For / X-Forwarded-Host written below to the API and
		# web (appending the peer) instead of replacing them.
		#
		# Caddy resolves {client_ip} before any handler runs, so the access
		# log's client_ip is Funnel's view (Cloudflare's egress), never the
		# visitor; the visitor is the logged X-Knowledge-Client-IP header.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

# Any Host: requests arrive with the Funnel hostname, and a bare :80 also
# answers the loopback smoke check on 127.0.0.1:8088.
:80 {
	encode zstd gzip

	# The visitor (#174). Funnel overwrites X-Forwarded-For with Cloudflare's
	# egress address and X-Forwarded-Host with the *.ts.net name, so the Worker
	# (deploy/edge/worker.js) carries the visitor's address and host in
	# X-Knowledge-Client-IP / X-Knowledge-Host, which Funnel leaves alone. The
	# *.ts.net URL is public, so those are believed only alongside the shared
	# secret; then they become the X-Forwarded-For / X-Forwarded-Host that
	# clientIp (public-rate-limit.ts) and requestHost (server/site-files.js)
	# already read. Anything else keeps Funnel's values, so a forged header on a
	# direct request is ignored, and all three are dropped before any upstream.
	#
	# Same-directive order: the @edge rewrites sort ahead of the unmatched
	# deletes, so the placeholders are read before their headers go.
	@edge header X-Knowledge-Edge {$EDGE_SECRET}
	request_header @edge X-Forwarded-For {header.X-Knowledge-Client-IP}
	request_header @edge X-Forwarded-Host {header.X-Knowledge-Host}
	request_header -X-Knowledge-Edge
	request_header -X-Knowledge-Client-IP
	request_header -X-Knowledge-Host

	# handle_path strips the matched prefix before proxying: /api/v1/documents
	# reaches the API as /v1/documents. WebSocket upgrades (/api/v1/events/ws)
	# and SSE (/api/v1/events) both pass through this same route — Caddy
	# upgrades transparently and disables response buffering for
	# text/event-stream, so neither needs special handling.
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Object storage, for presigned URLs only (#144). The API signs browser
	# URLs for S3_PUBLIC_ENDPOINT (this site), path-style, so every one starts
	# with /<bucket>/. `handle`, not `handle_path`: MinIO needs the bucket
	# segment. Nothing else of MinIO is routed — no console, no admin API, and
	# the bucket is private, so an unsigned request is refused by MinIO itself.
	# No SSR route starts with /knowledge/ (/knowledge-health does not match).
	#
	# SigV4 signs the Host, and every URL is signed for S3_PUBLIC_ENDPOINT's
	# host, so MinIO must see exactly that or it answers SignatureDoesNotMatch.
	# Neither request header can say it: the Worker reaches Funnel as the
	# *.ts.net name, and Funnel overwrites the X-Forwarded-Host the Worker sets
	# with that same name. So the host is configuration, not a header.
	handle /{$S3_BUCKET:knowledge}/* {
		reverse_proxy minio:9000 {
			header_up Host {$S3_PUBLIC_HOST}
		}
	}

	# Everything else is the SSR app.
	handle {
		reverse_proxy web:5173
	}

	# `?token=` still authenticates SSE and <img> requests (the @QueryTokenOk
	# routes, #102), and a presigned object URL is a bearer credential until it
	# expires, so mask both before the URI reaches the access log.
	# Authorization and Cookie headers are already redacted by Caddy's default;
	# the edge secret is not, and the log records headers as they arrived.
	log {
		output stderr
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
					replace X-Amz-Signature REDACTED
				}
				request>headers>X-Knowledge-Edge replace REDACTED
			}
		}
	}
}
