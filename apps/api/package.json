{
  "name": "@knowledge/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "depcruise": "depcruise src --output-type err-long --ignore-known",
    "depcruise:baseline": "depcruise src --baseline --baseline-mode shrink-only",
    "depcruise:graph": "depcruise src --output-type archi | dot -T svg > dependency-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker.main",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "dev:mcp": "nest start --watch --entryFile mcp.main",
    "start:mcp": "node dist/mcp.main"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@knowledge/contracts": "workspace:*",
    "@knowledge/observability": "workspace:*",
    "@knowledge/workflow": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-ws": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/client": "^6.16.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "bullmq": "^5.56.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.4.1",
    "mammoth": "^1.12.2",
    "marked": "^18.0.11",
    "nestjs-i18n": "^10.8.5",
    "openai": "^7.9.0",
    "pino": "^10.3.1",
    "prisma": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "turndown": "^7.2.4",
    "undici": "^8.10.2",
    "unpdf": "^1.8.1",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.21.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
