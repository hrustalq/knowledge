generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  // Workspace > Project > Document. Denormalized against projects.workspace_id
  // on purpose: the S3 key layout, the graph predicate, ingestion_jobs and
  // activity_log all key off workspace_id, so it stays. Services enforce
  // project.workspaceId === document.workspaceId on create and on move.
  projectId     String   @map("project_id") @db.Uuid
  title         String
  defaultBranch String   @default("main") @map("default_branch")
  // Feature 07 categorization: constrained in the API layer (DOCUMENT_CATEGORIES).
  category      String   @default("other")
  // Feature 08 nesting: Confluence-style hierarchy; no FK so children of a
  // deleted/legacy parent surface as roots instead of breaking.
  parentId      String?  @map("parent_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  project       Project            @relation(fields: [projectId], references: [id])
  branches      DocumentBranch[]
  revisions     DocumentRevision[]
  mergeRequests MergeRequest[]
  attachments   Attachment[]
  threads       DocumentThread[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, category])
  @@index([projectId, createdAt])
  @@index([projectId, category])
  @@index([parentId])
  @@map("documents")
}

model DocumentBranch {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  name           String
  headRevisionId String?  @map("head_revision_id") @db.Uuid
  protected      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  document   Document           @relation(fields: [documentId], references: [id])
  revisions  DocumentRevision[]
  mrAsSource MergeRequest[]     @relation("mrSource")
  mrAsTarget MergeRequest[]     @relation("mrTarget")

  @@unique([documentId, name])
  @@map("document_branches")
}

model DocumentRevision {
  id             String    @id @default(uuid()) @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  revisionNumber Int       @map("revision_number")
  // Unknown until finalize (presigned upload flow); PG unique constraints ignore NULLs.
  contentHash    String?   @map("content_hash")
  contentType    String    @map("content_type")
  s3Key          String    @map("s3_key")
  s3VersionId    String?   @map("s3_version_id")
  authorId       String    @map("author_id") @db.Uuid
  message        String?
  status         String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finalizedAt    DateTime? @map("finalized_at") @db.Timestamptz
  // Phase 5 stale detection: when + with which embedding signature this
  // revision was last indexed (provider:model:dim); drift triggers reindex.
  indexedAt      DateTime? @map("indexed_at") @db.Timestamptz
  embeddingModel String?   @map("embedding_model")

  document Document         @relation(fields: [documentId], references: [id])
  branch   DocumentBranch?  @relation(fields: [branchId], references: [id])
  parents  RevisionParent[] @relation("child")
  children RevisionParent[] @relation("parent")

  @@unique([documentId, revisionNumber])
  // Branch-scoped: a merge revision legitimately repeats the source head's
  // content on the target branch (plan.md §8); dedupe stays per-branch.
  @@unique([documentId, branchId, contentHash])
  @@map("document_revisions")
}

/// Confluence-style page attachments (images, PDFs, files embedded in the
/// editor). Bytes live in MinIO under the document's prefix, never in PG; the
/// row is the addressable handle the markdown links to, so an attachment
/// survives revisions the way the S3 object does. Rows are created `pending`
/// (presigned PUT issued) and flip to `ready` once the object is confirmed —
/// an abandoned upload therefore never renders as a broken embed.
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @default(0) @map("size_bytes")
  s3Key       String   @map("s3_key")
  status      String   @default("pending")
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("attachments")
}

model RevisionParent {
  revisionId       String @map("revision_id") @db.Uuid
  parentRevisionId String @map("parent_revision_id") @db.Uuid
  parentOrder      Int    @default(1) @map("parent_order") @db.SmallInt

  revision DocumentRevision @relation("child", fields: [revisionId], references: [id])
  parent   DocumentRevision @relation("parent", fields: [parentRevisionId], references: [id])

  @@id([revisionId, parentRevisionId])
  @@map("revision_parents")
}

// Table created in Phase 1; compare endpoints land in Phase 2.
model RevisionDiff {
  id             String   @id @default(uuid()) @db.Uuid
  fromRevisionId String   @map("from_revision_id") @db.Uuid
  toRevisionId   String   @map("to_revision_id") @db.Uuid
  format         String
  additions      Int      @default(0)
  deletions      Int      @default(0)
  changes        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([fromRevisionId, toRevisionId, format])
  @@map("revision_diffs")
}

model IngestionJob {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  revisionId  String    @map("revision_id") @db.Uuid
  type        String
  status      String    @default("queued")
  attempts    Int       @default(0)
  payload     Json
  error       Json?
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Outbox sweeper scan
  @@index([status, createdAt])
  @@map("ingestion_jobs")
}

// Phase 3 (plan.md §8): GitLab-style merge requests over the revision DAG.
model MergeRequest {
  id             String @id @default(uuid()) @db.Uuid
  documentId     String @map("document_id") @db.Uuid
  sourceBranchId String @map("source_branch_id") @db.Uuid
  targetBranchId String @map("target_branch_id") @db.Uuid

  title       String
  description String?
  // open | merged | closed
  status      String  @default("open")
  // Draft merge requests cannot be merged until the flag is cleared.
  isDraft     Boolean @default(false) @map("is_draft")
  authorId    String  @map("author_id") @db.Uuid
  // Single assignee (GitLab-style; advisory like reviewers). No FK — see MergeRequestReviewer.
  assigneeId  String? @map("assignee_id") @db.Uuid
  // Author ids that approved (auth stub until Phase 5).
  approvedBy  Json    @default("[]") @map("approved_by")

  // merge-commit | squash — set when merged.
  strategy         String?
  mergedRevisionId String?   @map("merged_revision_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  mergedAt         DateTime? @map("merged_at") @db.Timestamptz
  closedAt         DateTime? @map("closed_at") @db.Timestamptz

  document     Document               @relation(fields: [documentId], references: [id])
  sourceBranch DocumentBranch         @relation("mrSource", fields: [sourceBranchId], references: [id])
  targetBranch DocumentBranch         @relation("mrTarget", fields: [targetBranchId], references: [id])
  reviewers    MergeRequestReviewer[]
  threads      MergeRequestThread[]

  @@index([documentId, status])
  @@index([authorId])
  @@map("merge_requests")
}

// Assigned reviewers (advisory — merge is gated by approval count, not by
// reviewer state). userId intentionally has no FK to users: it mirrors the
// authorId pattern above (the zeros AUTHOR_ID_STUB is not a real user row);
// membership is validated in the service against workspace_members.
model MergeRequestReviewer {
  id             String   @id @default(uuid()) @db.Uuid
  mergeRequestId String   @map("merge_request_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  addedBy        String?  @map("added_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  mergeRequest MergeRequest @relation(fields: [mergeRequestId], references: [id])

  // reviewerId list filter
  @@unique([mergeRequestId, userId])
  @@index([userId])
  @@map("merge_request_reviewers")
}

// Review discussion thread (plan.md §8): anchor + resolved state live on the
// thread; comments inside are a flat createdAt-ordered list (GitLab-style
// discussions, no reply nesting).
model MergeRequestThread {
  id             String    @id @default(uuid()) @db.Uuid
  mergeRequestId String    @map("merge_request_id") @db.Uuid
  resolved       Boolean   @default(false)
  // GitLab's two shapes of remark. A plain comment says something; a thread
  // asks for something and is not done until someone resolves it. Only a
  // resolvable thread can be resolved, and only one counts as unresolved.
  resolvable     Boolean   @default(true)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  // Who opened it: 'human', or 'ai' for a thread posted from an assistant
  // review. The assistant posts as the person who ran it, so the author id
  // cannot carry this and the reader would have no way to tell a machine
  // finding from a colleague's.
  source         String    @default("human")
  // line | section | entity — null = unanchored discussion thread.
  anchorType     String?   @map("anchor_type")
  // line: {revisionId, line, excerpt?} · section: {heading} · entity: {entityKey}
  anchor         Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  mergeRequest MergeRequest          @relation(fields: [mergeRequestId], references: [id])
  comments     MergeRequestComment[]

  @@index([mergeRequestId])
  @@map("merge_request_threads")
}

model MergeRequestComment {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  // The comment in this thread that this one answers. Attribution, not
  // nesting: the list stays flat and createdAt-ordered, and SetNull means
  // deleting a comment leaves the replies that pointed at it in place.
  replyToId String?   @map("reply_to_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Null until the author rewrites the comment — an edit is surfaced as one
  // rather than quietly replacing what someone read.
  updatedAt DateTime? @map("updated_at") @db.Timestamptz
  // Which agent wrote this, or null when a person did. MergeRequestThread.source
  // answers the same question for a *thread*, but only about its opening
  // comment — an agent answering an @mention posts into a human's thread, and a
  // reader must still be told a machine is speaking. `authorId` stays the person
  // who mentioned it: they are who authorized the call, and who it is billed to.
  agentKey  String?   @map("agent_key")
  // A model turn outlives the request that triggers it, so the comment is
  // written first and filled in after. While set, the body is not yet an answer.
  // The row doubles as the claim that stops one mention firing twice.
  pending   Boolean   @default(false)

  thread  MergeRequestThread    @relation(fields: [threadId], references: [id])
  replyTo MergeRequestComment?  @relation("MergeRequestCommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies MergeRequestComment[] @relation("MergeRequestCommentReplies")

  @@index([threadId, createdAt])
  @@map("merge_request_comments")
}

// ---------------------------------------------------------------------------
// Feature 15: comments on the page itself. Same discussion model as merge
// request review (flat comments inside a resolvable thread, quote-based
// anchors), but attached to the document rather than to a proposed change —
// a reader annotates what is published, not what someone wants to merge.
// ---------------------------------------------------------------------------

model DocumentThread {
  id         String    @id @default(uuid()) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  resolved   Boolean   @default(false)
  // See MergeRequestThread.resolvable.
  resolvable Boolean   @default(true)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  // See MergeRequestThread.source.
  source     String    @default("human")
  // text | section | entity — null = an unanchored comment on the page as a
  // whole (what the comment list under the content shows).
  anchorType String?   @map("anchor_type")
  // text: {revisionId, quote, prefix?, suffix?} · section: {heading} · entity: {entityKey}
  anchor     Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  document Document          @relation(fields: [documentId], references: [id])
  comments DocumentComment[]

  @@index([documentId, createdAt])
  @@map("document_threads")
}

model DocumentComment {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  // See MergeRequestComment.replyToId.
  replyToId String?   @map("reply_to_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Null until the author rewrites the comment — an edit is surfaced as one
  // rather than quietly replacing what someone read.
  updatedAt DateTime? @map("updated_at") @db.Timestamptz
  // See MergeRequestComment.agentKey / .pending.
  agentKey  String?   @map("agent_key")
  pending   Boolean   @default(false)

  thread  DocumentThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyTo DocumentComment?  @relation("DocumentCommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies DocumentComment[] @relation("DocumentCommentReplies")

  @@index([threadId, createdAt])
  @@map("document_comments")
}

// ---------------------------------------------------------------------------
// Phase 5 (plan.md §11): governance — workspaces, users, ACLs, audit logging.
// documents.workspace_id intentionally has no FK: workspaces arrived after
// documents and pre-Phase-5 rows must stay valid; bootstrap creates the row.
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members WorkspaceMember[]

  @@map("workspaces")
}

// Workspace > Project > Document: the organizational layer between the tenant
// boundary and a page. Projects carry no ACLs of their own — access control
// stays at the workspace, and AclGuard's 'project' source resolves a project
// to its workspace. No FK on workspace_id, mirroring documents.workspace_id:
// in AUTH_MODE=none the demo workspace row need not exist.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  // A project's face, in one of three states. An uploaded picture (avatarKey),
  // a chosen emoji, or neither — in which case the monogram tile from
  // apps/web/src/lib/monogram.ts is drawn from the name and id. Never both:
  // the DTO clears one when the other is set. `avatarColor` backs the emoji
  // (and only the emoji); an image brings its own colours.
  avatarKey       String?   @map("avatar_key")
  avatarEmoji     String?   @map("avatar_emoji")
  avatarColor     String?   @map("avatar_color")
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  documents     Document[]
  glossaryTerms GlossaryTerm[]
  connectors    Connector[]

  @@index([workspaceId, createdAt])
  @@map("projects")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  displayName  String    @map("display_name")
  // SHA-256 hex of the API key; the plaintext key is printed once at creation.
  apiKeyHash   String?   @unique @map("api_key_hash")
  // Auth flow: scrypt hash ("scrypt$N$r$p$salt$hash"); null until the user sets one.
  passwordHash String?   @map("password_hash")
  // Platform admin: user management + implicit admin in every workspace.
  isAdmin      Boolean   @default(false) @map("is_admin")
  // Soft disable: authentication (sessions AND api keys) is refused while set.
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz
  // UI + API language (docs/features/18). Mirrored into the kn_lang cookie so
  // the SSR pass renders in it; the cookie alone would not follow a browser change.
  locale       String    @default("en")
  // S3 key of an uploaded picture, null while the face is drawn from initials
  // (apps/web/src/lib/avatar.ts). The bytes never pass through the API: the
  // browser PUTs them to a presigned URL, exactly as page attachments do.
  avatarKey       String?   @map("avatar_key")
  // Cache-buster for the avatar URL. The key can be reused on replace, so
  // without this every reader keeps the picture they already fetched.
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  memberships    WorkspaceMember[]
  sessions       Session[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

// Auth flow: opaque `ks_` login session tokens (only the SHA-256 is stored).
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// Auth flow: single-use password-reset tokens (`kr_`; only the SHA-256 is stored).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model WorkspaceMember {
  workspaceId     String   @map("workspace_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  // viewer < editor < admin (Phase 5 ACL hierarchy).
  role            String   @default("viewer")
  // Gate for knowledge.query_graph / POST /v1/graph/query (plan.md §9:
  // trusted-operator only). Orthogonal to role on purpose.
  trustedOperator Boolean  @default(false) @map("trusted_operator")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

// Phase 5 audit trail: every trusted-operator graph query is recorded here.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  // users.id in api-key mode; synthetic actor ("dev", "mcp-operator") otherwise.
  actor       String
  action      String
  params      Json
  rowCount    Int?     @map("row_count")
  durationMs  Int?     @map("duration_ms")
  ok          Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

// Feature 10 (docs/features/10-activity-feed.md): user-facing activity stream.
// Distinct from audit_logs (security audit of operator graph queries).
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  // users.id in api-key mode; synthetic actor ("dev") otherwise.
  actor       String
  action      String
  documentId  String?  @map("document_id") @db.Uuid
  // Denormalized from the document, so a project feed is one indexed read
  // rather than a join through every page the project owns. Null for rows that
  // belong to no project (workspace-level actions), and for history older than
  // the column that the backfill could not attribute. No FK, mirroring
  // documents.workspace_id: activity outlives the thing it describes.
  projectId   String?  @map("project_id") @db.Uuid
  // Revision / merge-request / branch id the action touched, when applicable.
  subjectId   String?  @map("subject_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([documentId, createdAt])
  @@index([projectId, createdAt])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Assistant pane: persisted multi-turn chat threads (Computer-style chat +
// documents sidebar). A thread is scoped to one workspace and optionally
// pinned to one document (the page the pane was opened from); documents
// touched by tool calls are derived from AssistantMessage.toolCalls JSON at
// read time rather than a join table, mirroring AssistantAskResponse's
// existing tool-call trace (no dedicated persistence table exists for it).
// ---------------------------------------------------------------------------

model AssistantThread {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  // Document the pane was opened from, if any — the default chat grounding.
  documentId  String?  @map("document_id") @db.Uuid
  title       String?
  /// Provider profile pinned to this thread by whoever is chatting. Null =
  /// whatever the workspace routes 'chat' at.
  providerId  String?  @map("provider_id") @db.Uuid
  // users.id in api-key mode; synthetic actor ("dev") otherwise.
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  messages AssistantMessage[]

  @@index([workspaceId, updatedAt])
  @@index([documentId])
  @@map("assistant_threads")
}

model AssistantMessage {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @map("thread_id") @db.Uuid
  role      String
  content   String
  // AssistantToolCall[] trace (tool, arguments, ok) — JSON, same shape as the
  // one-shot /ask response; also how the sidebar derives "documents touched".
  toolCalls Json     @default("[]") @map("tool_calls")
  // AssistantAskSource[] the reply grounded on, for citation chips.
  sources   Json     @default("[]")
  // AssistantUiBlock[] — generative UI: existing components (GraphView/ActivityFeed/SearchWidget)
  // the assistant asked the chat pane to render inline for this turn.
  uiBlocks  Json     @default("[]") @map("ui_blocks")
  // AssistantPrompt | null — the turn ended by asking the user something
  // (pick one of these / tick the ones that apply / switch to Agent mode).
  // Nullable rather than a default so "asked nothing" and "asked something"
  // stay distinguishable, and the column can be added without a backfill.
  prompt    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  thread AssistantThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}

// ---------------------------------------------------------------------------
// AI settings (docs/features/12): the assistant layer made administrable per
// workspace instead of per boot. Every column here is an OVERRIDE — null means
// "inherit the env value" — so an empty table reproduces today's behaviour
// exactly. workspace_id carries no FK, mirroring documents.workspace_id.
// ---------------------------------------------------------------------------

model AiSettings {
  workspaceId String @id @map("workspace_id") @db.Uuid

  // Provider config. Null = inherit the ASSISTANT_* env var (AiConfigService).
  provider     String?
  baseUrl      String? @map("base_url")
  model        String?
  // AES-256-GCM envelope ("gcm$iv$tag$ct"); never leaves the API process.
  apiKeyCipher String? @map("api_key_cipher")
  temperature  Float?
  maxToolCalls Int?    @map("max_tool_calls")
  timeoutMs    Int?    @map("timeout_ms")

  /// Lets an admin take write tools (create_document / propose_update) away from the chat.
  agentModeEnabled Boolean @default(true) @map("agent_mode_enabled")

  // Cost estimate inputs (USD per 1M tokens). Null falls back to MODEL_PRICES.
  pricePromptPerMTok     Decimal? @map("price_prompt_per_mtok") @db.Decimal(12, 6)
  priceCompletionPerMTok Decimal? @map("price_completion_per_mtok") @db.Decimal(12, 6)

  // Quotas — null = unlimited. Only enforced while enforceBudget is set.
  workspaceMonthlyTokenBudget   BigInt? @map("workspace_monthly_token_budget")
  defaultUserMonthlyTokenBudget BigInt? @map("default_user_monthly_token_budget")
  enforceBudget                 Boolean @default(false) @map("enforce_budget")

  /// Per-purpose routing into ai_providers. Null = fall back to the columns
  /// above, then to the ASSISTANT_* env vars — so a workspace that never
  /// creates a provider profile behaves exactly as it did before.
  chatProviderId       String? @map("chat_provider_id") @db.Uuid
  reviewProviderId     String? @map("review_provider_id") @db.Uuid
  extractionProviderId String? @map("extraction_provider_id") @db.Uuid

  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ai_settings")
}

/// A named provider profile. Several can exist per workspace; ai_settings
/// routes each purpose (chat / review / extraction) at one of them, and a chat
/// thread may pin its own. The routing columns carry no FK, mirroring how
/// assignee_id and author_id are handled elsewhere: the service nulls dangling
/// references on delete rather than the database cascading them.
model AiProvider {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  /// Display name, unique per workspace ("DeepSeek prod", "Local Ollama").
  name         String
  /// 'openai-compatible' | 'deepseek'
  provider     String
  baseUrl      String? @map("base_url")
  model        String
  /// AES-256-GCM envelope; never leaves the API process.
  apiKeyCipher String? @map("api_key_cipher")

  temperature  Float?
  maxToolCalls Int?   @map("max_tool_calls")
  timeoutMs    Int?   @map("timeout_ms")

  pricePromptPerMTok     Decimal? @map("price_prompt_per_mtok") @db.Decimal(12, 6)
  priceCompletionPerMTok Decimal? @map("price_completion_per_mtok") @db.Decimal(12, 6)

  /// AgentCapability[] declared by an admin, overriding the MODEL_CAPABILITIES
  /// code table the router filters on. Same shape as the price overrides above:
  /// a code table that will go stale, plus a per-profile escape hatch.
  capabilities  Json?

  enabled       Boolean   @default(true)
  lastStatus    String?   @map("last_status")
  lastError     String?   @map("last_error")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("ai_providers")
}

/// Per-user override of AiSettings.defaultUserMonthlyTokenBudget.
model AiUserBudget {
  workspaceId        String   @map("workspace_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  monthlyTokenBudget BigInt?  @map("monthly_token_budget")
  updatedBy          String?  @map("updated_by") @db.Uuid
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([workspaceId, userId])
  @@map("ai_user_budgets")
}

/// A skill is an operator-authored instruction pack merged into the assistant's
/// system prompt — trusted text, unlike document content. Selected explicitly
/// from the composer or by keyword match against the user's message.
model AiSkill {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  name         String
  description  String
  instructions String
  /// string[] — keywords that pull this skill into a turn. Json, not text[]:
  /// the schema uses no Postgres arrays (AssistantMessage.toolCalls precedent).
  triggers     Json     @default("[]")
  enabled      Boolean  @default(true)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("ai_skills")
}

/// An agent is a named actor: instructions + a tool allowlist + a model + an
/// output contract (docs/features/20). Before this table that tuple existed
/// three times anonymously — as an ai_skill without tools or a model, as one of
/// three hardcoded routing purposes, and inline on every WorkflowStep.
///
/// For a BUILT_IN_AGENT_KEYS agent a row is a *sparse override*: every column
/// below `key` is nullable and null means "inherit the code default", exactly
/// as ai_settings inherits the ASSISTANT_* env vars. An empty ai_agents table
/// therefore reproduces the pre-feature behaviour of every call site.
model AiAgent {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// A BUILT_IN_AGENT_KEYS value, or an admin-chosen slug for a custom agent.
  key         String
  builtIn     Boolean @default(false) @map("built_in")

  name         String?
  description  String?
  instructions String?
  /// string[] of tool names. Null = the built-in's default set. Validated on
  /// write against the built-in tool registry plus this workspace's enabled
  /// MCP plugin tools — Json, not text[], per the no-Postgres-arrays house rule.
  tools        Json?
  /// string[] of ai_skills ids always attached to this agent's turns.
  skillIds     Json?   @map("skill_ids")

  /// ai_providers profile pinned to this agent. Null falls through to the
  /// purpose route, then the inline config, then env (feature 12's chain).
  /// No FK, matching the other routing columns (house style).
  providerId   String? @map("provider_id") @db.Uuid

  temperature  Float?
  maxToolCalls Int?    @map("max_tool_calls")
  timeoutMs    Int?    @map("timeout_ms")

  enabled   Boolean  @default(true)

  /// Background schedule (docs/features/20). Off by default — the failure mode
  /// of unattended AI is an avalanche, not a slow queue. A due check inside a
  /// fixed sweep, mirroring Connector.syncIntervalMinutes; not a cron.
  scheduleEnabled Boolean   @default(false) @map("schedule_enabled")
  scheduleMinutes Int?      @map("schedule_minutes")
  /// Extra instruction seeded into every scheduled run.
  scheduleNote    String?   @map("schedule_note")
  /// Who owns scheduled runs: they execute as this user and are capped by that
  /// user's role. NOT NULL in effect for scheduling — the sweeper skips a row
  /// without one rather than inventing ambient authority.
  scheduleOwner   String?   @map("schedule_owner") @db.Uuid
  lastRunAt       DateTime? @map("last_run_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  runs AgentRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt])
  @@index([scheduleEnabled, lastRunAt])
  @@map("ai_agents")
}

/// One execution of an agent outside a request (docs/features/20).
///
/// `created_by` is NOT NULL, deliberately stricter than workflow_runs: a
/// trigger-started workflow run carries no creator, so its model call bills a
/// non-UUID and the usage insert is silently dropped. A run with nobody to bill
/// or authorise as is not a run this feature will start.
model AgentRun {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  /// ai_agents.key — resolved through the registry at execution time.
  agentKey    String @map("agent_key")
  /// The override row, when one exists. Null for an untouched built-in.
  agentId     String? @map("agent_id") @db.Uuid

  /// 'manual' | 'schedule' — see AGENT_RUN_TRIGGERS. There is no 'event'
  /// trigger until something emits one (docs/features/20-agents-todo.md).
  trigger String @default("manual")
  /// pending → running → succeeded | failed | cancelled
  status  String @default("pending")

  /// The user this run acts as. Its role caps what the run's tools may do, and
  /// a disabled or demoted owner fails the run rather than escalating it.
  createdBy String @map("created_by") @db.Uuid
  /// Frozen at enqueue, like import_jobs.locale and workflow_runs.locale.
  locale    String @default("en")

  /// What the run was asked to do (scope, note).
  input    Json?
  /// AgentFinding[] — every entry cites the pages it came from (plan.md §12.7).
  findings Json?
  /// Free-text summary the agent wrote for a human.
  summary  String?
  error    String?
  /// Incremented by the sweeper when a run is re-queued after going stale.
  attempt  Int @default(0)

  startedAt   DateTime? @map("started_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  agent AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, agentKey, createdAt])
  @@map("agent_runs")
}

/// A plugin is an external MCP server whose tools join the assistant's bounded
/// tool harness. HTTP transports only — stdio would mean spawning processes on
/// the API host. Its output is UNTRUSTED, handled like document content.
model AiPlugin {
  id              String  @id @default(uuid()) @db.Uuid
  workspaceId     String  @map("workspace_id") @db.Uuid
  name            String
  /// 'streamable-http' | 'sse'
  transport       String  @default("streamable-http")
  url             String
  /// Header name the credential is sent in (e.g. "Authorization").
  authHeader      String? @map("auth_header")
  /// AES-256-GCM envelope of the header value.
  authValueCipher String? @map("auth_value_cipher")
  enabled         Boolean @default(true)
  /// string[] — tools offered to the model. Empty = every discovered tool.
  enabledTools    Json    @default("[]") @map("enabled_tools")
  /// AiPluginTool[] — cache of the last successful listTools().
  discoveredTools Json    @default("[]") @map("discovered_tools")

  lastStatus    String?   @map("last_status")
  lastError     String?   @map("last_error")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("ai_plugins")
}

/// One row per upstream LLM call — the source for BOTH the usage aggregates
/// and the call log. Deliberately holds no prompt or completion text: that
/// content already lives in assistant_messages, and a second copy would bloat
/// the table and duplicate user data.
model AiUsage {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  /// 'ask' | 'chat' | 'chat-stream' | 'review' | 'suggest'
  operation   String
  provider    String
  model       String
  /// ai_providers.id when a named profile served the call; null on the legacy
  /// single-config path.
  providerId  String? @map("provider_id") @db.Uuid

  promptTokens     Int     @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  totalTokens      Int     @default(0) @map("total_tokens")
  /// The provider returned no usage block, so the counts are a local estimate.
  estimated        Boolean @default(false)
  costUsdMicros    Int?    @map("cost_usd_micros")

  durationMs    Int     @default(0) @map("duration_ms")
  ok            Boolean @default(true)
  errorCode     String? @map("error_code")
  error         String?
  threadId      String? @map("thread_id") @db.Uuid
  toolCallCount Int     @default(0) @map("tool_call_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@map("ai_usage")
}

/// Glossary (docs/features/14): the workspace's shared vocabulary. Terms are
/// linked into rendered documents deterministically at read time, so nothing
/// here ever rewrites a page — an entry can be renamed or retired and every
/// document follows on the next render.
model GlossaryTerm {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  // Workspace > Project > Document, and vocabulary belongs to the project:
  // the same word means different things in two bodies of work. Denormalized
  // against projects.workspace_id exactly like documents.workspace_id, because
  // the ACL and the activity feed key off the workspace.
  projectId   String  @map("project_id") @db.Uuid
  term        String
  /// string[] — abbreviations and inflections that link to this entry. Json,
  /// not text[]: the schema uses no Postgres arrays (AiSkill.triggers precedent).
  aliases     Json    @default("[]")
  definition  String
  /// Page that defines the term in full. No FK, mirroring documents.parent_id:
  /// deleting the page must not delete the vocabulary that referenced it.
  documentId  String? @map("document_id") @db.Uuid
  /// 'manual' | 'ai' — provenance, same idea as the relation extractor classes.
  source      String  @default("manual")
  /// Retired terms stay readable in the glossary but stop being auto-linked.
  enabled     Boolean @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  // Per project, not per workspace: two projects may legitimately define the
  // same word, and neither should block the other.
  @@unique([projectId, term])
  @@index([workspaceId, enabled])
  @@index([projectId, enabled])
  @@map("glossary_terms")
}

/// Import (docs/features/16): a file on its way to becoming a page. The row
/// exists before the document does — the whole point is that parsing happens
/// first and the result is reviewed before anything is created — so this is a
/// table of its own rather than an `ingestion_jobs` row, whose `revision_id`
/// is NOT NULL and could not be filled yet.
///
/// The parsed markdown is deliberately NOT stored here: it goes to
/// `workspaces/{ws}/imports/{id}/parsed.md` beside the original, keeping the
/// three-store split honest (PG = transactional truth, MinIO = bytes) and
/// keeping the row the wizard polls every second small.
model ImportJob {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Destination chosen in step 1. Kept on the row rather than in the client
  /// so a reload — or a different tab — resumes into the same destination.
  projectId   String  @map("project_id") @db.Uuid
  /// No FK, mirroring documents.parent_id: the parent may be deleted while a
  /// long parse is still running, and that must not cascade into this row.
  parentId    String? @map("parent_id") @db.Uuid
  category    String  @default("other")

  /// awaiting-upload → queued → running → parsed → submitted, or failed.
  status   String  @default("awaiting-upload")
  /// Free-text act the worker is performing ("Reading 48 pages"), read straight
  /// into the progress label. Null whenever the client's own phase is showing.
  stage    String?
  /// 0..1 when the worker can honestly say; null means indeterminate, which is
  /// what the ring renders rather than inventing a percentage.
  progress Float?

  sourceFilename String  @map("source_filename")
  contentType    String  @map("content_type")
  sizeBytes      Int     @default(0) @map("size_bytes")
  s3Key          String  @map("s3_key")
  /// Which parser ran ('pdf', 'docx', …) — shown in the review provenance strip.
  parser         String?

  /// Title the parser detected; the review step seeds its field from this.
  title    String?
  /// string[] — what the parse could not carry (dropped images, no headings).
  warnings Json?
  /// Parser-specific counts the provenance strip reports: pages, slides,
  /// sections, needsOcr.
  meta     Json?
  error    Json?

  /// Set when the import is submitted, so a row is also the audit trail of
  /// where a page came from.
  documentId String? @map("document_id") @db.Uuid

  /// Language of whoever started the import, frozen here: OCR transcription and
  /// parser warnings are produced later by the worker, which has no request to
  /// read Accept-Language from.
  locale String @default("en")

  createdBy   String?   @map("created_by") @db.Uuid
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Dynamic document workflows (docs/features/17)
// ---------------------------------------------------------------------------

/// A configurable graph of steps: entity → use-cases → API endpoints + pages.
model WorkflowDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Null = offered in every project of the workspace. A project id scopes the
  /// definition the way glossary terms are scoped — the same chain means
  /// different things in two products.
  projectId   String? @map("project_id") @db.Uuid

  name        String
  description String?
  enabled     Boolean @default(true)
  /// Bumped on every graph write. A run records the version it started from,
  /// so "which shape of this workflow produced that page" stays answerable.
  version     Int     @default(1)

  /// WorkflowGraph — { steps: WorkflowStep[], layout }. Validated by
  /// compileDefinition() before every write, so a stored graph is always one
  /// the runtime can walk. Only ever *names* steps and transitions: the
  /// executors live in code, so a dynamic workflow is data, never logic.
  graph   Json
  /// WorkflowTrigger — { manual, autoStart, events[], categories[] }.
  trigger Json?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  runs WorkflowRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, projectId])
  @@map("workflow_definitions")
}

/// One execution of a definition against one source page.
model WorkflowRun {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  projectId    String @map("project_id") @db.Uuid
  definitionId String @map("definition_id") @db.Uuid

  /// The graph frozen at start. Editing a definition must never change what a
  /// run in flight is doing — the same reasoning that makes revisions
  /// immutable. Node.step_id resolves against this, not against the live row.
  definitionSnapshot Json    @map("definition_snapshot")
  definitionVersion  Int     @default(1) @map("definition_version")
  /// No FK, mirroring documents.parent_id: deleting the source page must not
  /// cascade away the audit trail of what it produced.
  rootDocumentId     String  @map("root_document_id") @db.Uuid
  /// Extra instructions for this run only, seeded into the first step.
  note               String?

  /// pending → running ⇄ awaiting-review → completed, or paused/cancelled/failed.
  status    String  @default("pending")
  /// The persisted xstate snapshot. This is what lets a run survive a worker
  /// crash, a deploy, and a week of nobody clicking Approve.
  snapshot  Json?
  error     String?
  /// Language the generated pages are written in, frozen at start for the same
  /// reason definition_snapshot is: the nodes run later, out of any request.
  locale    String  @default("en")
  /// Set when the run was started by a trigger rather than by a person.
  startedBy String? @map("started_by")

  /// The person this run belongs to, and the identity its nodes execute as.
  /// NOT NULL deliberately, matching agent_runs.created_by: a node's model call
  /// bills this id into ai_usage.user_id (@db.Uuid), so a null here used to be
  /// billed as the literal string 'workflow' — an insert that fails and is
  /// swallowed, which made auto-triggered spend invisible. A triggered run now
  /// runs as the definition's author, and a definition without one cannot
  /// auto-start at all (the AiAgent.scheduleOwner rule).
  createdBy  String    @map("created_by") @db.Uuid
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  nodes      WorkflowRunNode[]

  @@index([workspaceId, status, createdAt])
  @@index([rootDocumentId])
  @@index([definitionId, rootDocumentId, status])
  @@map("workflow_runs")
}

/// One step's intermediate result. The fan-out tree lives here as rows rather
/// than inside the run's xstate snapshot: the feature has to answer "every node
/// awaiting review in this project", and an opaque blob cannot be queried.
model WorkflowRunNode {
  id       String  @id @default(uuid()) @db.Uuid
  runId    String  @map("run_id") @db.Uuid
  /// Self-FK: this is the entity → use-case → endpoint tree. Cascades with the
  /// run, so a deleted run leaves no orphan branches.
  parentId String? @map("parent_id") @db.Uuid
  /// Which step of `WorkflowRun.definitionSnapshot` produced this node.
  stepId   String  @map("step_id")

  /// pending → running → awaiting-review → approved → materializing →
  /// materialized, or rejected/skipped/failed.
  status String @default("pending")

  /// What was fed in (parent draft, search hits, the run note).
  input  Json?
  /// WorkflowNodeDraft — { title, markdown, frontmatter, relations, summary }.
  /// The reviewable intermediate result; editable until approved.
  draft  Json?
  /// Raw model output kept for provenance when the draft has been edited.
  output Json?

  /// Set once approved and written to the page tree. No FK, mirroring
  /// documents.parent_id.
  documentId String? @map("document_id") @db.Uuid
  error      String?
  /// Incremented by RETRY; the sweeper uses it to stop re-queueing forever.
  attempt    Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  run      WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent   WorkflowRunNode?  @relation("WorkflowNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children WorkflowRunNode[] @relation("WorkflowNodeTree")

  @@index([runId, status])
  @@index([documentId])
  @@map("workflow_run_nodes")
}

// ---------------------------------------------------------------------------
// Connectors (docs/features/19) — external systems as first-class, workspace
// configured sources and destinations. Confluence, Jira, Notion, markdown/git.
// ---------------------------------------------------------------------------

/// One configured connection to an external system, owned by a workspace.
model Connector {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// ConnectorKind — 'confluence' | 'jira' | 'notion' | 'markdown-git'.
  kind        String
  /// Display name, unique per workspace ("Product wiki", "Runbooks repo").
  name        String
  enabled     Boolean @default(true)

  /// Kind-specific, non-secret settings: base URL, space key, JQL, database id,
  /// repo/branch/subdir. Shape is validated per kind by the adapter.
  config Json @default("{}")

  /// AES-256-GCM envelope ("gcm$iv$tag$ct"); never leaves the API process.
  credential     String?
  /// Last-4 hint so the UI can show a credential is set without revealing it.
  credentialHint String? @map("credential_hint")

  /// Where pulled pages land. project_id carries a real FK like documents does;
  /// parent_id does not, mirroring documents.parent_id.
  projectId String  @map("project_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid
  category  String  @default("other")

  /// 'pull' | 'push' | 'both'
  direction     String  @default("pull")
  /// 'manual' opens a merge request; 'external-wins' | 'local-wins' overwrite.
  conflict      String  @default("manual")
  /// Push a linked page back automatically when a new revision is indexed.
  pushOnPublish Boolean @default(false) @map("push_on_publish")

  /// null = manual only. The worker's schedule sweeper reads this.
  syncIntervalMinutes Int?    @map("sync_interval_minutes")
  /// AES-256-GCM envelope. null = inbound webhooks are refused for this connector.
  webhookSecret       String? @map("webhook_secret")

  lastRunId    String?   @map("last_run_id") @db.Uuid
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz

  /// Frozen at creation: worker-produced stages and warnings have no request to
  /// read Accept-Language from (same reasoning as import_jobs.locale).
  locale String @default("en")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project   Project             @relation(fields: [projectId], references: [id])
  links     ConnectorLink[]
  runs      ConnectorRun[]
  conflicts ConnectorConflict[]

  @@unique([workspaceId, name])
  @@index([workspaceId, kind])
  @@map("connectors")
}

/// The identity map between an external item and a page. Without it a second
/// pull duplicates every page; with it, pull is idempotent and push knows what
/// to send. content_hash/external_version are what the two sides last agreed
/// on, which is how the pull -> push -> webhook -> pull echo loop is broken.
model ConnectorLink {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  /// No FK: a deleted page leaves a tombstone the next sync prunes or re-creates.
  documentId  String @map("document_id") @db.Uuid

  externalId      String  @map("external_id")
  externalUrl     String? @map("external_url")
  externalTitle   String? @map("external_title")
  /// Confluence version.number, Notion last_edited_time, git blob sha, ...
  externalVersion String? @map("external_version")

  /// sha256 of the markdown both sides last agreed on.
  contentHash String? @map("content_hash")
  /// The revision that hash came from.
  revisionId  String? @map("revision_id") @db.Uuid

  lastPulledAt DateTime? @map("last_pulled_at") @db.Timestamptz
  lastPushedAt DateTime? @map("last_pushed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([documentId])
  @@map("connector_links")
}

/// One sync execution. The row is the truth and the queue is only the
/// scheduler: the client polls this, never the job (docs/features/16 contract).
model ConnectorRun {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  /// 'pull' | 'push'
  direction String
  /// 'manual' | 'schedule' | 'webhook'
  trigger   String
  /// queued -> running -> succeeded | partial | failed
  status    String  @default("queued")
  stage     String?
  progress  Float?

  created   Int @default(0)
  updated   Int @default(0)
  skipped   Int @default(0)
  failed    Int @default(0)
  conflicts Int @default(0)

  /// Capped [{ externalId, title, message }] — a lossy sync that says nothing
  /// is the failure this feature exists to prevent.
  warnings Json?
  error    Json?
  /// External ids this run is limited to; absent = the connector's whole scope.
  /// Webhooks send a handful, a full sync sends none.
  scope    Json?

  locale  String  @default("en")
  actorId String? @map("actor_id") @db.Uuid

  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, createdAt])
  @@index([status, createdAt])
  @@map("connector_runs")
}

/// A pull where both sides had changed. The worker writes the external version
/// to its own branch and records this row; the API-side sweeper turns it into a
/// merge request, because MergeRequestsService needs AccessService and cannot be
/// reached from the worker. Rare by nature, so a sweeper hop is the right cost.
model ConnectorConflict {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  documentId  String @map("document_id") @db.Uuid
  linkId      String @map("link_id") @db.Uuid

  /// Branch holding the incoming external version.
  branch      String
  revisionId  String  @map("revision_id") @db.Uuid
  externalUrl String? @map("external_url")
  title       String

  /// pending -> resolved. Set once the merge request exists.
  status         String    @default("pending")
  mergeRequestId String?   @map("merge_request_id") @db.Uuid
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([connectorId, createdAt])
  @@map("connector_conflicts")
}

/**
 * A named narrowing of the workspace merge-request list, private to its owner.
 *
 * The integer id is the one deliberate departure from the uuid convention: a
 * saved view is addressed by the person who saved it (`#7`) and by the URL
 * (`/merge-requests?view=7`), and a uuid is unusable in both places. Nothing
 * else keys off it, so the sequence leaking a rough global count is harmless.
 *
 * No FK on workspaceId/ownerId, mirroring documents.workspace_id and
 * merge_requests.author_id — the workspace is a scope here, enforced by the
 * ACL (AccessService.workspaceOfSavedFilter) rather than by the column.
 */
model SavedFilter {
  id          Int      @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  /// SavedFilterQuery: { status?, search?, chips[] } — stored verbatim so a
  /// filter axis added to the bar needs no migration here.
  query       Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // One name per person per workspace: re-saving under an existing name is an
  // update, and the UI offers exactly that rather than a second "My reviews".
  @@unique([ownerId, workspaceId, name])
  @@index([workspaceId, ownerId])
  @@map("saved_filters")
}
