generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  // Workspace > Project > Document. Denormalized against projects.workspace_id
  // on purpose: the S3 key layout, the graph predicate, ingestion_jobs and
  // activity_log all key off workspace_id, so it stays. Services enforce
  // project.workspaceId === document.workspaceId on create and on move.
  projectId             String    @map("project_id") @db.Uuid
  title                 String
  defaultBranch         String    @default("main") @map("default_branch")
  // Feature 07 categorization: constrained in the API layer (DOCUMENT_CATEGORIES).
  category              String    @default("other")
  // Feature 08 nesting: Confluence-style hierarchy; no FK so children of a
  // deleted/legacy parent surface as roots instead of breaking.
  parentId              String?   @map("parent_id") @db.Uuid
  /// Ancestor ids root-first INCLUDING self, slash-delimited at both ends:
  /// `/<rootId>/<midId>/<selfId>/`. Ids, not titles — a rename would otherwise
  /// rewrite a whole subtree. Text, not ltree: the schema installs no Postgres
  /// extensions, and a left-anchored LIKE needs none.
  ///
  /// Delimiters on both ends are load-bearing. They make the cycle check a
  /// plain `includes('/<id>/')` and stop `/a/ab/` prefix-matching `/a/abc/`.
  path                  String    @default("/pending/")
  /// Ids in `path` minus one; a root is 0. Denormalized so a breadcrumb costs
  /// no walk (docs/features/08).
  depth                 Int       @default(0)
  /// Sort key among siblings. Backfilled from the title order the tree was
  /// drawn in before this column existed, so the migration changes nothing on
  /// screen; manual reordering is the upgrade it makes possible.
  position              Int       @default(0)
  /// Manual verification stamp (docs/features/38): a person said "this page is
  /// right" at `verified_revision_id`. Whether it still holds is derived against
  /// the head at read time (`verificationStateFor`), never stored. No FK on
  /// verified_by, per house policy on user columns. Nullable: no backfill.
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy            String?   @map("verified_by") @db.Uuid
  verifiedRevisionId    String?   @map("verified_revision_id") @db.Uuid
  /// Ownership, freshness, declared state and archive (docs/features/39, #66).
  /// The stamp above IS the verified state; nothing stored says "verified".
  /// `verification_flag` holds the one state a person or agent *declares*
  /// (`requested` | `outdated`), the rest is derived by `verificationStateFor`
  /// against the head, the clock and the open-report count. No FK on owner_id,
  /// archived_by (house policy on user columns).
  ownerId               String?   @map("owner_id") @db.Uuid
  /// `verified_at + review_interval_days`; null = never expires.
  verificationExpiresAt DateTime? @map("verification_expires_at") @db.Timestamptz
  /// Null inherits the workspace default (knowledge_health_settings → env); 0 = never.
  reviewIntervalDays    Int?      @map("review_interval_days")
  verificationFlag      String?   @map("verification_flag")
  verificationNote      String?   @map("verification_note")
  /// `VerificationSource`: who/what set the flag, and from which run or PR.
  verificationSource    Json?     @map("verification_source")
  /// Sweeper idempotency stamps (claim-once); both reset on every verify.
  expiryRemindedAt      DateTime? @map("expiry_reminded_at") @db.Timestamptz
  expiredNotifiedAt     DateTime? @map("expired_notified_at") @db.Timestamptz
  /// Bumped by `ActivityService.record` for every FRESHNESS_ACTIONS action;
  /// backfilled from revisions + activity_log in the migration. "Inactive" is
  /// derived from it, never stored.
  lastActivityAt        DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  /// Archive is a visibility default, not an access boundary: hidden from
  /// lists, tree, search and MCP unless asked for; readable by id; read-only.
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz
  archivedBy            String?   @map("archived_by") @db.Uuid
  /// Provenance (issue #69): the template this page was created from — a
  /// `page_templates.id` or `builtin:<key>` — and the version it was rendered
  /// at. No FK on purpose: archiving or resetting a template must not touch
  /// the pages made from it. Null = the page did not start from a template.
  templateRef           String?   @map("template_ref")
  templateVersion       Int?      @map("template_version")
  /// A page that exists only as a merge request (issue #73, Option A): created
  /// head-less by a capture or a chat save, its first content on a branch. Set
  /// to that merge request; listing surfaces (tree, lists, health, export,
  /// sites, llms.txt) leave it out while it is set, and the merge clears it.
  /// Readable by id meanwhile, so the reviewer can open it. No FK, house policy.
  pendingMergeRequestId String?   @map("pending_merge_request_id") @db.Uuid
  /// What the body is (#78): `page` (markdown, every document before #78) or
  /// an API spec, `openapi` | `asyncapi` (API_DOCUMENT_KINDS). Set at create
  /// and never changed — a revision is parsed by its document's kind.
  kind                  String    @default("page")
  /// The page's file name in its project's git tree (#636), without the
  /// extension: derived from the title by `slugFor`, made unique among its
  /// siblings case-folded, and stored so the decision never flips. Rewritten
  /// on a rename or a move, under the project's commit lock. Null only for a
  /// row an older image wrote; the next commit derives one.
  slug                  String?
  /// A spec's operation-key slug (`op:<slug>:…`), pinned at its first indexed
  /// revision so editing `info.title` does not fork every operation entity.
  /// Only an explicit `x-knowledge-key` on the default-branch head re-pins it.
  /// Null for pages and for a spec not yet indexed.
  specSlug              String?   @map("spec_slug")
  /// Page restriction switch (#76). On: only grantees (and admins) pass this
  /// node, and so its whole subtree.
  restricted            Boolean   @default(false)
  /// Every restricted node on the chain, outermost first: the project if it is
  /// restricted, then restricted ancestors, then self. Denormalized so the
  /// visibility predicate is one array test (`restricted_by && denied`) and
  /// never a walk. Maintained only by PermissionService.recomputeRestrictedBy,
  /// inside the transaction that changed a path, a project or a switch.
  /// GIN-indexed in the migration (not expressible here).
  restrictedBy          String[]  @default([]) @map("restricted_by") @db.Uuid
  /// A private draft (#474): the person who created it, until they publish.
  /// Set together with `restricted` and their `manage` grant, so every reader
  /// already hides it; this column only tells a draft from a page restricted
  /// on purpose, and is what publish clears. Null = published, the state of
  /// every page before #474. No FK, house policy.
  draftOwnerId          String?   @map("draft_owner_id") @db.Uuid
  /// Bumped whenever `restricted_by` changes; the search stores are re-stamped
  /// until `acl_stamped_version` catches up (#76, phase 3).
  aclVersion            Int       @default(0) @map("acl_version")
  aclStampedVersion     Int       @default(0) @map("acl_stamped_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  project              Project               @relation(fields: [projectId], references: [id])
  branches             DocumentBranch[]
  revisions            DocumentRevision[]
  mergeRequests        MergeRequest[]
  attachments          Attachment[]
  threads              DocumentThread[]
  shareLinks           ShareLink[]
  siteAudienceRules    SiteAudienceRule[]
  componentDeclaration ComponentDeclaration?
  apiOperations        ApiOperation[]
  apiFixtureCalls      ApiFixtureCall[]
  apiTestSuites        ApiTestSuite[]
  apiTestBindings      ApiTestBinding[]      @relation("bindingSpec")
  apiTestBoundBy       ApiTestBinding[]      @relation("bindingFixture")
  apiTestRuns          ApiTestRun[]
  collabDrafts         CollabDraft[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, category])
  @@index([projectId, createdAt])
  @@index([projectId, category])
  @@index([parentId])
  @@index([workspaceId, path])
  @@index([parentId, position])
  @@index([workspaceId, verificationFlag])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, verificationExpiresAt])
  @@index([workspaceId, lastActivityAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, kind])
  @@map("documents")
}

model DocumentBranch {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  name            String
  headRevisionId  String?  @map("head_revision_id") @db.Uuid
  protected       Boolean  @default(false)
  /// A private branch (#474): only its owner, the people `access_grants`
  /// (resource_type 'branch') name, and admins read it or its revisions.
  /// Opening a merge request from it clears `restricted`; `owner_id` stays as
  /// who started it. Null owner = a branch from before #474. No FK, house policy.
  ownerId         String?  @map("owner_id") @db.Uuid
  restricted      Boolean  @default(false)
  /// The project branch this page branch belongs to (#636 phase 1b): every
  /// page's branch of one name in a project is one branch. Nullable for one
  /// release only, because the previous image inserts branches without it;
  /// `ProjectCommitsService.rehomeBranches` fills a null it meets.
  projectBranchId String?  @map("project_branch_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  document      Document           @relation(fields: [documentId], references: [id])
  projectBranch ProjectBranch?     @relation(fields: [projectBranchId], references: [id], onDelete: SetNull)
  revisions     DocumentRevision[]
  mrAsSource    MergeRequest[]     @relation("mrSource")
  mrAsTarget    MergeRequest[]     @relation("mrTarget")
  collabDrafts  CollabDraft[]

  @@unique([documentId, name])
  @@index([projectBranchId])
  @@map("document_branches")
}

model DocumentRevision {
  id              String    @id @default(uuid()) @db.Uuid
  documentId      String    @map("document_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  revisionNumber  Int       @map("revision_number")
  // Unknown until finalize (presigned upload flow); PG unique constraints ignore NULLs.
  contentHash     String?   @map("content_hash")
  contentType     String    @map("content_type")
  s3Key           String    @map("s3_key")
  s3VersionId     String?   @map("s3_version_id")
  authorId        String    @map("author_id") @db.Uuid
  message         String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz
  // Phase 5 stale detection: when + with which embedding signature this
  // revision was last indexed (provider:model:dim); drift triggers reindex.
  indexedAt       DateTime? @map("indexed_at") @db.Timestamptz
  embeddingModel  String?   @map("embedding_model")
  // Body length without frontmatter, written by the ingestion normalizer
  // (docs/features/39) so "empty page" is answerable in PG. Null for revisions
  // indexed before the column existed — read as "unknown", never as "empty" —
  // until the verification sweeper's bounded catch-up fills it.
  bodyChars       Int?      @map("body_chars")
  // #173: set when a write to the optional BM25 index (OpenSearch) failed for
  // this revision — its chunks never reached it, or its live flip did not.
  // The stale sweeper re-mirrors it from the graph and clears the stamp only
  // if it is still the one it read. Null means in step, or no BM25 layer.
  fulltextStaleAt DateTime? @map("fulltext_stale_at") @db.Timestamptz
  // #80: published from this shared draft, at this Y snapshot (what
  // finalize rebases the draft onto), crediting who wrote in it since the
  // last publish. Null for every revision that did not come from a draft.
  collabDraftId   String?   @map("collab_draft_id") @db.Uuid
  collabSnapshot  Bytes?    @map("collab_snapshot")
  coAuthorIds     Json?     @map("co_author_ids")
  // #636 phase 4: the id line a push carried, as `{ offset, text }` (byte
  // offset into the stored body; `text: ""` when the file had none), so the
  // served blob is the pushed one byte for byte. Null = the canonical line a
  // web-written revision is served with (`withIdLine`).
  idLine          Json?     @map("id_line")

  document Document         @relation(fields: [documentId], references: [id])
  branch   DocumentBranch?  @relation(fields: [branchId], references: [id])
  parents  RevisionParent[] @relation("child")
  children RevisionParent[] @relation("parent")

  @@unique([documentId, revisionNumber])
  // Not unique (#636): a branch may return to content it once held — a revert.
  // Finalize dedupes against the branch head only.
  @@index([documentId, branchId, contentHash])
  @@index([fulltextStaleAt])
  @@map("document_revisions")
}

/// One shared, CRDT-backed editing session per branch (#80, docs/features/56).
/// NOT a DocumentRevision: revisions stay immutable, and publishing a draft
/// writes an ordinary revision through finalize. Created lazily on the first
/// connect to a (document, branch), seeded once from the branch head — the
/// unique pair is what makes the seed single across API instances. No FK on
/// workspace_id or user ids (house rule).
model CollabDraft {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  /// Revision the draft was seeded from or last rebased onto; null for a branch with no head.
  baseRevisionId    String?   @map("base_revision_id") @db.Uuid
  /// Y.encodeStateAsUpdate of the whole doc. Hot state; checkpoints go to MinIO.
  state             Bytes
  stateBytes        Int       @map("state_bytes")
  /// Y.encodeSnapshot of the state as last stored (state vector + delete set).
  snapshot          Bytes?
  /// The snapshot that was last published, or seeded: "unpublished changes" = `snapshot` differs.
  /// A snapshot, not a state vector — a state vector does not move on a deletion.
  publishedSnapshot Bytes?    @map("published_snapshot")
  /// `SCHEMA_VERSION` of @knowledge/editor-schema the state was written with.
  schemaVersion     String    @map("schema_version")
  /// Distinct user ids that wrote since the last publish (co-author credit).
  contributors      Json      @default("[]")
  lastEditedBy      String?   @map("last_edited_by") @db.Uuid
  lastCheckpointAt  DateTime? @map("last_checkpoint_at") @db.Timestamptz
  resetAt           DateTime? @map("reset_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  branch   DocumentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([documentId, branchId])
  @@index([workspaceId, updatedAt])
  @@map("collab_drafts")
}

/// Confluence-style page attachments (images, PDFs, files embedded in the
/// editor). Bytes live in MinIO under the document's prefix, never in PG; the
/// row is the addressable handle the markdown links to, so an attachment
/// survives revisions the way the S3 object does. Rows are created `pending`
/// (presigned PUT issued) and flip to `ready` once the object is confirmed —
/// an abandoned upload therefore never renders as a broken embed.
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  filename    String
  contentType String   @map("content_type")
  sizeBytes   Int      @default(0) @map("size_bytes")
  s3Key       String   @map("s3_key")
  status      String   @default("pending")
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("attachments")
}

model RevisionParent {
  revisionId       String @map("revision_id") @db.Uuid
  parentRevisionId String @map("parent_revision_id") @db.Uuid
  parentOrder      Int    @default(1) @map("parent_order") @db.SmallInt

  revision DocumentRevision @relation("child", fields: [revisionId], references: [id])
  parent   DocumentRevision @relation("parent", fields: [parentRevisionId], references: [id])

  @@id([revisionId, parentRevisionId])
  @@map("revision_parents")
}

/// A project-level commit (#636, docs/features/71): one per state-changing
/// write in a project — a finalize, a merge, a move, a rename, an archive or
/// unarchive, a publish — written inside that write's own transaction under
/// the project's commit lock (`ProjectCommitsService.lock`). The SHA is never
/// stored: it is a function of the commits and the reader's visible set.
model ProjectCommit {
  id          String   @id @default(uuid()) @db.Uuid
  /// Write order. A parent always has a lower `seq` than its children.
  seq         BigInt   @unique @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  /// The branch name it was written on. Legacy per-page branches group by
  /// (project, name) until project branches exist (phase 1b).
  branch      String
  /// Everything a git commit carries after its `tree` and `parent` lines —
  /// author, committer, message, trailers — as bytes, frozen at write time.
  header      Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parents  ProjectCommitParent[] @relation("commitChild")
  children ProjectCommitParent[] @relation("commitParent")
  changes  ProjectCommitChange[]

  @@index([projectId, branch, seq])
  @@index([workspaceId])
  @@map("project_commits")
}

/// A branch of a project (#636 phase 1b, docs/features/71): the identity that
/// every page's branch of the same name in the project shares, and what git
/// will serve as a ref. A page's own head stays on its `document_branches`
/// row; `protected`, `restricted` and the owner stay there too, per page.
model ProjectBranch {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branches DocumentBranch[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@map("project_branches")
}

/// Ordered commit parents: order 1 = first parent, as `revision_parents`.
model ProjectCommitParent {
  commitId       String @map("commit_id") @db.Uuid
  parentCommitId String @map("parent_commit_id") @db.Uuid
  parentOrder    Int    @map("parent_order") @db.SmallInt

  commit ProjectCommit @relation("commitChild", fields: [commitId], references: [id], onDelete: Cascade)
  parent ProjectCommit @relation("commitParent", fields: [parentCommitId], references: [id], onDelete: Cascade)

  @@id([commitId, parentOrder])
  @@index([parentCommitId])
  @@map("project_commit_parents")
}

/// One page a commit touched, holding that page's full tree state after it.
/// No FK on the page or the revision: a hard-deleted page's rows stay as
/// tombstones nobody can see, so a commit never turns empty under its children.
model ProjectCommitChange {
  commitId         String  @map("commit_id") @db.Uuid
  documentId       String  @map("document_id") @db.Uuid
  revisionId       String  @map("revision_id") @db.Uuid
  parentDocumentId String? @map("parent_document_id") @db.Uuid
  slug             String
  /// Not in the tree after this commit: archived, or moved to another project.
  removed          Boolean @default(false)

  commit ProjectCommit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@id([commitId, documentId])
  @@index([revisionId])
  @@map("project_commit_changes")
}

// Table created in Phase 1; compare endpoints land in Phase 2.
model RevisionDiff {
  id             String   @id @default(uuid()) @db.Uuid
  fromRevisionId String   @map("from_revision_id") @db.Uuid
  toRevisionId   String   @map("to_revision_id") @db.Uuid
  format         String
  additions      Int      @default(0)
  deletions      Int      @default(0)
  changes        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([fromRevisionId, toRevisionId, format])
  @@map("revision_diffs")
}

model IngestionJob {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  revisionId  String    @map("revision_id") @db.Uuid
  type        String
  status      String    @default("queued")
  attempts    Int       @default(0)
  payload     Json
  error       Json?
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Outbox sweeper scan
  @@index([status, createdAt])
  @@map("ingestion_jobs")
}

// Phase 3 (plan.md §8): GitLab-style merge requests over the revision DAG.
model MergeRequest {
  id             String @id @default(uuid()) @db.Uuid
  documentId     String @map("document_id") @db.Uuid
  sourceBranchId String @map("source_branch_id") @db.Uuid
  targetBranchId String @map("target_branch_id") @db.Uuid

  title       String
  description String?
  // open | merged | closed
  status      String  @default("open")
  // Draft merge requests cannot be merged until the flag is cleared.
  isDraft     Boolean @default(false) @map("is_draft")
  authorId    String  @map("author_id") @db.Uuid
  // Single assignee (GitLab-style; advisory like reviewers). No FK — see MergeRequestReviewer.
  assigneeId  String? @map("assignee_id") @db.Uuid
  // Author ids that approved (auth stub until Phase 5).
  approvedBy  Json    @default("[]") @map("approved_by")

  // merge-commit | squash — set when merged.
  strategy              String?
  mergedRevisionId      String?   @map("merged_revision_id") @db.Uuid
  /// MR_PROVENANCES: manual | agent | captured (issue #73). Who opened it, not
  /// who wrote the code: an agent-session capture is still authored by the
  /// key's owner, and the merge gates treat it exactly as theirs.
  provenance            String    @default("manual")
  /// The knowledge_captures row this merge request was proposed from. No FK,
  /// like merged_revision_id: the capture is the record of where it came from.
  captureId             String?   @map("capture_id") @db.Uuid
  /// An admin's acknowledgement of a spec's breaking changes (#78): who, when,
  /// and the source head they read. No FK, house policy. A later push makes it
  /// stale — the gate passes only while the acknowledged head is still the head.
  breakingAckBy         String?   @map("breaking_ack_by") @db.Uuid
  breakingAckAt         DateTime? @map("breaking_ack_at") @db.Timestamptz
  breakingAckRevisionId String?   @map("breaking_ack_revision_id") @db.Uuid
  /// The source branch's head commit when acknowledged (#636): the gate passes
  /// while it is still the head, so a write to any page of the branch reopens it.
  breakingAckCommitId   String?   @map("breaking_ack_commit_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  mergedAt              DateTime? @map("merged_at") @db.Timestamptz
  closedAt              DateTime? @map("closed_at") @db.Timestamptz

  document     Document               @relation(fields: [documentId], references: [id])
  sourceBranch DocumentBranch         @relation("mrSource", fields: [sourceBranchId], references: [id])
  targetBranch DocumentBranch         @relation("mrTarget", fields: [targetBranchId], references: [id])
  reviewers    MergeRequestReviewer[]
  threads      MergeRequestThread[]
  checks       MergeRequestCheck[]

  @@index([documentId, status])
  @@index([authorId])
  @@map("merge_requests")
}

// Assigned reviewers (advisory — merge is gated by approval count, not by
// reviewer state). userId intentionally has no FK to users: it mirrors the
// authorId pattern above (the zeros AUTHOR_ID_STUB is not a real user row);
// membership is validated in the service against workspace_members.
model MergeRequestReviewer {
  id             String   @id @default(uuid()) @db.Uuid
  mergeRequestId String   @map("merge_request_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  addedBy        String?  @map("added_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  mergeRequest MergeRequest @relation(fields: [mergeRequestId], references: [id])

  // reviewerId list filter
  @@unique([mergeRequestId, userId])
  @@index([userId])
  @@map("merge_request_reviewers")
}

// Review discussion thread (plan.md §8): anchor + resolved state live on the
// thread; comments inside are a flat createdAt-ordered list (GitLab-style
// discussions, no reply nesting).
model MergeRequestThread {
  id             String    @id @default(uuid()) @db.Uuid
  mergeRequestId String    @map("merge_request_id") @db.Uuid
  resolved       Boolean   @default(false)
  // GitLab's two shapes of remark. A plain comment says something; a thread
  // asks for something and is not done until someone resolves it. Only a
  // resolvable thread can be resolved, and only one counts as unresolved.
  resolvable     Boolean   @default(true)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  // Who opened it: 'human', or 'ai' for a thread posted from an assistant
  // review. The assistant posts as the person who ran it, so the author id
  // cannot carry this and the reader would have no way to tell a machine
  // finding from a colleague's.
  source         String    @default("human")
  // line | section | entity — null = unanchored discussion thread.
  anchorType     String?   @map("anchor_type")
  // line: {revisionId, line, excerpt?} · section: {heading} · entity: {entityKey}
  anchor         Json?
  /// The lint check that opened it (#74), so a re-lint resolves its own stale
  /// threads and never a person's. Re-pointed to the newest check while the
  /// violation stands. No FK, like agent_run_id.
  checkId        String?   @map("check_id") @db.Uuid
  /// The StyleRule.id a lint thread cites.
  ruleId         String?   @map("rule_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  mergeRequest MergeRequest          @relation(fields: [mergeRequestId], references: [id])
  comments     MergeRequestComment[]

  @@index([mergeRequestId])
  @@index([checkId])
  @@map("merge_request_threads")
}

/// One lint pass of one merge request's source head (#74). Identity is
/// (mergeRequestId, kind, headRevisionId): a head is linted once, a push is a
/// new row, and the insert is the claim. `publishedAt` is the publish claim.
/// A page's quality at one audit (#74, phase 4). Append-only: the history is
/// the rows, and a dashboard is a groupBy over them — each row is a fact about
/// one revision at one time, not an aggregate. Written by the worker, the one
/// stated exception to "the worker generates, the API publishes": a score is a
/// measurement, like agent_runs.findings, and attributes no act to a person.
/// No FK on workspace/project/document ids (house policy; a deleted page's
/// history simply stops).
model DocumentQualityScore {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  /// Denormalized at write time, so a project dashboard needs no join.
  projectId      String   @map("project_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  revisionId     String   @map("revision_id") @db.Uuid
  agentRunId     String?  @map("agent_run_id") @db.Uuid
  rubricVersion  Int      @map("rubric_version")
  /// Fingerprint of the enabled styleguide rules the model half read; null
  /// when there were none. A changed styleguide re-scores the style half.
  styleguideHash String?  @map("styleguide_hash")
  /// 0–100: the weighted mean of the measured dimensions.
  overall        Int
  /// QualityDimension → 0–100 | null (null = not measured).
  dimensions     Json
  /// QualityIssue[], capped.
  issues         Json     @default("[]")
  /// QualityDuplicate[] — near-duplicate peers.
  duplicates     Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([documentId, createdAt])
  @@map("document_quality_scores")
}

model MergeRequestCheck {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  mergeRequestId String    @map("merge_request_id") @db.Uuid
  /// MR_CHECK_KINDS
  kind           String    @default("lint")
  headRevisionId String    @map("head_revision_id") @db.Uuid
  styleguideId   String?   @map("styleguide_id") @db.Uuid
  /// pending → passed | failed | error | skipped. `running` is derived from the run.
  status         String    @default("pending")
  /// MR_CHECK_REASONS — why a check was skipped or errored.
  reason         String?
  agentRunId     String?   @map("agent_run_id") @db.Uuid
  /// {error, warning, suggestion} at publish time.
  counts         Json?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  /// An admin's override of a blocking result (phase 3), bound to this head.
  overriddenBy   String?   @map("overridden_by") @db.Uuid
  overriddenAt   DateTime? @map("overridden_at") @db.Timestamptz
  overrideReason String?   @map("override_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  mergeRequest MergeRequest @relation(fields: [mergeRequestId], references: [id])

  @@unique([mergeRequestId, kind, headRevisionId])
  @@index([workspaceId, status, createdAt])
  @@map("merge_request_checks")
}

model MergeRequestComment {
  id         String    @id @default(uuid()) @db.Uuid
  threadId   String    @map("thread_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  body       String
  // The comment in this thread that this one answers. Attribution, not
  // nesting: the list stays flat and createdAt-ordered, and SetNull means
  // deleting a comment leaves the replies that pointed at it in place.
  replyToId  String?   @map("reply_to_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Null until the author rewrites the comment — an edit is surfaced as one
  // rather than quietly replacing what someone read.
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz
  // Which agent wrote this, or null when a person did. MergeRequestThread.source
  // answers the same question for a *thread*, but only about its opening
  // comment — an agent answering an @mention posts into a human's thread, and a
  // reader must still be told a machine is speaking. `authorId` stays the person
  // who mentioned it: they are who authorized the call, and who it is billed to.
  agentKey   String?   @map("agent_key")
  // A model turn outlives the request that triggers it, so the comment is
  // written first and filled in after. While set, the body is not yet an answer.
  // The row doubles as the claim that stops one mention firing twice.
  pending    Boolean   @default(false)
  // The agent run this pending reply is waiting on (#70): an agent with an
  // enabled comment.mention trigger answers with its run's result rather than
  // a chat turn, filled in by MentionRepliesService.sweepRunReplies. No FK.
  agentRunId String?   @map("agent_run_id") @db.Uuid

  thread  MergeRequestThread    @relation(fields: [threadId], references: [id])
  replyTo MergeRequestComment?  @relation("MergeRequestCommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies MergeRequestComment[] @relation("MergeRequestCommentReplies")

  @@index([threadId, createdAt])
  @@index([agentRunId])
  @@map("merge_request_comments")
}

// ---------------------------------------------------------------------------
// Feature 15: comments on the page itself. Same discussion model as merge
// request review (flat comments inside a resolvable thread, quote-based
// anchors), but attached to the document rather than to a proposed change —
// a reader annotates what is published, not what someone wants to merge.
// ---------------------------------------------------------------------------

model DocumentThread {
  id         String    @id @default(uuid()) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  resolved   Boolean   @default(false)
  // See MergeRequestThread.resolvable.
  resolvable Boolean   @default(true)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  // See MergeRequestThread.source.
  source     String    @default("human")
  // text | section | entity — null = an unanchored comment on the page as a
  // whole (what the comment list under the content shows).
  anchorType String?   @map("anchor_type")
  // text: {revisionId, quote, prefix?, suffix?} · section: {heading} · entity: {entityKey}
  anchor     Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  document Document          @relation(fields: [documentId], references: [id])
  comments DocumentComment[]

  @@index([documentId, createdAt])
  @@map("document_threads")
}

model DocumentComment {
  id         String    @id @default(uuid()) @db.Uuid
  threadId   String    @map("thread_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  body       String
  // See MergeRequestComment.replyToId.
  replyToId  String?   @map("reply_to_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Null until the author rewrites the comment — an edit is surfaced as one
  // rather than quietly replacing what someone read.
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz
  // See MergeRequestComment.agentKey / .pending / .agentRunId.
  agentKey   String?   @map("agent_key")
  pending    Boolean   @default(false)
  agentRunId String?   @map("agent_run_id") @db.Uuid

  thread  DocumentThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyTo DocumentComment?  @relation("DocumentCommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies DocumentComment[] @relation("DocumentCommentReplies")

  @@index([threadId, createdAt])
  @@index([agentRunId])
  @@map("document_comments")
}

// ---------------------------------------------------------------------------
// Phase 5 (plan.md §11): governance — workspaces, users, ACLs, audit logging.
// documents.workspace_id intentionally has no FK: workspaces arrived after
// documents and pre-Phase-5 rows must stay valid; bootstrap creates the row.
// ---------------------------------------------------------------------------

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// #479: a tombstone. Set, the workspace is gone to every caller at once;
  /// WorkspaceTeardownSweeper then deletes what it owns and this row last.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  members WorkspaceMember[]

  @@map("workspaces")
}

// Workspace > Project > Document: the organizational layer between the tenant
// boundary and a page. Projects carry no ACLs of their own — access control
// stays at the workspace, and AclGuard's 'project' source resolves a project
// to its workspace. No FK on workspace_id, mirroring documents.workspace_id:
// in AUTH_MODE=none the demo workspace row need not exist.
model Project {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  name            String
  description     String?
  // A project's face, in one of three states. An uploaded picture (avatarKey),
  // a chosen emoji, or neither — in which case the monogram tile from
  // apps/web/src/core/monogram.ts is drawn from the name and id. Never both:
  // the DTO clears one when the other is set. `avatarColor` backs the emoji
  // (and only the emoji); an image brings its own colours.
  avatarKey       String?   @map("avatar_key")
  avatarEmoji     String?   @map("avatar_emoji")
  avatarColor     String?   @map("avatar_color")
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz
  /// Project restriction switch (#76): every page in it inherits the restriction.
  restricted      Boolean   @default(false)
  /// off | warn | block — the style lint of its merge requests (#74); null is the workspace's.
  lintPolicy      String?   @map("lint_policy")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  documents     Document[]
  glossaryTerms GlossaryTerm[]
  connectors    Connector[]
  trackerRoute  ProjectTrackerRoute?
  site          PublishedSite?
  commits       ProjectCommit[]
  branches      ProjectBranch[]

  @@index([workspaceId, createdAt])
  @@map("projects")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  displayName     String    @map("display_name")
  // Superseded by api_keys (docs/features/33) and no longer read; kept one
  // release so a rollback still authenticates. Contract step: drop it.
  apiKeyHash      String?   @unique @map("api_key_hash")
  // Auth flow: scrypt hash ("scrypt$N$r$p$salt$hash"); null until the user sets one.
  passwordHash    String?   @map("password_hash")
  // Platform admin: user management + implicit admin in every workspace.
  isAdmin         Boolean   @default(false) @map("is_admin")
  // Soft disable: authentication (sessions AND api keys) is refused while set.
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz
  // UI + API language (docs/features/18). Mirrored into the kn_lang cookie so
  // the SSR pass renders in it; the cookie alone would not follow a browser change.
  locale          String    @default("en")
  // S3 key of an uploaded picture, null while the face is drawn from initials
  // (apps/web/src/core/avatar.ts). The bytes never pass through the API: the
  // browser PUTs them to a presigned URL, exactly as page attachments do.
  avatarKey       String?   @map("avatar_key")
  // Cache-buster for the avatar URL. The key can be reused on replace, so
  // without this every reader keeps the picture they already fetched.
  avatarUpdatedAt DateTime? @map("avatar_updated_at") @db.Timestamptz
  // When the address was proven to reach this person (docs/features/41): a
  // followed verify, reset or invite link. Null = unproven. The migration
  // backfilled created_at for every account that existed before mail did.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  memberships        WorkspaceMember[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  apiKeys            ApiKey[]
  identities         UserIdentity[]
  scimRecords        ScimUser[]
  scimGroups         ScimGroupMember[]

  @@map("users")
}

// Named `kn_` API keys, many per person (docs/features/33). Replaces the single
// users.api_key_hash, which is kept (and no longer read) so the previous image
// still authenticates after a rollback; the migration copied every one of them
// here. Only the SHA-256 is stored — the plaintext is shown once, at creation.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  keyHash     String    @unique @map("key_hash")
  // First 11 characters of the plaintext (`kn_` + 8 hex): recognisable in a
  // config file, far too short to be worth anything on its own.
  prefix      String
  // 'read' | 'capture' | 'write' — API_KEY_SCOPES in contracts.
  scope       String    @default("write")
  // Pinned to one workspace, or null for all of the owner's. No FK, house policy.
  workspaceId String?   @map("workspace_id") @db.Uuid
  /// string[] — a `capture` key's project pin (issue #73); null for every
  /// project. Json, not uuid[]: the schema uses no Postgres arrays.
  projectIds  Json?     @map("project_ids")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("api_keys")
}

// Auth flow: opaque `ks_` login session tokens (only the SHA-256 is stored).
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // #75: how this session was opened (AUTH_METHODS in contracts). The default
  // is true of every row that predates SSO, so the column needed no backfill.
  authMethod   String    @default("password") @map("auth_method")
  // identity_providers.id for an SSO login; null for a password session.
  providerId   String?   @map("provider_id") @db.Uuid
  // The IdP's own session id (OIDC `sid`), matched by back-channel logout.
  idpSessionId String?   @map("idp_session_id")
  ip           String?
  userAgent    String?   @map("user_agent")
  // Touched at most once a minute by TokenAuthService, like api_keys.last_used_at.
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([providerId, idpSessionId])
  @@map("sessions")
}

// Auth flow: single-use password-reset tokens (`kr_`; only the SHA-256 is stored).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  // 'reset' | 'invite' (docs/features/41). An invite is a reset the person did
  // not ask for: same redemption, longer TTL, different mail and heading.
  purpose   String    @default("reset")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

// Single-use `kv_` email verification tokens (docs/features/41; SHA-256 only).
// `email` is the address the link was sent to: verifying proves THAT address,
// so a token minted before an address change cannot verify the new one.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

model WorkspaceMember {
  workspaceId     String   @map("workspace_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  // WORKSPACE_ROLES in contracts: guest < viewer < editor < admin (#76).
  role            String   @default("viewer")
  // Gate for knowledge.query_graph / POST /v1/graph/query (plan.md §9:
  // trusted-operator only). Orthogonal to role on purpose.
  trustedOperator Boolean  @default(false) @map("trusted_operator")
  // #75: who manages this row (MEMBERSHIP_SOURCES). Role sync and SCIM touch
  // only rows they created; `manual` is never changed by them.
  source          String   @default("manual")
  // #468: MEMBER_CAPABILITIES in contracts, granted by hand beside the role and
  // read only through `hasCapability`. Role sync and SCIM never write it.
  capabilities    Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

// A workspace-scoped set of members that page and project restrictions grant
// to (#76). `source` is GROUP_SOURCES in contracts: `manual` groups are edited
// over the API, `connector` ones are mirrored by ACL sync (connectorId +
// externalId name the upstream group) and `scim` is reserved for provisioning;
// both non-manual kinds answer 409 to a manual edit. No FK on workspace_id or
// connector_id (house policy).
model UserGroup {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  source      String   @default("manual")
  connectorId String?  @map("connector_id") @db.Uuid
  externalId  String?  @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  members UserGroupMember[]

  @@unique([workspaceId, name])
  @@unique([connectorId, externalId])
  @@map("user_groups")
}

// No FK on user_id (house policy). Rows are removed with the workspace
// membership they depend on — WorkspacesService.removeMember — so re-adding a
// person does not silently restore what their old groups were granted.
model UserGroupMember {
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

/// One grant on a project or page (#76). No FK on workspace, resource or
/// subject (house policy); the services delete grants with their subject.
model AccessGrant {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// ACCESS_RESOURCE_TYPES: project | document
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  /// ACCESS_SUBJECT_TYPES: user | group
  subjectType  String   @map("subject_type")
  subjectId    String   @map("subject_id") @db.Uuid
  /// ACCESS_LEVELS: view | edit | manage
  level        String
  /// ACCESS_GRANT_ORIGINS — manual | connector. Connector rows are rewritten
  /// by that connector's ACL sync (#76, phase 6), manual ones never.
  origin       String   @default("manual")
  connectorId  String?  @map("connector_id") @db.Uuid
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([resourceType, resourceId, subjectType, subjectId, origin])
  @@index([workspaceId, subjectType, subjectId])
  @@index([resourceId])
  @@index([connectorId])
  @@map("access_grants")
}

/// Somebody refused a page or project asking for a level on it (#76, phase 5).
/// No FK on workspace, resource, requester or decider (house policy). At most
/// one pending row per requester and resource: a partial unique index in the
/// migration (`access_requests_one_pending`), which Prisma cannot express.
model AccessRequest {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  /// ACCESS_RESOURCE_TYPES: project | document
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id") @db.Uuid
  requesterId  String    @map("requester_id") @db.Uuid
  /// REQUESTABLE_ACCESS_LEVELS: view | edit
  level        String
  message      String?
  /// ACCESS_REQUEST_STATUSES: pending | approved | denied | cancelled | expired
  status       String    @default("pending")
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedLevel String?   @map("decided_level")
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz
  /// Why it was denied, when the manager said.
  reason       String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, status, createdAt])
  @@index([resourceType, resourceId, status])
  @@index([requesterId, status])
  @@map("access_requests")
}

// Phase 5 audit trail: every trusted-operator graph query is recorded here.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  // Null for a platform event that belongs to no workspace — a sign-in, say,
  // which happens before any workspace is known (#75).
  workspaceId String?  @map("workspace_id") @db.Uuid
  // users.id in api-key mode; synthetic actor ("dev", "mcp-operator") otherwise.
  actor       String
  action      String
  params      Json
  rowCount    Int?     @map("row_count")
  durationMs  Int?     @map("duration_ms")
  ok          Boolean  @default(true)
  error       String?
  // Client address of the request that caused it, when there was one.
  ip          String?
  // Who or what the action was done to: a user id, a provider id.
  target      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Feature 10 (docs/features/10-activity-feed.md): user-facing activity stream.
// Distinct from audit_logs (security audit of operator graph queries).
model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  // users.id in api-key mode; synthetic actor ("dev") otherwise.
  actor       String
  action      String
  documentId  String?  @map("document_id") @db.Uuid
  // Denormalized from the document, so a project feed is one indexed read
  // rather than a join through every page the project owns. Null for rows that
  // belong to no project (workspace-level actions), and for history older than
  // the column that the backfill could not attribute. No FK, mirroring
  // documents.workspace_id: activity outlives the thing it describes.
  projectId   String?  @map("project_id") @db.Uuid
  // Revision / merge-request / branch id the action touched, when applicable.
  subjectId   String?  @map("subject_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([documentId, createdAt])
  @@index([projectId, createdAt])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Assistant pane: persisted multi-turn chat threads (Computer-style chat +
// documents sidebar). A thread is scoped to one workspace and optionally
// pinned to one document (the page the pane was opened from); documents
// touched by tool calls are derived from AssistantMessage.toolCalls JSON at
// read time rather than a join table, mirroring AssistantAskResponse's
// existing tool-call trace (no dedicated persistence table exists for it).
// ---------------------------------------------------------------------------

model AssistantThread {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  // Document the pane was opened from, if any — the default chat grounding.
  documentId  String?  @map("document_id") @db.Uuid
  title       String?
  /// Provider profile pinned to this thread by whoever is chatting. Null =
  /// whatever the workspace routes 'chat' at.
  providerId  String?  @map("provider_id") @db.Uuid
  // users.id in api-key mode; synthetic actor ("dev") otherwise.
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  messages AssistantMessage[]

  @@index([workspaceId, updatedAt])
  @@index([documentId])
  @@map("assistant_threads")
}

model AssistantMessage {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  role       String
  content    String
  // AssistantToolCall[] trace (tool, arguments, ok) — JSON, same shape as the
  // one-shot /ask response; also how the sidebar derives "documents touched".
  toolCalls  Json     @default("[]") @map("tool_calls")
  // AssistantAskSource[] the reply grounded on, for citation chips.
  sources    Json     @default("[]")
  // AssistantUiBlock[] — generative UI: existing components (GraphView/ActivityFeed/SearchWidget)
  // the assistant asked the chat pane to render inline for this turn.
  uiBlocks   Json     @default("[]") @map("ui_blocks")
  // AssistantPrompt | null — the turn ended by asking the user something
  // (pick one of these / tick the ones that apply / switch to Agent mode).
  // Nullable rather than a default so "asked nothing" and "asked something"
  // stay distinguishable, and the column can be added without a backfill.
  prompt     Json?
  // AnswerCitation[] — sentence spans of `content` and the source labels each
  // rests on (docs/features/38). Empty for user turns and pre-feature rows.
  citations  Json     @default("[]")
  // AnswerConfidence | null — derived at the end of the turn from observable
  // signals. Nullable so pre-feature rows and user turns read as "not assessed"
  // rather than as a level.
  confidence Json?
  // AssistantFlowAnswer | null — a user turn that answered one step of a
  // question flow (#425): { flow, questionId, value }. The open flow is
  // rebuilt from these, so there is no flow state table. Nullable, no backfill.
  answer     Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  thread AssistantThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}

/// One signal about one answer (docs/features/38, issue #67 phase 2): an
/// explicit vote, or an implicit miss the harness recorded itself
/// (low confidence / no answer). Misses only — a good answer that nobody rated
/// writes nothing, which keeps the volume bounded and keeps the measurement
/// stream in JSONL where it belongs. No FK on workspace_id / created_by (house
/// policy: the dev principal has no users row) and none on message_id either —
/// a rewind deletes messages, and a vote that outlives its message is still a
/// data point for the surveyor and the backtest.
model AnswerFeedback {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  /// ANSWER_SIGNAL_KINDS: vote | low-confidence | no-answer
  kind             String
  /// ANSWER_SURFACES: assistant | editor-assistant | ask | mcp
  surface          String
  /// 'up' | 'down' — votes only; null on an implicit signal.
  rating           String?
  /// ANSWER_FEEDBACK_REASONS; required by the DTO on 'down'.
  reason           String?
  comment          String?
  /// The question, as asked. User content: purged by retention (phase 3).
  query            String
  answerExcerpt    String?  @map("answer_excerpt")
  threadId         String?  @map("thread_id") @db.Uuid
  messageId        String?  @map("message_id") @db.Uuid
  /// MCP: the knowledge_search call the agent built its answer from.
  traceId          String?  @map("trace_id")
  citedDocumentIds Json     @default("[]") @map("cited_document_ids")
  /// AnswerConfidence snapshot at answer time.
  confidence       Json?
  /// The model that wrote the answer (#305): the turn's config for an implicit
  /// signal, the thread's or caller's latest model call for a vote. Null when
  /// the server cannot know — an MCP agent's own model, a pre-ledger row.
  providerId       String?  @map("provider_id") @db.Uuid
  model            String?
  createdBy        String   @map("created_by") @db.Uuid
  apiKeyId         String?  @map("api_key_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // One vote per person per message. NULL message_id rows (ask, mcp) are
  // exempt — SQL unique treats NULLs as distinct — and dedupe differently.
  @@unique([messageId, createdBy])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@map("answer_feedback")
}

/// A reported problem with a page (docs/features/38, issue #67 phase 3) — from
/// an agent over MCP, from a person on the page, or from a down-vote that named
/// the pages it cited. One OPEN issue per (document, kind): a second report
/// folds in as report_count + 1 and more evidence. Prisma cannot express that
/// partial unique index, so the service writes it as a guarded UPDATE-then-INSERT.
/// No FK on workspace_id / created_by / resolved_by (house policy); none on
/// agent_run_id / merge_request_id either — a run or an MR that is deleted
/// leaves the report standing.
/// One thing a coding agent learned in a session, proposed back into the
/// knowledge base (issue #73). The agent distills; this row is the staging
/// record between its tool call and the merge request a person reviews — the
/// MR (or, for a glossary term, the inbox) is where it is decided. No
/// transcript is ever stored. No FK on workspace_id, project_id or
/// created_by (house policy).
model KnowledgeCapture {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  /// Resolved at write time; a capture always belongs to one project.
  projectId        String    @map("project_id") @db.Uuid
  /// CAPTURE_KINDS: decision | gotcha | convention | howto | glossary | relation | answer
  kind             String
  /// CAPTURE_STATUSES: staged | proposed | duplicate | rejected | failed.
  /// merged/closed are the merge request's status, derived by captureStateFor.
  status           String    @default("staged")
  /// CAPTURE_OUTCOMES: new-page | amend-page | glossary | relation | none. Null until dedupe ran.
  outcome          String?
  title            String
  /// Kind-specific body (rationale, term + definition, relation triple,
  /// question + answer + citations). Untrusted: wrapped before any model sees it.
  payload          Json
  /// sha256 of the normalized payload — the exact-duplicate check.
  contentHash      String    @map("content_hash")
  /// CaptureSession: client, sessionId, repo, branch, commit, files (paths only).
  session          Json
  /// CaptureOrigin of a chat capture (#82): platform, chat, thread link, span.
  /// Server-set from the delivery, never from a caller or a model.
  origin           Json?
  /// Top dedupe hits [{ documentId, title, score }], kept for the reviewer.
  similar          Json      @default("[]")
  targetDocumentId String?   @map("target_document_id") @db.Uuid
  mergeRequestId   String?   @map("merge_request_id") @db.Uuid
  glossaryTermId   String?   @map("glossary_term_id") @db.Uuid
  /// The key that wrote it: the rate limit counts by it, and a revoked key's
  /// output can be found and rejected together.
  apiKeyId         String?   @map("api_key_id") @db.Uuid
  createdBy        String    @map("created_by") @db.Uuid
  error            String?
  /// Set by whoever is proposing it; a stale claim is the sweeper's to re-drive.
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz
  attempts         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([workspaceId, status, createdAt])
  @@index([apiKeyId, createdAt])
  // Not unique: two concurrent posts of one payload race to two rows at worst,
  // and the second reads as a duplicate of the first (house rule).
  @@index([projectId, contentHash])
  @@map("knowledge_captures")
}

model KnowledgeIssue {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  documentId        String    @map("document_id") @db.Uuid
  /// The revision the reporter read, when the reporter said.
  revisionId        String?   @map("revision_id") @db.Uuid
  /// KNOWLEDGE_ISSUE_KINDS: stale | wrong | missing | duplicate | other
  kind              String
  /// KNOWLEDGE_ISSUE_STATUSES: open | checking | proposed | resolved | dismissed
  status            String    @default("open")
  /// Untrusted, ≤ 4 000 chars. Wrapped before any model sees it.
  detail            String
  /// KnowledgeIssueEvidence[] (≤ 10). Untrusted.
  evidence          Json      @default("[]")
  /// A corrected body the reporter supplied, ≤ 200 000 chars. Untrusted; an
  /// editor's becomes a draft MR as-is, a viewer's only ever reaches the sentinel.
  suggestedMarkdown String?   @map("suggested_markdown")
  /// KNOWLEDGE_ISSUE_SURFACES: an answer surface, or 'web' for the page itself.
  surface           String
  reportCount       Int       @default(1) @map("report_count")
  agentRunId        String?   @map("agent_run_id") @db.Uuid
  mergeRequestId    String?   @map("merge_request_id") @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  apiKeyId          String?   @map("api_key_id") @db.Uuid
  resolvedBy        String?   @map("resolved_by") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([workspaceId, status, createdAt])
  @@index([documentId, status])
  @@index([createdBy, createdAt])
  @@map("knowledge_issues")
}

// ---------------------------------------------------------------------------
// AI settings (docs/features/12): the assistant layer made administrable per
// workspace instead of per boot. Every column here is an OVERRIDE — null means
// "inherit the env value" — so an empty table reproduces today's behaviour
// exactly. workspace_id carries no FK, mirroring documents.workspace_id.
// ---------------------------------------------------------------------------

model AiSettings {
  workspaceId String @id @map("workspace_id") @db.Uuid

  // Provider config. Null = inherit the ASSISTANT_* env var (AiConfigService).
  provider     String?
  baseUrl      String? @map("base_url")
  model        String?
  // AES-256-GCM envelope ("gcm$iv$tag$ct"); never leaves the API process.
  apiKeyCipher String? @map("api_key_cipher")
  temperature  Float?
  maxToolCalls Int?    @map("max_tool_calls")
  timeoutMs    Int?    @map("timeout_ms")

  /// Lets an admin take write tools (create_document / propose_update) away from the chat.
  agentModeEnabled Boolean @default(true) @map("agent_mode_enabled")

  // Cost estimate inputs (USD per 1M tokens). Null falls back to MODEL_PRICES.
  pricePromptPerMTok     Decimal? @map("price_prompt_per_mtok") @db.Decimal(12, 6)
  priceCompletionPerMTok Decimal? @map("price_completion_per_mtok") @db.Decimal(12, 6)

  // Quotas — null = unlimited. Only enforced while enforceBudget is set.
  workspaceMonthlyTokenBudget   BigInt? @map("workspace_monthly_token_budget")
  defaultUserMonthlyTokenBudget BigInt? @map("default_user_monthly_token_budget")
  enforceBudget                 Boolean @default(false) @map("enforce_budget")

  /// Per-purpose routing into ai_providers. Null = fall back to the columns
  /// above, then to the ASSISTANT_* env vars — so a workspace that never
  /// creates a provider profile behaves exactly as it did before.
  chatProviderId       String? @map("chat_provider_id") @db.Uuid
  reviewProviderId     String? @map("review_provider_id") @db.Uuid
  extractionProviderId String? @map("extraction_provider_id") @db.Uuid
  /// #530 — the decision model's profile. Unlike the three above, null means
  /// off: a decision never falls back to the inline config.
  decisionProviderId   String? @map("decision_provider_id") @db.Uuid

  /// #530 — pre-filter thresholds. Null inherits DECISION_THRESHOLDS (code);
  /// `decisionTunedModel` is the routed model when an override was last saved,
  /// since a threshold tuned on one Jev release can shift on the next.
  decisionArbiterThreshold  Float?  @map("decision_arbiter_threshold")
  decisionCitationThreshold Float?  @map("decision_citation_threshold")
  decisionHarvestThreshold  Float?  @map("decision_harvest_threshold")
  decisionTunedModel        String? @map("decision_tuned_model")

  /// Relation-extraction tuning. Null = inherit EXTRACTOR_MIN_CONFIDENCE /
  /// EXTRACTOR_MAX_CHUNKS. Workspace-scoped on purpose: these shape extraction
  /// behaviour, not the connection, so a provider profile never carries them.
  extractionMinConfidence Float? @map("extraction_min_confidence")
  extractionMaxChunks     Int?   @map("extraction_max_chunks")

  /// docs/features/25 — 'off' | 'allowlist' | 'open'. Null inherits the
  /// WEB_ACCESS_MODE env ceiling, and the effective value is the NARROWER of
  /// the two: a settings row must never widen what the model can reach.
  webAccessMode String? @map("web_access_mode")

  /// Issue #68 — whether the page AI actions menu may hand content to external
  /// AI vendors (Open in ChatGPT/Claude/Cursor with inline content). Null
  /// inherits AI_EXTERNAL_ACTIONS_ENABLED; the effective value is the NARROWER
  /// of the two.
  externalAiActions Boolean? @map("external_ai_actions")

  /// Agent-session memory (issue #73). Null inherits the CAPTURE_* env value.
  /// `captureEnabled` and the two limits are clamped by that env value — a
  /// workspace may ask for less, never more. The thresholds are plain
  /// overrides: tuning dedupe to an embedding model widens nothing.
  captureEnabled            Boolean? @map("capture_enabled")
  capturePerKeyPerHour      Int?     @map("capture_per_key_per_hour")
  capturePerWorkspacePerDay Int?     @map("capture_per_workspace_per_day")
  captureDedupeThreshold    Float?   @map("capture_dedupe_threshold")
  captureAmendThreshold     Float?   @map("capture_amend_threshold")
  /// The page new captured pages are nested under. No FK, mirroring
  /// documents.parent_id; null puts them at the project root.
  captureParentDocumentId   String?  @map("capture_parent_document_id") @db.Uuid

  /// Days a page's quality score stands before the auditor re-scores an
  /// unchanged page (#74, phase 4). Null inherits QUALITY_AUDIT_DAYS.
  qualityAuditDays Int? @map("quality_audit_days")

  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ai_settings")
}

/// One exception to whatever the workspace's web access mode reads by default
/// (docs/features/25). Under `allowlist`, allow=true rows are what may be
/// fetched; under `open`, allow=false rows are what may not be. Longest
/// pattern match wins, so `open` + `example.com` denied + `docs.example.com`
/// allowed is expressible in one list.
///
/// One boolean, because only one thing is enforceable. A trust tier would
/// reduce to a sentence in a prompt, and a prompt rule is advisory — a field
/// that cannot be enforced is a field that lies.
///
/// No FK on workspace_id, matching every other workspace-scoped table here.
model SourcePolicy {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Host pattern, lowercased: `example.com` also matches its subdomains.
  pattern     String
  allow       Boolean
  /// Why this row exists, for whoever inherits the list.
  note        String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, pattern])
  @@index([workspaceId])
  @@map("source_policies")
}

/// A named provider profile. Several can exist per workspace; ai_settings
/// routes each purpose (chat / review / extraction) at one of them, and a chat
/// thread may pin its own. The routing columns carry no FK, mirroring how
/// assignee_id and author_id are handled elsewhere: the service nulls dangling
/// references on delete rather than the database cascading them.
model AiProvider {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  /// Display name, unique per workspace ("DeepSeek prod", "Local Ollama").
  name         String
  /// 'openai-compatible' | 'deepseek'
  provider     String
  baseUrl      String? @map("base_url")
  model        String
  /// AES-256-GCM envelope; never leaves the API process.
  apiKeyCipher String? @map("api_key_cipher")

  temperature  Float?
  maxToolCalls Int?   @map("max_tool_calls")
  timeoutMs    Int?   @map("timeout_ms")

  pricePromptPerMTok     Decimal? @map("price_prompt_per_mtok") @db.Decimal(12, 6)
  priceCompletionPerMTok Decimal? @map("price_completion_per_mtok") @db.Decimal(12, 6)

  /// AgentCapability[] declared by an admin, overriding the MODEL_CAPABILITIES
  /// code table the router filters on. Same shape as the price overrides above:
  /// a code table that will go stale, plus a per-profile escape hatch.
  capabilities Json?

  enabled       Boolean   @default(true)
  lastStatus    String?   @map("last_status")
  lastError     String?   @map("last_error")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("ai_providers")
}

/// Per-user override of AiSettings.defaultUserMonthlyTokenBudget.
model AiUserBudget {
  workspaceId        String   @map("workspace_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  monthlyTokenBudget BigInt?  @map("monthly_token_budget")
  updatedBy          String?  @map("updated_by") @db.Uuid
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([workspaceId, userId])
  @@map("ai_user_budgets")
}

/// A skill is an operator-authored instruction pack merged into the assistant's
/// system prompt — trusted text, unlike document content. Selected explicitly
/// from the composer or by keyword match against the user's message.
model AiSkill {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  name                String
  description         String
  instructions        String
  /// string[] — keywords that pull this skill into a turn. Json, not text[]:
  /// the schema uses no Postgres arrays (AssistantMessage.toolCalls precedent).
  triggers            Json      @default("[]")
  enabled             Boolean   @default(true)
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  /// 'manual' | 'repo' (AI_SKILL_SOURCES, #70). A `repo` skill was read from a
  /// guidance file of a repository connector and imported disabled.
  source              String    @default("manual")
  /// No FK: deleting the connector must not delete what an admin enabled.
  sourceConnectorId   String?   @map("source_connector_id") @db.Uuid
  sourcePath          String?   @map("source_path")
  /// SHA-256 of the file's content as last seen upstream.
  sourceSha           String?   @map("source_sha")
  /// New upstream text awaiting an admin's Accept — a sync never rewrites the
  /// live `instructions` of an enabled skill.
  pendingInstructions String?   @map("pending_instructions")
  sourceRemovedAt     DateTime? @map("source_removed_at") @db.Timestamptz
  /// 'skill' | 'styleguide' (AI_SKILL_KINDS, #74). A styleguide never joins a
  /// turn by trigger word: the linter injects it explicitly.
  kind                String    @default("skill")
  /// Styleguide scope: null = workspace-wide; set = replaces it for one project.
  /// No FK (house style).
  projectId           String?   @map("project_id") @db.Uuid
  /// StyleRule[] — only for kind='styleguide'. Json, not an array (the `triggers` precedent).
  rules               Json?

  @@unique([workspaceId, name])
  /// One skill per guidance file. NULLs are distinct in PG, so manual rows never collide.
  @@unique([workspaceId, sourceConnectorId, sourcePath])
  /// One styleguide per (workspace, project) is a raw partial unique index in
  /// the migration (ai_skills_one_styleguide_per_scope), not expressible here.
  @@index([workspaceId, kind, projectId])
  @@index([workspaceId, createdAt])
  @@map("ai_skills")
}

/// An agent is a named actor: instructions + a tool allowlist + a model + an
/// output contract (docs/features/20). Before this table that tuple existed
/// three times anonymously — as an ai_skill without tools or a model, as one of
/// three hardcoded routing purposes, and inline on every WorkflowStep.
///
/// For a BUILT_IN_AGENT_KEYS agent a row is a *sparse override*: every column
/// below `key` is nullable and null means "inherit the code default", exactly
/// as ai_settings inherits the ASSISTANT_* env vars. An empty ai_agents table
/// therefore reproduces the pre-feature behaviour of every call site.
model AiAgent {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// A BUILT_IN_AGENT_KEYS value, or an admin-chosen slug for a custom agent.
  key         String
  builtIn     Boolean @default(false) @map("built_in")

  name         String?
  description  String?
  instructions String?
  /// string[] of tool names. Null = the built-in's default set. Validated on
  /// write against the built-in tool registry plus this workspace's enabled
  /// MCP plugin tools — Json, not text[], per the no-Postgres-arrays house rule.
  tools        Json?
  /// string[] of ai_skills ids always attached to this agent's turns.
  skillIds     Json?   @map("skill_ids")

  /// ai_providers profile pinned to this agent. Null falls through to the
  /// purpose route, then the inline config, then env (feature 12's chain).
  /// No FK, matching the other routing columns (house style).
  providerId String? @map("provider_id") @db.Uuid

  temperature  Float?
  maxToolCalls Int?   @map("max_tool_calls")
  timeoutMs    Int?   @map("timeout_ms")

  enabled Boolean @default(true)

  /// Background schedule (docs/features/20). Off by default — the failure mode
  /// of unattended AI is an avalanche, not a slow queue. A due check inside a
  /// fixed sweep, mirroring Connector.syncIntervalMinutes; not a cron.
  scheduleEnabled   Boolean   @default(false) @map("schedule_enabled")
  scheduleMinutes   Int?      @map("schedule_minutes")
  /// Extra instruction seeded into every scheduled run.
  scheduleNote      String?   @map("schedule_note")
  /// Who owns scheduled runs: they execute as this user and are capped by that
  /// user's role. NOT NULL in effect for scheduling — the sweeper skips a row
  /// without one rather than inventing ambient authority.
  scheduleOwner     String?   @map("schedule_owner") @db.Uuid
  lastRunAt         DateTime? @map("last_run_at") @db.Timestamptz
  /// Time-of-day schedules (#70). Sparse: a null kind is 'interval', so every
  /// row written before these columns behaves exactly as it did. Read through
  /// contracts' `nextScheduledRun` by the sweeper and the summary alike.
  scheduleKind      String?   @map("schedule_kind")
  /// `HH:MM`, 24-hour, in scheduleTimezone. A CHECK in the migration holds the format.
  scheduleTime      String?   @map("schedule_time")
  /// number[] of weekdays, 0 = Sunday. Json, not int[] — no Postgres arrays here.
  scheduleWeekdays  Json?     @map("schedule_weekdays")
  /// IANA zone; null reads as UTC.
  scheduleTimezone  String?   @map("schedule_timezone")
  /// When the schedule's shape last changed. Slots are counted from the later
  /// of this and lastRunAt, so an edit never fires a slot it moved into the past.
  scheduleChangedAt DateTime? @map("schedule_changed_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  runs AgentRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt])
  @@index([scheduleEnabled, lastRunAt])
  @@map("ai_agents")
}

/// One execution of an agent outside a request (docs/features/20).
///
/// `created_by` is NOT NULL, deliberately stricter than workflow_runs: a
/// trigger-started workflow run carries no creator, so its model call bills a
/// non-UUID and the usage insert is silently dropped. A run with nobody to bill
/// or authorise as is not a run this feature will start.
model AgentRun {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// ai_agents.key — resolved through the registry at execution time.
  agentKey    String  @map("agent_key")
  /// The override row, when one exists. Null for an untouched built-in.
  agentId     String? @map("agent_id") @db.Uuid

  /// 'manual' | 'schedule' | 'event' | 'webhook' | 'report' — see
  /// AGENT_RUN_TRIGGERS. 'event' is written only by AgentTriggerService (#70).
  trigger    String  @default("manual")
  /// The agent_triggers row behind an 'event' run. No FK: deleting a trigger
  /// must not take its history with it.
  triggerId  String? @map("trigger_id") @db.Uuid
  /// What the run is about — `doc:<id>`, `mr:<id>`, `connector:<id>`. The key
  /// the in-flight and cooldown guards read; null for an unscoped run.
  subjectKey String? @map("subject_key")
  /// pending → running → succeeded | failed | cancelled
  status     String  @default("pending")

  /// The user this run acts as. Its role caps what the run's tools may do, and
  /// a disabled or demoted owner fails the run rather than escalating it.
  createdBy String @map("created_by") @db.Uuid
  /// Frozen at enqueue, like import_jobs.locale and workflow_runs.locale.
  locale    String @default("en")

  /// What the run was asked to do (scope, note).
  input    Json?
  /// AgentFinding[] — every entry cites the pages it came from (plan.md §12.7).
  findings Json?
  /// Free-text summary the agent wrote for a human.
  summary  String?
  /// AgentRunDetails — what a run found that is not a finding: the drift
  /// check's affected usages (#236). Null when the run had nothing to add.
  details  Json?
  error    String?
  /// Incremented by the sweeper when a run is re-queued after going stale.
  attempt  Int     @default(0)

  /// Where the run is now, and how far in (docs/features/29). Written as it
  /// proceeds, which is what makes `updated_at` a heartbeat: the row used to be
  /// written exactly twice — the claim and the terminal result — so
  /// AgentScheduleSweeper.requeueStuck reaped anything slower than STALE_RUN_MS
  /// and billed its model calls a second time. Vocabulary converges on
  /// connector_runs, already the fullest polling shape in this schema, rather
  /// than inventing a third dialect for the same problem.
  stage    String?
  progress Float?
  /// What degraded without failing the run — a page that could not be read, a
  /// graph store that was down. Capped by the executor.
  warnings Json?

  /// The ledger (#305): what produced this run's output, stamped by the
  /// executor at execution. Null on runs from before the ledger, which read as
  /// unattributed. `prompt_hash` is the SHA-256 of the trusted prompt parts
  /// only (instructions, skills, styleguide, learnings) — never page content —
  /// and `learning_ids` are exactly the learnings that prompt rendered.
  providerId  String?  @map("provider_id") @db.Uuid
  model       String?
  promptHash  String?  @map("prompt_hash")
  learningIds String[] @map("learning_ids") @db.Uuid

  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  agent AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, agentKey, createdAt])
  @@index([workspaceId, agentKey, subjectKey, createdAt])
  @@index([triggerId, subjectKey, createdAt])
  @@map("agent_runs")
}

/// Starts an agent run when something happens in the workspace (#70).
///
/// Several per agent, hence a table rather than more ai_agents columns. Every
/// guard AgentTriggerService applies is configured here and none is optional:
/// off on creation, an owner to run as, a cooldown per subject.
model AgentTrigger {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  /// Null hears every project in the workspace.
  projectId       String?   @map("project_id") @db.Uuid
  /// ai_agents.key — resolved through the registry when the trigger fires.
  agentKey        String    @map("agent_key")
  /// AgentTriggerEvent (contracts). A CHECK in the migration holds the vocabulary.
  event           String
  /// AgentTriggerFilter — sparse; an absent field matches everything.
  filter          Json      @default("{}")
  enabled         Boolean   @default(false)
  /// Who runs execute and bill as: the admin who last enabled the trigger.
  /// Null starts nothing (the AiAgent.scheduleOwner rule).
  ownerId         String?   @map("owner_id") @db.Uuid
  cooldownMinutes Int       @default(60) @map("cooldown_minutes")
  /// Seeded into each run's input.note.
  note            String?
  /// A 'webhook' trigger's HMAC secret, as an ai/secret-box.ts envelope.
  /// Write-only over the API: rotate-secret shows a new one once.
  webhookSecret   String?   @map("webhook_secret")
  lastFiredAt     DateTime? @map("last_fired_at") @db.Timestamptz

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([workspaceId, event, enabled])
  @@index([workspaceId, agentKey])
  @@map("agent_triggers")
}

/// A correction a person taught an agent (#70): "team guidance" appended to
/// that agent's later prompts. Only `active` rows reach a prompt, and only an
/// admin makes a row active — the text is trusted because a person approved
/// it, the same footing as an ai_skills row.
model AgentLearning {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Null applies in every project.
  projectId   String? @map("project_id") @db.Uuid
  /// Null applies to every agent.
  agentKey    String? @map("agent_key")
  text        String
  /// AGENT_LEARNING_STATUSES — proposed | active | archived.
  status      String  @default("proposed")

  /// AGENT_LEARNING_SOURCES — document-thread | mr-thread | finding | manual | derived.
  /// Provenance only, none of it a FK: the learning outlives its thread.
  sourceKind     String  @default("manual") @map("source_kind")
  /// The thread a thread source came from.
  sourceId       String? @map("source_id") @db.Uuid
  /// The page the source sits on (a page thread) or cites (a finding).
  documentId     String? @map("document_id") @db.Uuid
  /// The merge request an mr-thread source sits on.
  mergeRequestId String? @map("merge_request_id") @db.Uuid
  runId          String? @map("run_id") @db.Uuid
  findingIndex   Int?    @map("finding_index")
  /// AgentLearningEvidenceRef[] — the dismissed findings a learning rests on
  /// (#305): the learner's cluster for a `derived` one, plus any later similar
  /// dismissal it folded in. Null for a learning nothing was folded into.
  evidence       Json?

  /// The learner's proposed-archive flag (#305): set when an active learning
  /// showed no drop in dismissals across enough runs on each side of its
  /// activation. Never archives anything — an admin decides. Cleared when the
  /// learning is approved anew.
  archiveProposedAt DateTime? @map("archive_proposed_at") @db.Timestamptz
  /// AgentLearningArchiveCheck — the counts behind the flag, and an admin's
  /// "keep it" (keptAt/keptBy), after which the learner leaves it alone.
  archiveCheck      Json?     @map("archive_check")

  /// The zeros AUTHOR_ID_STUB for a `derived` learning: no person proposed it.
  createdBy  String    @map("created_by") @db.Uuid
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([workspaceId, agentKey, status])
  @@index([runId, findingIndex])
  @@map("agent_learnings")
}

/// A plugin is an external MCP server whose tools join the assistant's bounded
/// tool harness. HTTP transports only — stdio would mean spawning processes on
/// the API host. Its output is UNTRUSTED, handled like document content.
model AiPlugin {
  id              String  @id @default(uuid()) @db.Uuid
  workspaceId     String  @map("workspace_id") @db.Uuid
  name            String
  /// 'streamable-http' | 'sse'
  transport       String  @default("streamable-http")
  url             String
  /// Header name the credential is sent in (e.g. "Authorization").
  authHeader      String? @map("auth_header")
  /// AES-256-GCM envelope of the header value.
  authValueCipher String? @map("auth_value_cipher")
  enabled         Boolean @default(true)
  /// string[] — tools offered to the model. Empty = every discovered tool.
  enabledTools    Json    @default("[]") @map("enabled_tools")
  /// AiPluginTool[] — cache of the last successful listTools().
  discoveredTools Json    @default("[]") @map("discovered_tools")

  lastStatus    String?   @map("last_status")
  lastError     String?   @map("last_error")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
  @@map("ai_plugins")
}

/// One row per upstream LLM call — the source for BOTH the usage aggregates
/// and the call log. Deliberately holds no prompt or completion text: that
/// content already lives in assistant_messages, and a second copy would bloat
/// the table and duplicate user data.
model AiUsage {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  /// 'ask' | 'chat' | 'chat-stream' | 'review' | 'suggest'
  operation   String
  provider    String
  model       String
  /// ai_providers.id when a named profile served the call; null on the legacy
  /// single-config path.
  providerId  String? @map("provider_id") @db.Uuid

  promptTokens     Int     @default(0) @map("prompt_tokens")
  completionTokens Int     @default(0) @map("completion_tokens")
  totalTokens      Int     @default(0) @map("total_tokens")
  /// The provider returned no usage block, so the counts are a local estimate.
  estimated        Boolean @default(false)
  costUsdMicros    Int?    @map("cost_usd_micros")

  durationMs    Int     @default(0) @map("duration_ms")
  ok            Boolean @default(true)
  errorCode     String? @map("error_code")
  error         String?
  threadId      String? @map("thread_id") @db.Uuid
  toolCallCount Int     @default(0) @map("tool_call_count")
  /// Seconds of audio a `transcription` row transcribed (#551); null on every
  /// other operation, which bills by tokens.
  audioSeconds  Int?    @map("audio_seconds")
  /// The agent run this call was made for (#305), from the run context; null
  /// for a call outside a background run. No FK: usage outlives its run.
  agentKey      String? @map("agent_key")
  agentRunId    String? @map("agent_run_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@map("ai_usage")
}

/// Ops events: the failures worth keeping in SQL, beside audit_logs and
/// activity_log.
///
/// Deliberately NOT where the measurement stream goes. Search timings, model
/// calls and ingestion steps are written to the rotated JSONL under LOG_DIR,
/// because a full corpus re-index emits tens of thousands of them and nothing
/// transactional ever reads one. This table holds what somebody will search for
/// by trace id weeks later, after a report that "it broke on Tuesday".
///
/// No FK and no relation fields, matching all three log tables above: a record
/// outlives the thing it describes, and the evidence of what went wrong in a
/// workspace must not disappear with the workspace.
model OpsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  /// Ties this record to every other one from the same request, job, socket
  /// message or tool call. Plain String, not @db.Uuid: an inbound
  /// x-request-id is whatever the caller chose to send.
  traceId     String   @map("trace_id")
  /// 'http' | 'job' | 'ws' | 'mcp' | 'cli'
  source      String
  /// pino level name — in practice 'warn' | 'error' | 'fatal'.
  level       String
  /// OpsCode or ApiErrorCode from contracts. A closed set, so failures can be
  /// counted and alerted on; a message string can be neither.
  code        String?
  message     String
  /// Nullable because the most interesting failures happen *before* the tenant
  /// is resolved — a rejected token, a malformed body, a 404.
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  route       String?
  durationMs  Int?     @map("duration_ms")
  /// The serialized error ({type, message, stack}) plus any site-specific
  /// fields. Json for the activity_log.metadata reason: the useful context
  /// differs per call site and must not cost a migration each time.
  fields      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([traceId])
  @@index([code, createdAt])
  @@map("ops_events")
}

/// Glossary (docs/features/14): the workspace's shared vocabulary. Terms are
/// linked into rendered documents deterministically at read time, so nothing
/// here ever rewrites a page — an entry can be renamed or retired and every
/// document follows on the next render.
/**
 * One occurrence of one term, on one page, that is not a mention of it.
 * The linker is deterministic and conservative, but it matches words, and a
 * word can be the term everywhere on a page except in the one sentence that
 * uses it as an ordinary word. Per-term rules cannot express that; this can.
 * The anchor is the TextQuoteSelector shape `document_threads` uses, minus the
 * revisionId: an exclusion is about the words, not about a version of them, so
 * it survives every edit that leaves the sentence recognisable — and stops
 * applying when the sentence is gone, which is the correct outcome.
 */
model GlossaryExclusion {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  termId      String   @map("term_id") @db.Uuid
  /// {quote, prefix?, suffix?}
  anchor      Json
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([documentId])
  @@index([termId])
  @@map("glossary_exclusions")
}

model GlossaryTerm {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  // Workspace > Project > Document, and vocabulary belongs to the project:
  // the same word means different things in two bodies of work. Denormalized
  // against projects.workspace_id exactly like documents.workspace_id, because
  // the ACL and the activity feed key off the workspace.
  projectId   String  @map("project_id") @db.Uuid
  term        String
  /// string[] — abbreviations and inflections that link to this entry. Json,
  /// not text[]: the schema uses no Postgres arrays (AiSkill.triggers precedent).
  aliases     Json    @default("[]")
  definition  String
  /// Page that defines the term in full. No FK, mirroring documents.parent_id:
  /// deleting the page must not delete the vocabulary that referenced it.
  documentId  String? @map("document_id") @db.Uuid
  /// 'manual' | 'ai' — provenance, same idea as the relation extractor classes.
  source      String  @default("manual")
  /// Retired terms stay readable in the glossary but stop being auto-linked.
  enabled     Boolean @default(true)

  // --- matching rules (all three are overrides of the shared default) ---
  /// false = link the headword only, never the aliases. The escape hatch for
  /// an alias that is also an ordinary word — "Заказ", "Order" — which links
  /// in every sentence that happens to use it.
  matchAliases    Boolean @default(true) @map("match_aliases")
  /// For terms that are only terms in one casing: "IT" against "it".
  caseSensitive   Boolean @default(false) @map("case_sensitive")
  /// null = the shared MAX_LINKS_PER_TERM. A page where every instance of a
  /// word is a link is unreadable, so there is always a cap; this moves it.
  maxLinksPerPage Int?    @map("max_links_per_page")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  // Per project, not per workspace: two projects may legitimately define the
  // same word, and neither should block the other.
  @@unique([projectId, term])
  @@index([workspaceId, enabled])
  @@index([projectId, enabled])
  @@map("glossary_terms")
}

/// Import (docs/features/16): a file on its way to becoming a page. The row
/// exists before the document does — the whole point is that parsing happens
/// first and the result is reviewed before anything is created — so this is a
/// table of its own rather than an `ingestion_jobs` row, whose `revision_id`
/// is NOT NULL and could not be filled yet.
///
/// The parsed markdown is deliberately NOT stored here: it goes to
/// `workspaces/{ws}/imports/{id}/parsed.md` beside the original, keeping the
/// three-store split honest (PG = transactional truth, MinIO = bytes) and
/// keeping the row the wizard polls every second small.
model ImportJob {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Destination chosen in step 1. Kept on the row rather than in the client
  /// so a reload — or a different tab — resumes into the same destination.
  projectId   String  @map("project_id") @db.Uuid
  /// No FK, mirroring documents.parent_id: the parent may be deleted while a
  /// long parse is still running, and that must not cascade into this row.
  parentId    String? @map("parent_id") @db.Uuid
  category    String  @default("other")

  /// awaiting-upload → queued → running → parsed → submitted, or failed.
  status   String  @default("awaiting-upload")
  /// Free-text act the worker is performing ("Reading 48 pages"), read straight
  /// into the progress label. Null whenever the client's own phase is showing.
  stage    String?
  /// 0..1 when the worker can honestly say; null means indeterminate, which is
  /// what the ring renders rather than inventing a percentage.
  progress Float?

  sourceFilename String  @map("source_filename")
  contentType    String  @map("content_type")
  sizeBytes      Int     @default(0) @map("size_bytes")
  s3Key          String  @map("s3_key")
  /// Which parser ran ('pdf', 'docx', …) — shown in the review provenance strip.
  parser         String?

  /// Title the parser detected; the review step seeds its field from this.
  title    String?
  /// string[] — what the parse could not carry (dropped images, no headings).
  warnings Json?
  /// Parser-specific counts the provenance strip reports: pages, slides,
  /// sections, needsOcr.
  meta     Json?
  error    Json?

  /// Set when the import is submitted, so a row is also the audit trail of
  /// where a page came from.
  documentId String? @map("document_id") @db.Uuid

  /// Language of whoever started the import, frozen here: OCR transcription and
  /// parser warnings are produced later by the worker, which has no request to
  /// read Accept-Language from.
  locale String @default("en")

  createdBy   String?   @map("created_by") @db.Uuid
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Dynamic document workflows (docs/features/17)
// ---------------------------------------------------------------------------

/// A configurable graph of steps: entity → use-cases → API endpoints + pages.
model WorkflowDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// Null = offered in every project of the workspace. A project id scopes the
  /// definition the way glossary terms are scoped — the same chain means
  /// different things in two products.
  projectId   String? @map("project_id") @db.Uuid

  name        String
  description String?
  enabled     Boolean @default(true)
  /// Bumped on every graph write. A run records the version it started from,
  /// so "which shape of this workflow produced that page" stays answerable.
  version     Int     @default(1)

  /// WorkflowGraph — { steps: WorkflowStep[], layout }. Validated by
  /// compileDefinition() before every write, so a stored graph is always one
  /// the runtime can walk. Only ever *names* steps and transitions: the
  /// executors live in code, so a dynamic workflow is data, never logic.
  graph   Json
  /// WorkflowTrigger — { manual, autoStart, events[], categories[] }.
  trigger Json?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  runs WorkflowRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, projectId])
  @@map("workflow_definitions")
}

/// One execution of a definition against one source page.
model WorkflowRun {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  projectId    String @map("project_id") @db.Uuid
  definitionId String @map("definition_id") @db.Uuid

  /// The graph frozen at start. Editing a definition must never change what a
  /// run in flight is doing — the same reasoning that makes revisions
  /// immutable. Node.step_id resolves against this, not against the live row.
  definitionSnapshot Json    @map("definition_snapshot")
  definitionVersion  Int     @default(1) @map("definition_version")
  /// No FK, mirroring documents.parent_id: deleting the source page must not
  /// cascade away the audit trail of what it produced.
  rootDocumentId     String  @map("root_document_id") @db.Uuid
  /// Extra instructions for this run only, seeded into the first step.
  note               String?

  /// pending → running ⇄ awaiting-review → completed, or paused/cancelled/failed.
  status    String  @default("pending")
  /// The persisted xstate snapshot. This is what lets a run survive a worker
  /// crash, a deploy, and a week of nobody clicking Approve.
  snapshot  Json?
  error     String?
  /// Language the generated pages are written in, frozen at start for the same
  /// reason definition_snapshot is: the nodes run later, out of any request.
  locale    String  @default("en")
  /// Set when the run was started by a trigger rather than by a person.
  startedBy String? @map("started_by")

  /// The person this run belongs to, and the identity its nodes execute as.
  /// NOT NULL deliberately, matching agent_runs.created_by: a node's model call
  /// bills this id into ai_usage.user_id (@db.Uuid), so a null here used to be
  /// billed as the literal string 'workflow' — an insert that fails and is
  /// swallowed, which made auto-triggered spend invisible. A triggered run now
  /// runs as the definition's author, and a definition without one cannot
  /// auto-start at all (the AiAgent.scheduleOwner rule).
  createdBy  String    @map("created_by") @db.Uuid
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  nodes      WorkflowRunNode[]

  @@index([workspaceId, status, createdAt])
  @@index([rootDocumentId])
  @@index([definitionId, rootDocumentId, status])
  @@map("workflow_runs")
}

/// One step's intermediate result. The fan-out tree lives here as rows rather
/// than inside the run's xstate snapshot: the feature has to answer "every node
/// awaiting review in this project", and an opaque blob cannot be queried.
model WorkflowRunNode {
  id       String  @id @default(uuid()) @db.Uuid
  runId    String  @map("run_id") @db.Uuid
  /// Self-FK: this is the entity → use-case → endpoint tree. Cascades with the
  /// run, so a deleted run leaves no orphan branches.
  parentId String? @map("parent_id") @db.Uuid
  /// Which step of `WorkflowRun.definitionSnapshot` produced this node.
  stepId   String  @map("step_id")

  /// pending → running → awaiting-review → approved → materializing →
  /// materialized, or rejected/skipped/failed.
  status String @default("pending")

  /// What was fed in (parent draft, search hits, the run note).
  input  Json?
  /// WorkflowNodeDraft — { title, markdown, frontmatter, relations, summary }.
  /// The reviewable intermediate result; editable until approved.
  draft  Json?
  /// Raw model output kept for provenance when the draft has been edited.
  output Json?

  /// Set once approved and written to the page tree. No FK, mirroring
  /// documents.parent_id.
  documentId String? @map("document_id") @db.Uuid
  error      String?
  /// Incremented by RETRY; the sweeper uses it to stop re-queueing forever.
  attempt    Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  run      WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent   WorkflowRunNode?  @relation("WorkflowNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children WorkflowRunNode[] @relation("WorkflowNodeTree")

  @@index([runId, status])
  @@index([documentId])
  @@map("workflow_run_nodes")
}

// ---------------------------------------------------------------------------
// Connectors (docs/features/19) — external systems as first-class, workspace
// configured sources and destinations. Confluence, Jira, Notion, markdown/git.
// ---------------------------------------------------------------------------

/// One configured connection to an external system, owned by a workspace.
model Connector {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// ConnectorKind — 'confluence' | 'jira' | 'notion' | 'markdown-git' | 'google-drive' | ….
  kind        String
  /// Display name, unique per workspace ("Product wiki", "Runbooks repo").
  name        String
  enabled     Boolean @default(true)

  /// Kind-specific, non-secret settings: base URL, space key, JQL, database id,
  /// repo/branch/subdir. Shape is validated per kind by the adapter.
  config Json @default("{}")

  /// AES-256-GCM envelope ("gcm$iv$tag$ct"); never leaves the API process.
  credential     String?
  /// Last-4 hint so the UI can show a credential is set without revealing it.
  credentialHint String? @map("credential_hint")

  /// Where pulled pages land. project_id carries a real FK like documents does;
  /// parent_id does not, mirroring documents.parent_id.
  projectId String  @map("project_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid
  category  String  @default("other")

  /// 'pull' | 'push' | 'both'
  direction     String  @default("pull")
  /// 'manual' opens a merge request; 'external-wins' | 'local-wins' overwrite.
  conflict      String  @default("manual")
  /// Push a linked page back automatically when a new revision is indexed.
  pushOnPublish Boolean @default(false) @map("push_on_publish")

  /// 'auto' | 'review' | 'step' — default mode for runs this connector starts
  /// (docs/features/26). 'auto' is the pre-feature behaviour, so every existing
  /// row keeps it.
  syncMode          String  @default("auto") @map("sync_mode")
  /// Recreate the external tree under parent_id. Default false: turning it on is
  /// a visible change to somebody's page tree and has to be asked for, and it
  /// never moves pages already imported.
  preserveHierarchy Boolean @default(false) @map("preserve_hierarchy")

  /// null = manual only. The worker's schedule sweeper reads this.
  syncIntervalMinutes Int?    @map("sync_interval_minutes")
  /// AES-256-GCM envelope. null = inbound webhooks are refused for this connector.
  webhookSecret       String? @map("webhook_secret")

  lastRunId    String?   @map("last_run_id") @db.Uuid
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz
  /// Where the next incremental pull reads the source's change feed from
  /// (#338: the Drive Changes API page token). Null = never read: the next run
  /// walks the whole tree. Written only when a run finishes.
  changeCursor String?   @map("change_cursor")
  /// Where the next work-item poll reads the tracker from (#424): an
  /// "updated since" timestamp the tracker adapter formats. Null = never
  /// polled. Separate from change_cursor, which belongs to the content pull.
  taskCursor   String?   @map("task_cursor")

  /// Access mirroring (#76). Columns rather than `config` keys: like sync_mode
  /// they apply to every kind, and the schedule sweeper filters on them.
  /// CONNECTOR_ACL_MODES — 'off' | 'mirror' | 'mirror_strict'.
  aclMode                String    @default("off") @map("acl_mode")
  /// Minutes between ACL-only refreshes; null = CONNECTOR_ACL_SYNC_DEFAULT_MIN.
  aclSyncIntervalMinutes Int?      @map("acl_sync_interval_minutes")
  /// One workspace group every page is restricted to, for a kind that cannot
  /// read per-item ACLs (Notion). No FK, as for every subject id.
  aclAudienceGroupId     String?   @map("acl_audience_group_id") @db.Uuid
  aclSyncedAt            DateTime? @map("acl_synced_at") @db.Timestamptz

  /// Frozen at creation: worker-produced stages and warnings have no request to
  /// read Accept-Language from (same reasoning as import_jobs.locale).
  locale String @default("en")

  /// The account this connector dials as (#564). Null until the API boot step
  /// backfills it; `credential` above stays the fallback for one release, so
  /// the previous image still syncs against a migrated database.
  connectionId String? @map("connection_id") @db.Uuid

  /// The page a `web` connector belongs to (#674): "Add page → Link a source"
  /// makes one connector per page, hidden from the Connectors list and
  /// managed from that page. Null for every connector a person set up. No FK,
  /// like documents.parent_id: the page's teardown deletes the connector.
  ownerDocumentId String? @map("owner_document_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  project               Project                @relation(fields: [projectId], references: [id])
  connection            Connection?            @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  links                 ConnectorLink[]
  recipes               SourceRecipe[]
  runs                  ConnectorRun[]
  conflicts             ConnectorConflict[]
  workItems             ConnectorWorkItem[]
  identities            ExternalIdentity[]
  harvests              ConnectorHarvest[]
  codeImports           CodeImport[]
  codeFiles             CodeFile[]
  componentDeclarations ComponentDeclaration[]
  trackerRoutes         ProjectTrackerRoute[]

  @@unique([workspaceId, name])
  @@index([workspaceId, kind])
  @@index([ownerDocumentId])
  @@map("connectors")
}

/// One account's access to one upstream system (#564, CONNECTION_PROVIDERS):
/// shared by every connector of a compatible kind in the workspace, so a token
/// is pasted once and rotated once. Exactly one `method`:
/// - `token` — `credential` holds the pasted secret;
/// - `app` — `external_ref` is a GitHub App installation id;
/// - `oauth` — `external_ref` is a Figma grant (`figma_oauth_grants`).
///
/// No FK on workspace_id or created_by, per house policy.
model Connection {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// ConnectionProvider, derived from the connector kind by `connectionProviderFor`.
  provider    String
  /// ConnectionMethod — 'token' | 'app' | 'oauth'.
  method      String
  /// The upstream origin for providers that are not one fixed host (an
  /// Atlassian site, a GitLab instance); null otherwise.
  site        String?

  /// Who the credential belongs to upstream, from the provider's identify
  /// probe. Null for a connection backfilled from a connector (never probed).
  accountId        String? @map("account_id")
  accountLabel     String? @map("account_label")
  accountAvatarUrl String? @map("account_avatar_url")

  /// secret-box envelope ("gcm$iv$tag$ct"), `token` only. Never leaves the API.
  credential     String?
  /// Last-4 hint, as on connectors.
  credentialHint String? @map("credential_hint")
  /// Installation id (`app`) or Figma grant id (`oauth`).
  externalRef    String? @map("external_ref")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  connectors Connector[]

  /// One row per installation or grant in a workspace. Token rows carry a
  /// null external_ref, which Postgres never counts as a duplicate.
  @@unique([workspaceId, provider, method, externalRef])
  @@map("connections")
}

/// The identity map between an external item and a page. Without it a second
/// pull duplicates every page; with it, pull is idempotent and push knows what
/// to send. content_hash/external_version are what the two sides last agreed
/// on, which is how the pull -> push -> webhook -> pull echo loop is broken.
model ConnectorLink {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  /// No FK: a deleted page leaves a tombstone the next sync prunes or re-creates.
  documentId  String @map("document_id") @db.Uuid

  externalId      String  @map("external_id")
  externalUrl     String? @map("external_url")
  externalTitle   String? @map("external_title")
  /// Confluence version.number, Notion last_edited_time, git blob sha, ...
  externalVersion String? @map("external_version")

  /// sha256 of the markdown both sides last agreed on.
  contentHash   String? @map("content_hash")
  /// The revision that hash came from.
  revisionId    String? @map("revision_id") @db.Uuid
  /// sha256 of the restriction last written for this page (#76): the switch
  /// plus its connector grants, after identity mapping. Null = never mirrored.
  aclHash       String? @map("acl_hash")
  /// Whether this connector switched the page's restriction on. Only then may
  /// an upstream that opened up switch it off again: a page a person
  /// restricted by hand stays restricted.
  aclRestricted Boolean @default(false) @map("acl_restricted")

  lastPulledAt DateTime? @map("last_pulled_at") @db.Timestamptz
  lastPushedAt DateTime? @map("last_pushed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// Source-backed pages (#674), `web` links only. Paused: the source writes
  /// nothing, and counts in ahead_count the new versions it would have
  /// written (ahead_hash = the last one counted).
  pausedAt     DateTime? @map("paused_at") @db.Timestamptz
  aheadCount   Int       @default(0) @map("ahead_count")
  aheadHash    String?   @map("ahead_hash")
  /// Consecutive failed syncs (retries exhausted, or unparseable), and
  /// consecutive 404/410s; SOURCE_FAILURE_LIMIT of the second archives the page.
  failures     Int       @default(0)
  goneCount    Int       @default(0) @map("gone_count")
  /// A transient failure's next retry (SOURCE_RETRY_DELAYS_MIN[retry_attempt - 1]).
  retryAttempt Int       @default(0) @map("retry_attempt")
  retryAt      DateTime? @map("retry_at") @db.Timestamptz
  /// Extraction recipes (#674, phase 2). The last good version's h1/h2
  /// headings and word count (the implicit checks compare against it), and
  /// the structural fingerprint the last fetch had.
  baseline           Json?     @db.JsonB
  fingerprint        Json?     @db.JsonB
  /// The fingerprint moved while the recipe's checks still pass: a note and a
  /// Draft button, no model call. Cleared by a saved recipe or a dismiss.
  structureChangedAt DateTime? @map("structure_changed_at") @db.Timestamptz
  /// Set while a version is held: the checks failed, the page stays on its
  /// last good revision. held_reason = the failed checks, comma-separated.
  heldAt             DateTime? @map("held_at") @db.Timestamptz
  heldReason         String?   @map("held_reason")
  /// Why, in the source's own words, when a check names one: the parser's
  /// message for a spec that no longer parses (phase 4).
  heldDetail         String?   @map("held_detail")
  /// sha256 of the last fetched body, stored at sourceBodyObjectKey.
  bodyHash           String?   @map("body_hash")

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([documentId])
  @@map("connector_links")
}

/// An extraction recipe (#674, phase 2): how a `web` source's HTML becomes
/// its page. Declarative data only — selectors, a heading map, landmarks and
/// normalization rules — never code. Immutable versions; a page-scope row
/// (document_id set) replaces the connector-scope one. At most one `active`
/// and one `proposed` per scope, kept by updateMany-then-insert.
model SourceRecipe {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  connectorId String  @map("connector_id") @db.Uuid
  /// Null = the connector's recipe. No FK, like connector_links.document_id.
  documentId  String? @map("document_id") @db.Uuid
  version     Int
  /// proposed | active | superseded | rejected
  status      String
  /// agent | person
  origin      String
  recipe      Json    @db.JsonB
  /// The agent's one-line account of what it changed, shown in the review.
  note        String?
  createdBy   String?   @map("created_by") @db.Uuid
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, version])
  @@index([connectorId, documentId, status])
  @@map("source_recipes")
}

/// The reverse-import index of a code connector's head (#236): one row per
/// importer → imported file pair. Replaced whole on every pull, in one
/// transaction, so only one head's rows exist at a time — an index like a
/// revision's chunks, not an aggregate.
model CodeImport {
  connectorId  String   @map("connector_id") @db.Uuid
  /// No FK, as for every workspace id.
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// The commit the row was read at; null when the host did not say.
  headSha      String?  @map("head_sha")
  /// Repo-relative paths.
  importerPath String   @map("importer_path")
  importedPath String   @map("imported_path")
  /// The names the importer takes: `default`, `*` for a namespace, star or
  /// dynamic import, empty for a side-effect import.
  names        String[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@id([connectorId, importerPath, importedPath])
  /// "What imports this file" — the question the index exists to answer.
  @@index([connectorId, importedPath])
  @@map("code_imports")
}

/// Every file of a code connector's head (#236, phase 6), so "does this
/// declared path still exist" has an answer: `code_imports` cannot give one,
/// because a file that imports nothing and is imported by nothing has no row
/// there. Replaced with `code_imports`, in the same transaction.
model CodeFile {
  connectorId String   @map("connector_id") @db.Uuid
  /// No FK, as for every workspace id.
  workspaceId String   @map("workspace_id") @db.Uuid
  headSha     String?  @map("head_sha")
  /// Repo-relative; includes files the archive skipped for size or for being binary.
  path        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@id([connectorId, path])
  @@map("code_files")
}

/// The code a page declares it documents (#236, phase 2): its `component:`
/// frontmatter, read from the head of the page's default branch and resolved
/// to a code connector. One row per page. Written by ingestion when the page
/// indexes, and re-resolved on every codebase pull, so a connector added after
/// the page is picked up without a re-edit.
model ComponentDeclaration {
  documentId    String   @id @map("document_id") @db.Uuid
  /// No FK, as for every workspace id.
  workspaceId   String   @map("workspace_id") @db.Uuid
  /// The revision the declaration was read from.
  revisionId    String   @map("revision_id") @db.Uuid
  /// `component:<name>`, canonically folded — the vertex usage edges point at.
  componentKey  String   @map("component_key")
  /// The component as the page spells it — the vertex's label, never folded.
  componentName String   @map("component_name")
  /// As the page wrote it (`owner/repo` or a URL); null when it named none.
  repository    String?
  /// Null while unresolved; `warning` says why.
  connectorId   String?  @map("connector_id") @db.Uuid
  /// Repo-relative files, directories (`dir/`) or globs.
  paths         String[]
  /// Narrows "used" to these exported names; empty means any import.
  symbols       String[]
  /// A ComponentDeclarationWarning, or null when the declaration resolved.
  warning       String?
  /// The declared paths that match no file at the connector's indexed head,
  /// set by `ComponentsService.rebuild`. Empty while unresolved or never pulled.
  missingPaths  String[] @default([]) @map("missing_paths")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  connector Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([connectorId])
  @@map("component_declarations")
}

/// An upstream person a connector's ACLs name (#76, phase 6), and who they are
/// here. Kept while unmapped, so the connector page can list them and a later
/// signup or a manual mapping re-resolves them on the next ACL sync.
model ExternalIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  connectorId String   @map("connector_id") @db.Uuid
  /// Confluence accountId / userKey, GitHub numeric user id.
  externalId  String   @map("external_id")
  /// Upstream's name for them. Source text: length-limited, rendered as text.
  displayName String?  @map("display_name")
  email       String?
  /// No FK (house policy).
  userId      String?  @map("user_id") @db.Uuid
  /// EXTERNAL_IDENTITY_MAPPINGS — manual | provider | email; null while unmapped.
  /// A manual mapping is never overwritten by resolution.
  mappedBy    String?  @map("mapped_by")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([workspaceId, userId])
  @@map("external_identities")
}

/// A resolved item of a harvest connector (#382, doc 59), claimed by its
/// webhook and finished by `ConnectorHarvestSweeper` (API-only). The unique
/// key is the once-per-item rule: the insert is the claim, so a redelivery or
/// a second process claims nothing. A row whose item turns out not to qualify
/// is deleted, so a later qualifying delivery can claim it again.
model ConnectorHarvest {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  connectorId String    @map("connector_id") @db.Uuid
  /// The item's id at the source (a Linear issue id).
  externalId  String    @map("external_id")
  /// Who resolved it, as the source names them: what attribution resolves.
  actorId     String    @map("actor_id")
  /// A sweep working on it; a lease, so a crashed process's row is retried.
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz
  /// Done. Set once, and the row stays, which is what stops a second harvest.
  harvestedAt DateTime? @map("harvested_at") @db.Timestamptz
  /// The person it ran as (no FK, house policy) and what it proposed.
  userId      String?   @map("user_id") @db.Uuid
  proposed    Int       @default(0)
  duplicates  Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([harvestedAt, lockedAt])
  @@map("connector_harvests")
}

/// One sync execution. The row is the truth and the queue is only the
/// scheduler: the client polls this, never the job (docs/features/16 contract).
model ConnectorRun {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  /// 'pull' | 'push'
  direction String
  /// 'manual' | 'schedule' | 'webhook'
  trigger   String
  /// queued -> running -> succeeded | partial | failed,
  /// plus paused | awaiting-review | cancelled (docs/features/26).
  status    String  @default("queued")
  /// 'auto' | 'review' | 'step', frozen from the connector at creation — editing
  /// the connector must not change a run already in flight, the
  /// `definition_snapshot` rule.
  mode      String  @default("auto")
  /// discovering | fetching | awaiting-review | applying | reverting. Distinct
  /// from status: a run can be paused while discovering.
  phase     String?
  stage     String?
  progress  Float?

  /// Discovery frontier — item ids whose children are still unwalked. This is
  /// the checkpoint that makes a paused or timed-out tree walk resumable
  /// instead of restarting from the first page.
  cursor Json?

  created    Int @default(0)
  updated    Int @default(0)
  skipped    Int @default(0)
  failed     Int @default(0)
  conflicts  Int @default(0)
  discovered Int @default(0)
  applied    Int @default(0)
  reverted   Int @default(0)

  /// Capped [{ externalId, title, message }] — a lossy sync that says nothing
  /// is the failure this feature exists to prevent.
  warnings     Json?
  error        Json?
  /// External ids this run is limited to; absent = the connector's whole scope.
  /// Webhooks send a handful, a full sync sends none.
  scope        Json?
  /// The change-feed cursor this run read at its start (#338), copied onto the
  /// connector when it finishes — never before, so a failed run re-reads.
  changeCursor String? @map("change_cursor")

  locale  String  @default("en")
  actorId String? @map("actor_id") @db.Uuid

  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  connector Connector          @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  items     ConnectorRunItem[]

  @@index([connectorId, createdAt])
  @@index([status, createdAt])
  @@map("connector_runs")
}

/// One external page, as one row (docs/features/26).
///
/// The tree lives here rather than inside the run for the reason
/// `workflow_run_nodes` gives: the feature has to answer "every item awaiting
/// review in this connector", and an opaque blob cannot be queried. It is also
/// what makes a pull revertable — nothing else records which revision an import
/// replaced.
model ConnectorRunItem {
  id           String  @id @default(uuid()) @db.Uuid
  runId        String  @map("run_id") @db.Uuid
  /// Self-FK: the external hierarchy as discovered. Cascades with the run.
  parentItemId String? @map("parent_item_id") @db.Uuid

  externalId       String  @map("external_id")
  externalParentId String? @map("external_parent_id")
  externalUrl      String? @map("external_url")
  externalVersion  String? @map("external_version")
  title            String
  depth            Int     @default(0)
  position         Int     @default(0)
  /// The adapter said this branch continues; discovery has not reached it yet.
  hasChildren      Boolean @default(false) @map("has_children")

  /// discovered -> fetching -> staged -> approved -> applying -> applied,
  /// or unchanged | skipped | rejected | failed | reverted.
  status String  @default("discovered")
  /// What applying would do: create | update | unchanged | conflict.
  action String?

  /// Small metadata only — { frontmatter?, warnings[], aiOp?, edited?, orphan? }.
  /// The markdown is an object, not a column: a 500-page space would otherwise
  /// be tens of megabytes of JSONB in a row the UI polls.
  draft Json?

  contentHash String? @map("content_hash")
  /// The upstream ACL read while staging (#76), normalized — `ExternalAcl`, or
  /// `{ error }` when it could not be read. Applied with the page.
  acl         Json?
  /// workspaces/{ws}/connector-runs/{runId}/items/{itemId}/staged.md
  stagedKey   String? @map("staged_key")
  /// .../incoming.md — the unedited conversion. Never rewritten, so "what did
  /// the far side actually send" survives every edit and every AI pass.
  incomingKey String? @map("incoming_key")

  documentId         String? @map("document_id") @db.Uuid
  linkId             String? @map("link_id") @db.Uuid
  /// The revision applying wrote, and the one it replaced. Together these are
  /// what let revert be a forward write rather than a deletion — the revision
  /// DAG is immutable.
  revisionId         String? @map("revision_id") @db.Uuid
  previousRevisionId String? @map("previous_revision_id") @db.Uuid
  createdDocument    Boolean @default(false) @map("created_document")

  error   String?
  attempt Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  run      ConnectorRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent   ConnectorRunItem?  @relation("ConnectorItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  children ConnectorRunItem[] @relation("ConnectorItemTree")

  /// Discovery idempotence: a resumed walk re-yielding a branch is a no-op
  /// rather than a duplicate row.
  @@unique([runId, externalId])
  @@index([runId, status])
  @@index([runId, parentItemId])
  @@index([documentId])
  @@map("connector_run_items")
}

/// A pull where both sides had changed. The worker writes the external version
/// to its own branch and records this row; the API-side sweeper turns it into a
/// merge request, because MergeRequestsService needs AccessService and cannot be
/// reached from the worker. Rare by nature, so a sweeper hop is the right cost.
model ConnectorConflict {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  documentId  String @map("document_id") @db.Uuid
  linkId      String @map("link_id") @db.Uuid

  /// Branch holding the incoming external version.
  branch      String
  revisionId  String  @map("revision_id") @db.Uuid
  externalUrl String? @map("external_url")
  title       String

  /// pending -> resolved. Set once the merge request exists.
  status         String    @default("pending")
  /// 'conflict' (both sides changed) | 'regenerated' (a repo wiki page delivered
  /// by merge request, docs/features/46). Titles the merge request.
  reason         String    @default("conflict")
  mergeRequestId String?   @map("merge_request_id") @db.Uuid
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([connectorId, createdAt])
  @@index([documentId, reason])
  @@map("connector_conflicts")
}

/// One unit of work in the external system — a GitHub issue or pull request
/// (docs/features/32).
///
/// Separate from connector_links, which maps external *content* onto a page and
/// whose document_id is NOT NULL because the echo-loop suppression reads it on
/// every sync. A work item is a different relationship: it usually has no page,
/// its interesting state is a lifecycle rather than a content hash, and it is
/// what an inbound repo event is about. A nullable document_id on the link
/// table would have made "is this page in sync" and "is this task done" the
/// same question, and they are not.
///
/// The row is a projection of the far side, refreshed by webhook and by list.
/// It is never authoritative: everything except document_id is overwritten
/// wholesale on the next delivery, which is why there is no local edit path.
model ConnectorWorkItem {
  id          String @id @default(uuid()) @db.Uuid
  connectorId String @map("connector_id") @db.Uuid
  /// Denormalised like every other workspace_id here, and for the same reason:
  /// the ACL predicate and the event bus both key off it.
  workspaceId String @map("workspace_id") @db.Uuid

  /// ConnectorWorkItemKind — 'issue' | 'pull-request'.
  kind   String
  /// The host's own number, as a person cites it ("#412"). Int, not BigInt:
  /// issue numbers are per-repository counters, unlike GitHub's global ids.
  number Int
  title  String
  /// ConnectorWorkItemState — 'open' | 'closed' | 'merged' | 'draft'.
  state  String @default("open")
  url    String

  /// Host logins, never resolved against our users: the person who closed an
  /// issue on GitHub may have no account here, and inventing one would put a
  /// name on an action they did not take in this product.
  authorLogin    String? @map("author_login")
  assigneeLogins Json    @default("[]") @map("assignee_logins")
  labels         Json    @default("[]")
  /// Names of the Projects v2 boards carrying this item. Names rather than ids
  /// because the board API is GraphQL-only and a name is what the rail renders.
  boards         Json    @default("[]")

  /// The page this work item is about. No FK, per house policy, and nullable
  /// because most work items never get one — attaching a page is what makes a
  /// repo event able to reach a workflow, and it is always a deliberate act.
  documentId String? @map("document_id") @db.Uuid

  /// The tracker's own citation when it is not `#<number>` — a Jira key
  /// (`BILL-123`). Null renders as `#<number>`. For Jira, `number` holds the
  /// site-wide issue id, which keeps (connector, kind, number) unique across
  /// the projects one Jira connector serves (#424).
  externalKey String? @map("external_key")

  /// The anchor (#424): the knowledge object this ticket was handed off for.
  /// WORK_ITEM_SOURCE_KINDS — 'issue' (knowledge_issues.id), 'conflict'
  /// (knowledge_conflicts.id), 'verification' (documents.id of the flagged
  /// page), 'document' (documents.id). Rows only, never a JSON finding. Both
  /// null on a plain projection. No FK: the anchor table varies by kind.
  sourceKind String? @map("source_kind")
  sourceId   String? @map("source_id") @db.Uuid

  /// The tracker's raw status ("In Progress", "not_planned"). `state` stays the
  /// coarse projection SQL filters on; WorkItemStatus is derived from this
  /// through the connector's status map at read time, never stored.
  externalStatus  String?   @map("external_status")
  /// WORK_ITEM_SYNC_STATES — 'synced' | 'pending' | 'failed' | 'orphaned'.
  /// Every existing row is a projection with nothing to push, so 'synced'.
  syncState       String    @default("synced") @map("sync_state")
  /// The WorkItemStatus an outbound transition should reach; set with
  /// sync_state = 'pending', cleared when the tracker confirms.
  pendingStatus   String?   @map("pending_status")
  /// The tracker's error from the last failed attempt, shown on the chip.
  syncError       String?   @map("sync_error")
  syncAttempts    Int       @default(0) @map("sync_attempts")
  /// When the sweeper may try again (backoff); null = at once.
  nextSyncAt      DateTime? @map("next_sync_at") @db.Timestamptz
  /// The tracker account behind the last change, as the tracker names it
  /// (GitHub numeric user id, Jira accountId). Resolved through
  /// external_identities for attribution only; unmapped is `tracker:<connectorId>`.
  externalActorId String?   @map("external_actor_id")

  externalCreatedAt DateTime? @map("external_created_at") @db.Timestamptz
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  /// Webhook idempotence: a redelivered event updates the row it already wrote
  /// rather than adding a second one.
  @@unique([connectorId, kind, number])
  /// One ticket per anchor per connector, for the anchor's lifetime: a re-raised
  /// conflict or a re-flagged page reopens this row's ticket. NULLs are
  /// distinct, so plain projections are unconstrained.
  @@unique([connectorId, sourceKind, sourceId])
  @@index([connectorId, state, externalUpdatedAt])
  @@index([documentId])
  @@index([sourceKind, sourceId])
  @@index([syncState, nextSyncAt])
  @@map("connector_work_items")
}

/// Which tracker a knowledge project hands off to (#424). One row per project:
/// a project without one has no rule-driven handoff, and a person picks the
/// connector by hand. Tracker-specific targets are columns, not JSON, because
/// each is one value a form edits and the handoff reads.
model ProjectTrackerRoute {
  id          String @id @default(uuid()) @db.Uuid
  /// No FK, house policy.
  workspaceId String @map("workspace_id") @db.Uuid
  projectId   String @unique @map("project_id") @db.Uuid
  connectorId String @map("connector_id") @db.Uuid

  /// Jira project key ("BILL"); ignored by repo trackers, which are one repo.
  externalProject String? @map("external_project")
  /// Jira issue type; null = 'Task'.
  issueType       String? @map("issue_type")
  /// GitHub org Projects v2 board and its single-select Status field.
  boardNodeId     String? @map("board_node_id")
  boardFieldId    String? @map("board_field_id")
  /// The board as a person pasted it, so the settings page can show it back.
  boardUrl        String? @map("board_url")

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([connectorId])
  @@map("project_tracker_routes")
}

/**
 * A named narrowing of the workspace merge-request list, private to its owner.
 * The integer id is the one deliberate departure from the uuid convention: a
 * saved view is addressed by the person who saved it (`#7`) and by the URL
 * (`/merge-requests?view=7`), and a uuid is unusable in both places. Nothing
 * else keys off it, so the sequence leaking a rough global count is harmless.
 * No FK on workspaceId/ownerId, mirroring documents.workspace_id and
 * merge_requests.author_id — the workspace is a scope here, enforced by the
 * ACL (AccessService.workspaceOfSavedFilter) rather than by the column.
 */
model SavedFilter {
  id          Int      @id @default(autoincrement())
  workspaceId String   @map("workspace_id") @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  /// SavedFilterQuery: { status?, search?, chips[] } — stored verbatim so a
  /// filter axis added to the bar needs no migration here.
  query       Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // One name per person per workspace: re-saving under an existing name is an
  // update, and the UI offers exactly that rather than a second "My reviews".
  @@unique([ownerId, workspaceId, name])
  @@index([workspaceId, ownerId])
  @@map("saved_filters")
}

// ---------------------------------------------------------------------------
// Notifications (docs/features/22): the per-person layer over the
// workspace-wide event bus and activity feed.
//
// No FK on workspace_id or user_id anywhere below, mirroring
// documents.workspace_id and saved_filters.owner_id — the workspace is a scope
// enforced by the ACL, not by the column. That is also what lets the
// AUTH_MODE=none dev principal, which has no users row at all, own an inbox.
// ---------------------------------------------------------------------------

/**
 * Who watches what.
 * `muted` is a stored row rather than the absence of one. Involvement
 * auto-subscribes — commenting on a page starts watching it — so a person who
 * unwatched would be re-added by their next comment, and "stop telling me
 * about this" has to be recorded as a fact that survives.
 */
model NotificationSubscription {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  /// 'document' | 'merge-request' | 'project' (NOTIFICATION_SUBJECT_TYPES).
  subjectType String  @map("subject_type")
  subjectId   String  @map("subject_id") @db.Uuid
  /// true = never notify me about this subject, and never re-subscribe me.
  muted       Boolean @default(false)
  /// How the row appeared: 'manual' when somebody pressed Watch, otherwise the
  /// involvement that added it ('author' | 'participant' | 'assigned' | ...).
  reason      String  @default("manual")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, subjectType, subjectId])
  // The fan-out's only query: everybody watching this subject.
  @@index([subjectType, subjectId])
  // The settings list: one person's subscriptions here, newest first, paged.
  // `createdAt` is part of the index because it is the sort the cursor walks —
  // without it the scan sorts in memory, which is what Notification's own
  // [workspaceId, userId, createdAt] already learned.
  @@index([workspaceId, userId, createdAt])
  @@map("notification_subscriptions")
}

/**
 * One inbox row for one person.
 * `title` is denormalized deliberately: an inbox that rewrote itself when a
 * page was renamed would answer a different question than "what happened while
 * I was away". There is no stored link either — the web derives one from
 * (type, documentId, subjectId), so a route rename cannot rot the archive.
 * No `category` column: the type is the durable fact and the category is a
 * reading of it (notificationCategoryFor), re-cuttable without a migration.
 */
model Notification {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  /// The KnowledgeEvent type that produced this row.
  type        String
  /// NOTIFICATION_REASONS — why this reached this person. Not derivable from
  /// the type: it is a fact about the fan-out decision.
  reason      String
  /// users.id or 'dev'; null for work no person triggered.
  actor       String?
  documentId  String? @map("document_id") @db.Uuid
  subjectType String? @map("subject_type")
  subjectId   String? @map("subject_id") @db.Uuid
  title       String?
  /// Render extras — `count` once a row has coalesced, error text, branch names.
  metadata    Json    @default("{}")

  readAt    DateTime? @map("read_at") @db.Timestamptz
  /// Claimed by the mail processor with one guarded update (docs/features/41):
  /// one email per row, however many times it later coalesces.
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // The badge and the unread-first list; also the coalescing lookup, which
  // matches (user_id, type, subject_id) among unread rows.
  @@index([userId, readAt, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@map("notifications")
}

/**
 * Per-person, per-workspace preferences — a sparse override of the code
 * defaults, the same relationship ai_settings has to the ASSISTANT_* env vars.
 * An empty table means everybody gets everything, so the feature ships
 * switched on without a migration writing a row per member.
 */
model NotificationPreference {
  userId             String  @map("user_id") @db.Uuid
  workspaceId        String  @map("workspace_id") @db.Uuid
  /// NotificationCategory[] switched off. A muted category suppresses even a
  /// directed notification — muting 'mention' means muting mentions.
  mutedCategories    Json    @default("[]") @map("muted_categories")
  /// Commenting on something subscribes you to it (GitHub's default).
  autoWatchOnComment Boolean @default(true) @map("auto_watch_on_comment")
  /// Email mentions, review requests and assignments (docs/features/41).
  emailDirected      Boolean @default(true) @map("email_directed")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([userId, workspaceId])
  @@map("notification_preferences")
}

/**
 * Per-workspace freshness policy (docs/features/40, #66) — a sparse override of
 * the VERIFICATION_* / PAGE_INACTIVE_AFTER_DAYS / EMPTY_PAGE_MAX_CHARS /
 * SEARCH_TRUST_RANKING env defaults. Null = inherit, so an empty table gives
 * exactly the env behaviour. workspace_id carries no FK, like ai_settings.
 */
model KnowledgeHealthSettings {
  workspaceId          String   @id @map("workspace_id") @db.Uuid
  reviewIntervalDays   Int?     @map("review_interval_days")
  remindBeforeDays     Int?     @map("remind_before_days")
  inactiveAfterDays    Int?     @map("inactive_after_days")
  emptyMaxChars        Int?     @map("empty_max_chars")
  trustRanking         Boolean? @map("trust_ranking")
  /// #305 tuner: the reciprocal-rank-fusion constant; null is SEARCH_RRF_K.
  rrfK                 Int?     @map("rrf_k")
  /// #401 relevance floor: absolute cosine for the vector leg; null is SEARCH_MIN_COSINE.
  minCosine            Float?   @map("min_cosine")
  /// #401 relevance floor: share of the leg's best cosine; null is SEARCH_MIN_COSINE_SHARE.
  minCosineShare       Float?   @map("min_cosine_share")
  /// #475 community prior: how much a matched community boosts its pages; null is 0 (off).
  communityPriorWeight Float?   @map("community_prior_weight")
  /// #475 community prior: the cosine a community summary must reach to count; null is 0.5.
  communityPriorFloor  Float?   @map("community_prior_floor")
  /// #475: hybrid expansion walks by entity layer; null is off (the flat walk).
  layeredExpansion     Boolean? @map("layered_expansion")
  /// #305 tuner: a sparse map over TRUST_WEIGHTS — only the states it names
  /// differ from the code default; null inherits all of them.
  trustWeights         Json?    @map("trust_weights")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("knowledge_health_settings")
}

/// A GitHub App installation on an account or organisation (docs/features/30).
///
/// Recorded per workspace rather than globally: an installation is what grants
/// this workspace's connectors read access to a set of repositories, and two
/// workspaces installing the App on the same org must not inherit each other's
/// connectors. The same org therefore appears once per workspace that installed
/// it, which is why the unique key is the pair and not installation_id alone.
///
/// No FK on workspace_id or created_by, per house policy — it is what lets the
/// AUTH_MODE=none dev principal, which has no users row, own data.
model GithubInstallation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  /// GitHub's own installation id. BigInt because GitHub's ids are 64-bit and
  /// already past what a signed 32-bit column could hold.
  installationId BigInt @map("installation_id")

  /// Denormalised from the App API at install time so the account switcher can
  /// render without a round trip per row, and so a suspended or deleted
  /// installation still shows a name rather than a number.
  accountLogin     String  @map("account_login")
  /// 'User' | 'Organization'.
  accountType      String  @map("account_type")
  accountAvatarUrl String? @map("account_avatar_url")

  /// 'all' | 'selected' — whether the org owner granted every repository or a
  /// chosen set. Surfaced in the picker so an empty list is explainable.
  repositorySelection String @default("all") @map("repository_selection")

  /// Set when GitHub reports the installation suspended; the row is kept so the
  /// connectors pointing at it can say why they stopped rather than vanishing.
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, installationId])
  @@index([workspaceId])
  @@map("github_installations")
}

/// One person's GitHub OAuth identity (docs/features/30).
///
/// Distinct from the installation above, and deliberately so: the installation
/// is what a *sync* authenticates as, and it outlives whoever configured it.
/// This is what *browsing* authenticates as, so that the account switcher can
/// show only the installations this person may actually reach — GET
/// /user/installations answers that, and no App-level credential can.
///
/// Keyed by our user id, not by workspace: a GitHub identity belongs to a
/// person, and the same person browsing two workspaces is still one identity.
model GithubUserToken {
  /// Our user id. No FK, per house policy.
  userId String @id @map("user_id") @db.Uuid

  githubUserId    BigInt  @map("github_user_id")
  githubLogin     String  @map("github_login")
  githubAvatarUrl String? @map("github_avatar_url")

  /// AES-256-GCM envelopes ("gcm$iv$tag$ct"), the same secret-box the connector
  /// credential uses. Never leaves the API process.
  accessToken  String  @map("access_token")
  refreshToken String? @map("refresh_token")

  /// Both null when the App does not have expiring user tokens switched on, in
  /// which case the access token is used until GitHub rejects it.
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("github_user_tokens")
}

/// A Figma OAuth grant (#557, docs/features/64), one row per Figma person.
///
/// Figma keeps one access token per app per user and a refresh invalidates the
/// previous one, so connectors reference this row (`config.figmaGrant`) rather
/// than holding a copy that could invalidate another. Belongs to no workspace:
/// it is pruned once no connector references it.
model FigmaOauthGrant {
  /// Figma's `user_id_string`.
  figmaUserId String @id @map("figma_user_id")
  handle      String

  /// secret-box envelopes, like the connector credential. Never leave the API.
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  /// The refresh lease: set by the one caller whose guarded update won, so the
  /// API and the worker never refresh the same grant at once.
  refreshingUntil DateTime? @map("refreshing_until") @db.Timestamptz

  /// Who last connected it. No FK, per house policy.
  connectedBy String? @map("connected_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("figma_oauth_grants")
}

/// A workspace's canonical spelling for an entity key: `сервис:биллинг` →
/// `service:billing` (docs/features/28).
///
/// `normalizeEntityKey` folds case and Unicode, which collapses `Сервис:Биллинг`
/// into one vertex — but it cannot know that the Russian and English names for
/// one service are the same service. That is a workspace's own vocabulary, so
/// it is data, exactly like GlossaryTerm.aliases is for prose.
///
/// No FK on workspace_id (house policy), and none on either key either: an
/// alias may legitimately be declared before the page that will first use the
/// canonical key exists.
model EntityAlias {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  /// Both sides are stored already folded by normalizeEntityKey — the unique
  /// index below only means anything if they are, so the service normalizes
  /// before it writes.
  alias        String
  canonicalKey String @map("canonical_key")

  /// 'manual' | 'merge' — provenance, the same idea as the extractor classes.
  source    String   @default("manual")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// An alias resolving to two canonicals is the one state that makes
  /// resolution non-deterministic; the database refuses it so the service
  /// never has to pick.
  @@unique([workspaceId, alias])
  @@index([workspaceId, canonicalKey])
  @@map("entity_aliases")
}

/// A page template (issue #69). Deliberately NOT a document: a document is
/// indexed, and a skeleton full of `{{placeholders}}` would surface in search,
/// the graph and the assistant's retrieval as facts about nothing. Closer to
/// WorkflowDefinition — data plus a version — than to a page.
///
/// Built-in templates live in code and are never seeded. A row with
/// `builtInKey` set is a workspace's override of one: its own versions
/// (customised), `enabled = false` (hidden), or both. "Reset to default"
/// deletes that row, so an empty table reproduces the built-in gallery exactly.
model PageTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  /// Null = offered in every project of the workspace (WorkflowDefinition precedent).
  projectId      String?   @map("project_id") @db.Uuid
  /// BUILT_IN_TEMPLATE_KEYS value when this row overrides a built-in; null for a custom template.
  builtInKey     String?   @map("built_in_key")
  name           String
  description    String?
  /// An emoji.
  icon           String?
  /// Denormalized from the current version's meta, so a list filters in SQL.
  category       String    @default("other")
  /// The version a new page is rendered at. A built-in override with no
  /// versions of its own (hidden only) keeps the code version here.
  currentVersion Int       @default(1) @map("current_version")
  /// False on a built-in override = "hide this built-in".
  enabled        Boolean   @default(true)
  /// Soft: hidden from the gallery, still resolvable by pages and workflows pinned to it.
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  versions PageTemplateVersion[]

  // Name uniqueness per (workspace, project) is enforced app-side: NULL
  // project ids are distinct to a unique index, and a partial one is not
  // expressible in Prisma.
  @@index([workspaceId, projectId])
  @@index([workspaceId, builtInKey])
  @@map("page_templates")
}

/// One immutable version of a template. A source change appends a row and
/// bumps `PageTemplate.currentVersion`; a name or icon change does not.
model PageTemplateVersion {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  version    Int
  /// Markdown including YAML frontmatter; the reserved `template:` key holds TemplateMeta.
  source     String
  /// The parsed and validated TemplateMeta — what the API serves.
  meta       Json
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  template PageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@map("page_template_versions")
}

/// A public, read-only link to one page, or to a page and its subtree
/// (docs/features/43, issue #77 phase 1).
///
/// Only the SHA-256 of the `kp_` token is looked up; `token_cipher` is the same
/// token under the secret box (AES-256-GCM, SETTINGS_ENCRYPTION_KEY) so an
/// editor can copy the link again. Null when no key is configured: the link
/// is then shown once, at creation. Revoking keeps the row, for the inventory.
/// No FK on workspace_id or created_by, per house policy.
model ShareLink {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  includeSubtree Boolean   @default(false) @map("include_subtree")
  tokenHash      String    @unique @map("token_hash")
  tokenCipher    String?   @map("token_cipher")
  /// scrypt (auth/password.ts). Changing it ends every unlocked session.
  passwordHash   String?   @map("password_hash")
  /// Readers may download an export of the link's scope (#161). Off by default.
  allowDownload  Boolean   @default(false) @map("allow_download")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([workspaceId, createdAt])
  @@map("share_links")
}

/// Per-workspace publishing switches (docs/features/43): a sparse override of
/// a code default that is `false` for anything public, so an empty table is
/// exactly "nothing is public". PUBLIC_SHARING_ENABLED is the ceiling above it.
model PublishingSettings {
  workspaceId             String   @id @map("workspace_id") @db.Uuid
  allowShareLinks         Boolean? @map("allow_share_links")
  /// Allow a link with neither a password nor an expiry.
  allowPasswordlessShares Boolean? @map("allow_passwordless_shares")
  /// Allow publishing a project as a public docs site (docs/features/44).
  allowPublicSites        Boolean? @map("allow_public_sites")
  /// Show embedded designs' snapshots on share links and published sites (#470). Never their Figma links.
  allowPublicEmbeds       Boolean? @map("allow_public_embeds")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("publishing_settings")
}

/// A project published as a read-only docs site (docs/features/44, issue #77
/// phase 2a). One per project. Public routes never read a branch head: they
/// read a version's snapshot (`site_version_pages`) and nothing else.
model PublishedSite {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  projectId           String    @unique @map("project_id") @db.Uuid
  /// `<slug>.PUBLISH_BASE_DOMAIN`, or `/pub/<slug>` in path mode. A DNS label.
  slug                String    @unique
  /// PUBLISHED_SITE_STATUSES: draft | live | unpublished. Only `live` is served.
  status              String    @default("draft")
  /// Null publishes the whole project; otherwise that page and its subtree.
  /// No FK: a deleted root leaves the site empty rather than blocking the delete.
  rootDocumentId      String?   @map("root_document_id") @db.Uuid
  /// SiteTheme (contracts), always written through normalizeSiteTheme.
  theme               Json      @default("{}")
  seoIndexable        Boolean   @default(true) @map("seo_indexable")
  /// The version served without a version segment. No FK (it points into
  /// this site's own versions, which cascade from it).
  defaultVersionId    String?   @map("default_version_id") @db.Uuid
  /// The HS256 secret a customer's backend signs visitor JWTs with (issue #77
  /// phase 3), under the secret box. Null: visitor sign-in is off.
  visitorSecretCipher String?   @map("visitor_secret_cipher")
  visitorSecretSetAt  DateTime? @map("visitor_secret_set_at") @db.Timestamptz
  /// Ask (issue #77 phase 3): the site answers questions from its own pages,
  /// in the reader and in the embeddable widget.
  askEnabled          Boolean   @default(false) @map("ask_enabled")
  /// Answers a day; null takes PUBLIC_ASK_DAILY_BUDGET, which also caps it.
  askDailyBudget      Int?      @map("ask_daily_budget")
  /// Origins allowed to frame the widget (CSP frame-ancestors), normalized by
  /// contracts `normalizeEmbedOrigin`.
  embedOrigins        String[]  @default([]) @map("embed_origins")
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  project       Project            @relation(fields: [projectId], references: [id])
  versions      SiteVersion[]
  domains       SiteDomain[]
  audienceRules SiteAudienceRule[]

  @@index([workspaceId])
  @@map("published_sites")
}

/// A site's own hostname (docs/features/44, issue #77 phase 2b). Served only
/// once `verified_at` is set: the owner proves control of the name with a TXT
/// record at `_knowledge.<hostname>` holding `verify_token`. Unique across the
/// deployment, so one name routes to one site.
model SiteDomain {
  id          String    @id @default(uuid()) @db.Uuid
  siteId      String    @map("site_id") @db.Uuid
  /// Lower-case ASCII (IDNA/punycode), no port, no trailing dot.
  hostname    String    @unique
  verifyToken String    @map("verify_token")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz
  lastCheckAt DateTime? @map("last_check_at") @db.Timestamptz
  /// SITE_DOMAIN_CHECK_ERRORS: why the last check did not verify; null once it did.
  lastError   String?   @map("last_error")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  site PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_domains")
}

/// A named view of a site: `live` follows a branch and rebuilds itself,
/// `frozen` is a snapshot that changes only when rebuilt by hand.
model SiteVersion {
  id           String    @id @default(uuid()) @db.Uuid
  siteId       String    @map("site_id") @db.Uuid
  name         String
  /// URL segment for a non-default version. Unique per site.
  slug         String
  /// SITE_VERSION_KINDS: live | frozen
  kind         String
  /// Branch name each page is read from; a page without it falls back to its
  /// own default branch. Null = every page's default branch.
  sourceBranch String?   @map("source_branch")
  /// SITE_VERSION_STATUSES: the last build attempt. What is served is whatever
  /// the last successful build wrote (`built_at` not null).
  status       String    @default("building")
  builtAt      DateTime? @map("built_at") @db.Timestamptz
  pageCount    Int       @default(0) @map("page_count")
  /// SiteBuildWarning[] from the last successful build.
  warnings     Json      @default("[]")
  error        String?
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Bumped by every status write, so PublishingSweeper can tell a build
  /// still running from one whose job was lost.
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  site  PublishedSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages SiteVersionPage[]

  @@unique([siteId, slug])
  @@map("site_versions")
}

/// The materialised snapshot: one row per published page, pinning the
/// revision it shows. Replaced as a whole, in one transaction, per build.
/// No FK on document_id/revision_id: a frozen version is a record of what was
/// published, and deleting a page removes its rows explicitly
/// (ProjectCascadeService).
model SiteVersionPage {
  versionId      String                   @map("version_id") @db.Uuid
  documentId     String                   @map("document_id") @db.Uuid
  revisionId     String                   @map("revision_id") @db.Uuid
  /// The nearest published ancestor; null for a top-level page of the site.
  parentId       String?                  @map("parent_id") @db.Uuid
  position       Int
  depth          Int
  /// `guides/install`; '' for the root page of a site published from one page.
  slugPath       String                   @map("slug_path")
  title          String
  /// Site search (issue #77 phase 2b-2): the pinned revision's headings and
  /// body as plain text, written by the build. Snippets are cut from the body.
  searchHeadings String                   @default("") @map("search_headings")
  searchBody     String                   @default("") @map("search_body")
  /// title (A) + headings (B) + body (C) under the `russian` configuration,
  /// which stems English words too. Set by raw SQL after the rows are written;
  /// null = not indexed yet (SiteSearchTextService backfills it).
  searchVector   Unsupported("tsvector")? @map("search_vector")
  /// Search facets (issue #205), so the reader filters inside the snapshot,
  /// never against a head: the page's category when the version was built,
  /// and its pinned revision's frontmatter tags as SiteSearchTag[] — null =
  /// not read yet (SiteSearchTextService backfills it).
  category       String                   @default("other")
  tags           Json?
  /// SITE_AUDIENCES (issue #77 phase 3): the site's audience rules folded down
  /// this page's path. Written by the build and restamped on every rule change,
  /// so a frozen version follows today's rules without changing its content.
  audience       String                   @default("public")
  /// SiteAudienceClaims a `visitors` page requires; null = any visitor.
  audienceClaims Json?                    @map("audience_claims")

  version SiteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, documentId])
  @@unique([versionId, slugPath])
  @@index([documentId])
  @@map("site_version_pages")
}

/// A site's audience rule (issue #77 phase 3, docs/features/44): this page and
/// everything below it are kept from the public. Rules only restrict and add up
/// down the tree (`foldSiteAudience`), so a subpage is never more open than its
/// parent. Per site, not per version: every version's snapshot is restamped
/// from these rows (`SiteAudienceStamper`).
model SiteAudienceRule {
  siteId     String   @map("site_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  /// SITE_AUDIENCE_RULE_KINDS: visitors | members
  audience   String
  /// SiteAudienceClaims for a `visitors` rule; null = any signed-in visitor.
  claims     Json?
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site     PublishedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([siteId, documentId])
  @@index([documentId])
  @@map("site_audience_rules")
}

/// One export of a page, a subtree or a project (issue #77 phase 2c,
/// docs/features/45): the request, the worker's progress and where the file
/// is. The row is what the exports page polls; the bytes are in MinIO under
/// `workspaces/{ws}/exports/{id}/`, deleted after `expires_at` by the API's
/// ExportSweeper, which keeps the row as `expired`.
///
/// No FK anywhere, mirroring import_jobs: a page or project deleted while its
/// export runs must not take the row (or the finished file) with it, and the
/// title is kept for the same reason. No FK on workspace_id or requested_by,
/// per house policy.
model ExportJob {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// EXPORT_SCOPES: page | subtree | project.
  scope       String
  documentId  String? @map("document_id") @db.Uuid
  projectId   String? @map("project_id") @db.Uuid
  /// Per-page branch name, falling back to each page's default; null = default.
  branch      String?
  /// EXPORT_FORMATS: zip | html | pdf | docx.
  format      String
  /// The page's or project's name when the export was asked for.
  title       String

  /// EXPORT_STATUSES: queued → running → completed | failed; completed → expired.
  status    String  @default("queued")
  /// EXPORT_STAGES, while running.
  stage     String?
  pageCount Int?    @map("page_count")
  s3Key     String? @map("s3_key")
  sizeBytes Int?    @map("size_bytes")
  /// `{ code: ExportErrorCode, message }`.
  error     Json?

  /// Language of whoever asked, frozen: the worker renders the contents page
  /// and dates in it, and has no request to read Accept-Language from.
  locale      String    @default("en")
  /// For a share-link download (#161), the link's creator: attribution only.
  requestedBy String    @map("requested_by") @db.Uuid
  /// Set when an anonymous reader asked through a share link (#161). The job
  /// belongs to the link: only that link's public routes can read it, and
  /// only while the link is live with download on. No FK, per house policy.
  shareLinkId String?   @map("share_link_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([status, expiresAt])
  @@index([shareLinkId])
  @@map("export_jobs")
}

// ---------------------------------------------------------------------------
// Chat bots (issue #71): a workspace answering in a messenger. No FK on
// workspace_id / user_id / created_by (house policy); the per-integration rows
// cascade with the integration, because a binding or a link to a bot that no
// longer exists is not a fact about anything.
// ---------------------------------------------------------------------------

/// One bot, connected to one workspace.
model ChatIntegration {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  /// CHAT_PLATFORM_KINDS — 'telegram' | 'time' | 'mattermost' | 'slack'.
  kind        String
  name        String
  enabled     Boolean @default(true)
  /// The messenger's own server, for a platform each customer hosts (Time, Mattermost):
  /// an admin-typed origin, checked by the SSRF guard. '' where the platform
  /// has one fixed API (Telegram) — empty rather than null so the bot-account
  /// unique below still holds for those rows (PG treats nulls as distinct).
  serverUrl   String  @default("") @map("server_url")

  /// AES-256-GCM envelope of the bot token ("gcm$iv$tag$ct"); never leaves the API.
  credential        String?
  credentialHint    String? @map("credential_hint")
  /// SHA-256 of the secret the platform echoes on every delivery (Telegram's
  /// `secret_token`). Only the hash is kept: the secret is handed to the
  /// platform once, when the webhook is set, and compared on the way in.
  inboundSecretHash String? @map("inbound_secret_hash")
  /// AES-256-GCM envelope of the key the platform signs every delivery with
  /// (Slack's signing secret, #380). Unlike Telegram's secret it is the
  /// platform's, not ours, so it is kept to recompute the HMAC; never leaves the API.
  signingSecret     String? @map("signing_secret")
  /// Read from the platform (getMe) whenever the token is saved or tested.
  botUsername       String? @map("bot_username")
  /// The platform's last refusal of setWebhook; null once it was accepted.
  webhookError      String? @map("webhook_error")

  /// null = the researcher.
  defaultAgentKey String?  @map("default_agent_key")
  /// Fallback reply language when neither the person nor the binding says.
  locale          String   @default("en")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bindings      ChatChannelBinding[]
  identities    ChatIdentity[]
  linkCodes     ChatLinkCode[]
  answers       ChatAnswer[]
  conversations ChatConversation[]
  buffered      ChatBufferedMessage[]

  @@unique([workspaceId, name])
  // One bot account serves one workspace: deliveries carry no workspace, so a
  // token connected twice would answer every question in whichever row won.
  // A self-hosted platform names bots per server, so the server is part of it.
  @@unique([kind, serverUrl, botUsername])
  @@map("chat_integrations")
}

/// A group or channel the bot may answer in. DMs need none.
model ChatChannelBinding {
  id             String    @id @default(uuid()) @db.Uuid
  integrationId  String    @map("integration_id") @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  externalChatId String    @map("external_chat_id")
  title          String?
  /// Retrieval scope for answers here; null = the whole workspace.
  projectId      String?   @map("project_id") @db.Uuid
  /// null = the integration's default agent.
  agentKey       String?   @map("agent_key")
  /// CHAT_ANSWER_MODES — 'mention' | 'all' | 'off'.
  answerMode     String    @default("mention") @map("answer_mode")
  locale         String?
  /// Keep this group's messages, masked, so a thread can be harvested (#82).
  /// Telegram only; a workspace admin turns it on, and the group is told.
  listening      Boolean   @default(false)
  /// Automatic harvest (#340): the admin who turned it on, and whom its
  /// captures are attributed to. null = off. Needs `listening`.
  autoHarvestBy  String?   @map("auto_harvest_by") @db.Uuid
  autoHarvestAt  DateTime? @map("auto_harvest_at") @db.Timestamptz
  /// Searchable chat (#339): the admin who turned it on, after the group was
  /// told. null = off. Independent of `listening`, and on every platform.
  searchableBy   String?   @map("searchable_by") @db.Uuid
  searchableAt   DateTime? @map("searchable_at") @db.Timestamptz
  /// Time/Mattermost: the channel's team, for search hits' permalinks (#407).
  /// null = not resolved yet (the next kept message does), '' = in no team.
  teamName       String?   @map("team_name")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  integration   ChatIntegration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  subscriptions ChatSubscription[]
  buffered      ChatBufferedMessage[]
  harvestMarks  ChatHarvestMark[]
  messages      ChatMessage[]
  chunks        ChatChunk[]

  @@unique([integrationId, externalChatId])
  @@map("chat_channel_bindings")
}

/// How far the automatic harvest (#340) has read one listening thread: a
/// group, or one forum topic of it. A thread is due again only once a message
/// newer than `harvestedThrough` has been kept. Moved by a guarded statement
/// before the harvest runs, so two API processes never harvest one thread twice.
model ChatHarvestMark {
  id               String   @id @default(uuid()) @db.Uuid
  bindingId        String   @map("binding_id") @db.Uuid
  /// The Telegram forum topic; '' outside one (a unique key cannot hold a null).
  topicKey         String   @default("") @map("topic_key")
  /// `created_at` of the newest kept message the last harvest read.
  harvestedThrough DateTime @map("harvested_through") @db.Timestamptz
  harvestedAt      DateTime @default(now()) @map("harvested_at") @db.Timestamptz

  binding ChatChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, topicKey])
  @@map("chat_harvest_marks")
}

/// A message kept so a thread can be harvested (#82): a listening group's
/// discussion, or what a person forwarded to the bot in a private chat.
/// Masked before it is written — raw text never reaches this table — and
/// never searched or indexed. A group's rows go after CHAT_LISTEN_TTL_DAYS,
/// with the binding (cascade), when listening is turned off, or per author
/// on /forget; a DM's forwards after HARVEST_FORWARD_WINDOW_SEC or once
/// harvested.
model ChatBufferedMessage {
  id                String   @id @default(uuid()) @db.Uuid
  integrationId     String   @map("integration_id") @db.Uuid
  /// The listening group; null for a forward in a private chat.
  bindingId         String?  @map("binding_id") @db.Uuid
  externalChatId    String   @map("external_chat_id")
  /// A Telegram forum topic; null outside one.
  topicId           String?  @map("topic_id")
  externalMessageId String   @map("external_message_id")
  /// The platform's opaque id for who wrote it: what /forget matches, and how
  /// a harvest tells speakers apart. A forward keeps its original author.
  authorId          String   @map("author_id")
  /// Masked, placeholders numbered per message.
  text              String
  /// When it was written — for a forward, the original's time.
  sentAt            DateTime @map("sent_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  integration ChatIntegration     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  binding     ChatChannelBinding? @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalChatId, externalMessageId])
  @@index([integrationId, externalChatId, topicId, sentAt])
  @@index([authorId])
  @@index([createdAt])
  @@map("chat_buffered_messages")
}

/// A message of a searchable binding (#339), masked on write. Not the harvest
/// buffer above: its own consent, its own retention, and never read by a
/// harvest. Packed into `chat_chunks` by the indexer; `chunkId` null = not yet.
model ChatMessage {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  bindingId         String    @map("binding_id") @db.Uuid
  /// Time/Mattermost: the thread's root post. Telegram: the forum topic, '' outside one.
  threadKey         String    @map("thread_key")
  externalMessageId String    @map("external_message_id")
  /// The platform's opaque id for who wrote it — what /forget matches.
  authorId          String    @map("author_id")
  /// Masked, placeholders numbered per message.
  text              String
  sentAt            DateTime  @map("sent_at") @db.Timestamptz
  editedAt          DateTime? @map("edited_at") @db.Timestamptz
  chunkId           String?   @map("chunk_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  binding ChatChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  chunk   ChatChunk?         @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([bindingId, externalMessageId])
  @@index([bindingId, threadKey, sentAt])
  @@index([chunkId])
  @@index([authorId])
  @@index([sentAt])
  @@map("chat_messages")
}

/// A window of one thread's messages (#339): the unit embedded, matched and
/// returned. Deleting one detaches its messages, which re-index on the next tick.
model ChatChunk {
  id           String                   @id @default(uuid()) @db.Uuid
  workspaceId  String                   @map("workspace_id") @db.Uuid
  bindingId    String                   @map("binding_id") @db.Uuid
  threadKey    String                   @map("thread_key")
  /// Masked; one "author-n: text" line per message.
  text         String
  firstAt      DateTime                 @map("first_at") @db.Timestamptz
  lastAt       DateTime                 @map("last_at") @db.Timestamptz
  messageCount Int                      @map("message_count")
  /// to_tsvector('russian', text), generated in the migration — `russian`
  /// stems ASCII words with english_stem too, so mixed ru/en chat matches
  /// both. Never written by Prisma; the GIN index is raw SQL as well.
  searchTsv    Unsupported("tsvector")? @map("search_tsv")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  binding  ChatChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([bindingId, lastAt])
  @@index([lastAt])
  @@map("chat_chunks")
}

/// A bound group told about pages and merge requests (issue #71, phase 3).
/// Delivered by reading `activity_log` past a cursor — durable and
/// replayable, where the Redis bus would drop whatever a restart missed — and
/// the cursor moves in one guarded update before anything is sent, so two
/// sweeps never send the same rows. Only titles and links reach the group.
model ChatSubscription {
  id              String    @id @default(uuid()) @db.Uuid
  bindingId       String    @map("binding_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  /// null = the whole workspace.
  projectId       String?   @map("project_id") @db.Uuid
  /// string[], folded like tag entity keys (without the `tag:` prefix). Empty = any page.
  tags            Json      @default("[]")
  /// CHAT_SUBSCRIPTION_EVENT_KINDS[].
  eventKinds      Json      @default("[]") @map("event_kinds")
  /// CHAT_SUBSCRIPTION_DELIVERIES — 'instant' | 'digest'.
  delivery        String    @default("instant")
  /// CHAT_DIGEST_MINUTES, when delivery is 'digest'.
  digestMinutes   Int?      @map("digest_minutes")
  /// The last activity row read: (created_at, id), the tie-break for rows
  /// written in the same instant. Starts at the rule's creation — a new rule
  /// is not a replay of the feed.
  cursorAt        DateTime  @default(now()) @map("cursor_at") @db.Timestamptz
  cursorId        String    @default("00000000-0000-0000-0000-000000000000") @map("cursor_id") @db.Uuid
  /// When a digest is next due; null for instant rules, which are due every tick.
  nextDueAt       DateTime? @map("next_due_at") @db.Timestamptz
  lastDeliveredAt DateTime? @map("last_delivered_at") @db.Timestamptz
  /// The platform's last refusal; null once a message goes through.
  lastError       String?   @map("last_error")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  binding ChatChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId])
  @@map("chat_subscriptions")
}

/// A messenger account linked to a person: every answer to it runs as them.
model ChatIdentity {
  id               String   @id @default(uuid()) @db.Uuid
  integrationId    String   @map("integration_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  externalUserId   String   @map("external_user_id")
  externalUserName String?  @map("external_user_name")
  userId           String   @map("user_id") @db.Uuid
  linkedAt         DateTime @default(now()) @map("linked_at") @db.Timestamptz

  integration ChatIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalUserId])
  @@index([userId])
  @@map("chat_identities")
}

/// A one-time code proving a messenger account asked to be linked. Issued only
/// in reply to a verified delivery from that account, in a private chat.
model ChatLinkCode {
  id               String    @id @default(uuid()) @db.Uuid
  integrationId    String    @map("integration_id") @db.Uuid
  externalUserId   String    @map("external_user_id")
  externalUserName String?   @map("external_user_name")
  /// Where to say "linked" once it is — the private chat the code was sent to.
  externalChatId   String    @map("external_chat_id")
  codeHash         String    @unique @map("code_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  usedAt           DateTime? @map("used_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  integration ChatIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, externalUserId])
  @@map("chat_link_codes")
}

/// A chat conversation mapped onto the asker's own assistant thread, so the
/// history, sources and tool trace live in assistant_messages and the person
/// finds it under /assistant. One per asker: a group thread several people
/// ask in is several conversations, because a thread belongs to one person.
model ChatConversation {
  id                String   @id @default(uuid()) @db.Uuid
  integrationId     String   @map("integration_id") @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  externalChatId    String   @map("external_chat_id")
  userId            String   @map("user_id") @db.Uuid
  assistantThreadId String   @map("assistant_thread_id") @db.Uuid
  lastActivityAt    DateTime @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  integration ChatIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, externalChatId, userId, lastActivityAt])
  @@map("chat_conversations")
}

/// One question asked in a chat. The pending row is the claim (the feature-21
/// shape): it is written before the answer exists, so a redelivered update
/// answers once and a reply that dies has somewhere to say so.
model ChatAnswer {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  integrationId      String   @map("integration_id") @db.Uuid
  externalChatId     String   @map("external_chat_id")
  /// The platform's id for the question — with the chat, what makes a redelivery a duplicate.
  inboundMessageId   String   @map("inbound_message_id")
  conversationId     String?  @map("conversation_id") @db.Uuid
  askedBy            String   @map("asked_by") @db.Uuid
  /// The bot's own message: the placeholder, edited into the answer.
  replyMessageId     String?  @map("reply_message_id")
  /// The platform thread the question was asked in, where the platform has
  /// threads (Time's `root_id`, or the question itself when it starts one).
  /// A later message in the same thread is a follow-up. null on Telegram,
  /// which has reply chains instead (`replyMessageId`).
  threadId           String?  @map("thread_id")
  /// Votes key on this (answer_feedback, surface 'chat').
  assistantMessageId String?  @map("assistant_message_id") @db.Uuid
  /// CHAT_ANSWER_STATUSES — 'pending' | 'answered' | 'failed'.
  status             String   @default("pending")
  agentKey           String?  @map("agent_key")
  /// Reply language, frozen at the claim so the reaper can still use it.
  locale             String   @default("en")
  error              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  integration ChatIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalChatId, inboundMessageId])
  @@index([status, createdAt])
  @@index([askedBy, createdAt])
  @@index([integrationId, externalChatId, replyMessageId])
  @@index([integrationId, externalChatId, threadId])
  @@map("chat_answers")
}

/// The operations and channels of one spec revision (#78): a projection of the
/// revision, derived at ingestion and replaced whole when that revision is
/// re-indexed (the `upsertRevisionChunks` pattern). It exists so the reference
/// sidebar, the MR diff and the operation picker are SQL reads, not a re-parse
/// of the spec — never a second answer: the spec in S3 is the truth.
model ApiOperation {
  id          String   @id @default(uuid()) @db.Uuid
  /// From the document, never the caller. No FK, house policy.
  workspaceId String   @map("workspace_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  /// No FK: revisions are immutable and never deleted once indexed.
  revisionId  String   @map("revision_id") @db.Uuid
  /// `http` | `async`
  protocol    String
  /// `GET`… for HTTP; `send` / `receive` (2.x `publish` / `subscribe`) for AsyncAPI.
  method      String?
  /// As the spec spells it: `/users/{id}`, or a channel address.
  path        String
  operationId String?  @map("operation_id")
  /// Canonical (`operationEntityKey` / `channelEntityKey`), the graph vertex.
  entityKey   String   @map("entity_key")
  summary     String?
  tags        String[] @default([])
  deprecated  Boolean  @default(false)
  /// JSON pointer into the spec, for deep links.
  pointer     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Method too: one AsyncAPI channel (one entity) carries a send and a receive.
  @@unique([revisionId, entityKey, method])
  @@index([workspaceId, entityKey])
  @@index([documentId, revisionId])
  @@map("api_operations")
}

/// One `call` step of a QA test fixture revision (#483): which operation the
/// fixture calls, by entity key, in which phase. Revision-scoped and replaced
/// per ingestion like `api_operations`, so the fixture library filters by
/// operation and knowledge health finds a head that calls an operation no spec
/// head defines any more, both in SQL.
model ApiFixtureCall {
  id          String   @id @default(uuid()) @db.Uuid
  /// From the document, never the caller. No FK, house policy.
  workspaceId String   @map("workspace_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  /// No FK: revisions are immutable and never deleted once indexed.
  revisionId  String   @map("revision_id") @db.Uuid
  stepId      String   @map("step_id")
  /// `setup` | `teardown`
  phase       String
  /// Folded `op:` key, as `api_operations.entity_key`.
  entityKey   String   @map("entity_key")
  /// Run order across setup and teardown.
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([revisionId, stepId])
  @@index([workspaceId, entityKey])
  @@map("api_fixture_calls")
}

/// One operation's QA test suite (#468), generated by the `tester` agent. A
/// cache, keyed by what the suite is built from: the operation's content hash
/// (`operationFingerprint`), the case catalogue's version and the agent's
/// effective config, and the head content of every fixture bound to it (#483).
/// A spec revision that leaves the operation alone keeps the row; one that
/// changes it, or a binding or fixture edit, misses, and the next Generate
/// starts a new one. Written by the worker's run; Regenerate overwrites the
/// row in place.
model ApiTestSuite {
  id               String   @id @default(uuid()) @db.Uuid
  /// From the document, never the caller. No FK, house policy.
  workspaceId      String   @map("workspace_id") @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  entityKey        String   @map("entity_key")
  operationHash    String   @map("operation_hash")
  catalogueVersion Int      @map("catalogue_version")
  agentHash        String   @map("agent_hash")
  /// `bindingsHash`: the bound fixtures' ids and head content hashes; '' for none.
  fixturesHash     String   @default("") @map("fixtures_hash")
  /// `ApiTestCase[]`
  cases            Json
  /// The revision it was generated from; later revisions may share the suite.
  revisionId       String   @map("revision_id") @db.Uuid
  agentRunId       String?  @map("agent_run_id") @db.Uuid
  /// No FK, house policy.
  generatedBy      String   @map("generated_by") @db.Uuid
  generatedAt      DateTime @map("generated_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityKey, operationHash, catalogueVersion, agentHash, fixturesHash], name: "suiteKey", map: "api_test_suites_key")
  @@map("api_test_suites")
}

/// A fixture bound to one operation's QA suite (#483, phase 2): suite-level
/// setup when `caseId` is null, otherwise setup for that one case. Keyed by
/// the operation, not the suite row, so a binding survives Regenerate and a
/// spec edit. Confirmed by a person; nothing here is written by a model.
model ApiTestBinding {
  id          String   @id @default(uuid()) @db.Uuid
  /// From the spec document, never the caller. No FK, house policy.
  workspaceId String   @map("workspace_id") @db.Uuid
  /// The spec document.
  documentId  String   @map("document_id") @db.Uuid
  entityKey   String   @map("entity_key")
  /// A case id of the suite's catalogue; null for the whole suite.
  caseId      String?  @map("case_id")
  /// The `test-fixture` document; its default-branch head is what runs.
  fixtureId   String   @map("fixture_id") @db.Uuid
  /// Run order within one (suite, case).
  position    Int
  /// No FK, house policy.
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation("bindingSpec", fields: [documentId], references: [id], onDelete: Cascade)
  fixture  Document @relation("bindingFixture", fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([documentId, entityKey])
  @@index([fixtureId])
  @@map("api_test_bindings")
}

/// Where a QA server run sends and with what (#483, phase 5). Secrets are one
/// `ai/secret-box.ts` envelope of a JSON object, write-only over the API; their
/// names are kept beside it so a reader can see what is set.
model ApiTestEnvironment {
  id            String   @id @default(uuid()) @db.Uuid
  /// No FK, house policy.
  workspaceId   String   @map("workspace_id") @db.Uuid
  name          String
  /// Used for a step whose spec declares it in `servers`.
  server        String?
  /// Non-secret run values by plan name.
  inputs        Json     @default("{}")
  /// `gcm$…` envelope of `{ name: value }`; null for none.
  secretsCipher String?  @map("secrets_cipher")
  secretNames   String[] @default([]) @map("secret_names")
  /// No FK, house policy.
  createdBy     String   @map("created_by") @db.Uuid
  updatedBy     String   @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  runs ApiTestRun[]

  @@unique([workspaceId, name])
  @@map("api_test_environments")
}

/// One QA suite run on the server (#483, phase 5). The API inserts it queued
/// with the plan it will walk (placeholders only, never a value); the worker
/// runs it and writes the results. The last API_TEST_RUNS_KEPT per suite stay.
model ApiTestRun {
  id            String    @id @default(uuid()) @db.Uuid
  /// From the spec document, never the caller. No FK, house policy.
  workspaceId   String    @map("workspace_id") @db.Uuid
  /// The spec document.
  documentId    String    @map("document_id") @db.Uuid
  entityKey     String    @map("entity_key")
  environmentId String?   @map("environment_id") @db.Uuid
  /// queued | running | passed | failed | error
  status        String    @default("queued")
  /// `TestRunPlan`
  plan          Json
  /// `Record<key, TestRunResult>`, secret-named captures left out.
  results       Json      @default("{}")
  passed        Int       @default(0)
  failed        Int       @default(0)
  notRun        Int       @default(0) @map("not_run")
  error         String?
  /// No FK, house policy.
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz

  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  environment ApiTestEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([documentId, entityKey, createdAt(sort: Desc)])
  @@map("api_test_runs")
}

/// Workspace settings outside AI and publishing (#78), one sparse row per
/// workspace: `null` inherits the deployment default or ceiling, so an empty
/// table reproduces the env exactly. Other milestones add their columns here
/// rather than starting another one-row table.
model WorkspaceSettings {
  workspaceId             String   @id @map("workspace_id") @db.Uuid
  /// off | allowlist | open — narrowed by API_TRY_PROXY_MODE, never widened.
  apiTryProxyMode         String?  @map("api_try_proxy_mode")
  /// off | warn | block — the merge gate for breaking spec changes; null is `warn`.
  apiBreakingChangePolicy String?  @map("api_breaking_change_policy")
  /// off | on — the QA server runner (#483); on only when API_TEST_RUNNER_MODE is on too. Null is off.
  apiTestRunner           String?  @map("api_test_runner")
  /// off | warn | block — the style lint of merge requests (#74); null is STYLE_LINT_POLICY.
  lintPolicy              String?  @map("lint_policy")
  /// #75 enterprise auth. Enforced SSO: a session must come from one of this
  /// workspace's providers. Null is off.
  ssoEnforced             Boolean? @map("sso_enforced")
  /// Under enforced SSO, whether `kn_` keys still open this workspace; null is yes.
  allowApiKeys            Boolean? @map("allow_api_keys")
  /// Platform admins may still sign in with a password on an enforced domain; null is no.
  allowPasswordForAdmins  Boolean? @map("allow_password_for_admins")
  /// Cap on a session's age in this workspace, under AUTH_SESSION_TTL_HOURS; null inherits.
  sessionMaxAgeHours      Int?     @map("session_max_age_hours")
  /// #75 SCIM: the role a provisioned user gets without a mapped SCIM group —
  /// a WORKSPACE_ROLES value or `none`; null is `viewer`.
  scimDefaultRole         String?  @map("scim_default_role")
  /// #79 usage analytics: record reads, searches and MCP calls; null inherits
  /// ANALYTICS_ENABLED, and `true` cannot turn on what the env turned off.
  analyticsEnabled        Boolean? @map("analytics_enabled")
  /// Days of analytics rows kept; null inherits ANALYTICS_RETENTION_DAYS, and
  /// a value may only shorten it.
  analyticsRetentionDays  Int?     @map("analytics_retention_days")
  /// #339 searchable chat: days a message is kept; null inherits
  /// CHAT_SEARCH_RETENTION_DAYS, and a value may only shorten it.
  chatSearchRetentionDays Int?     @map("chat_search_retention_days")
  /// #674 crawled web sources, each null = its WEB_SOURCE_CRAWL_* ceiling, and
  /// a value may only lower it: pages per crawl, and the change that waits for
  /// a person on a first crawl / a later one.
  sourceCrawlMaxPages      Int?     @map("source_crawl_max_pages")
  sourceCrawlConfirmFirst  Int?     @map("source_crawl_confirm_first")
  sourceCrawlConfirmChange Int?     @map("source_crawl_confirm_change")
  /// #424 handoff rules, each null = off, all under
  /// WORK_ITEM_AUTOCREATE_MAX_PER_TICK. WORK_ITEM_ISSUE_RULES — off | high | medium | all.
  workItemIssues          String?  @map("work_item_issues")
  /// WORK_ITEM_CONFLICT_RULES — off | on.
  workItemConflicts       String?  @map("work_item_conflicts")
  /// WORK_ITEM_VERIFICATION_RULES — off | outdated | all.
  workItemVerification    String?  @map("work_item_verification")
  /// #604 feature toggles: WORKSPACE_FEATURES values switched off here; empty (no row) is every feature on.
  disabledFeatures        String[] @default([]) @map("disabled_features")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy               String?  @map("updated_by") @db.Uuid

  @@map("workspace_settings")
}

// ---------------------------------------------------------------------------
// #75 enterprise auth: SSO (OIDC, SAML, LDAP), SCIM provisioning, group → role
// mapping. Every table is new, so a code rollback leaves them unread.

/// A sign-in source a workspace trusts. Owned by a workspace; a platform admin
/// may mark one `platformWide` so a single-tenant install has one IdP for all.
model IdentityProvider {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  /// IDP_KINDS — oidc | saml | ldap.
  kind            String
  /// IDP_PRESETS — keycloak | entra | google | yandex | generic.
  preset          String   @default("generic")
  /// The login button label.
  name            String
  enabled         Boolean  @default(false)
  showOnLogin     Boolean  @default(true) @map("show_on_login")
  platformWide    Boolean  @default(false) @map("platform_wide")
  /// Non-secret settings: issuer, client id, scopes, claim map, SAML endpoints, LDAP base DN.
  config          Json     @default("{}")
  /// secret-box ciphertext: OIDC client secret, LDAP bind password, SAML SP key. Write-only over the API.
  secretCipher    String?  @map("secret_cipher")
  jitEnabled      Boolean  @default(false) @map("jit_enabled")
  /// Role a JIT user gets without a group mapping hit; null = no membership.
  defaultRole     String?  @map("default_role")
  /// Email domains this provider may assert. Linking to an existing account requires one.
  allowedDomains  String[] @default([]) @map("allowed_domains")
  groupsClaim     String?  @map("groups_claim")
  /// GROUP_SYNC_MODES — additive | authoritative.
  groupSyncMode   String   @default("additive") @map("group_sync_mode")
  /// Session lifetime for this provider's logins; null = AUTH_SESSION_TTL_HOURS.
  sessionTtlHours Int?     @map("session_ttl_hours")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  identities   UserIdentity[]
  mappings     IdpGroupMapping[]
  authRequests SsoAuthRequest[]
  domains      SsoDomain[]

  @@index([workspaceId])
  @@map("identity_providers")
}

/// One person as one provider knows them. A user signed in through two IdPs has two.
model UserIdentity {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  /// OIDC `sub`, SAML NameID, LDAP entryUUID / objectGUID.
  subject     String
  emailAtLink String?   @map("email_at_link")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@index([userId])
  @@map("user_identities")
}

/// An email domain a workspace claims. Only a verified one may be enforced, so
/// an unproven claim can never lock password users out.
model SsoDomain {
  /// Lower-case, punycode.
  domain            String    @id
  workspaceId       String    @map("workspace_id") @db.Uuid
  providerId        String?   @map("provider_id") @db.Uuid
  /// Expected in the TXT record `_knowledge-challenge.<domain>`.
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz
  enforced          Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  provider IdentityProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("sso_domains")
}

/// An IdP group (a claim value, or a SCIM group when providerId is null) → a workspace role.
model IdpGroupMapping {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  providerId      String?  @map("provider_id") @db.Uuid
  externalGroup   String   @map("external_group")
  role            String
  trustedOperator Boolean  @default(false) @map("trusted_operator")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  provider IdentityProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId, externalGroup])
  @@map("idp_group_mappings")
}

/// A workspace's SCIM bearer token (`kscim_`). Only the SHA-256 is stored; it is never a principal.
model ScimToken {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  tokenHash   String    @unique @map("token_hash")
  prefix      String
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId])
  @@map("scim_tokens")
}

/// What one workspace's SCIM client says about a user. Users are global; this row is not.
model ScimUser {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  externalId  String?  @map("external_id")
  /// The client's `userName`, lower-cased: SCIM matches it case-insensitively
  /// and it is unique per workspace. Often the email, but an Entra UPN need not be.
  userName    String?  @map("user_name")
  active      Boolean  @default(true)
  raw         Json     @default("{}")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@unique([workspaceId, externalId])
  @@unique([workspaceId, userName])
  @@map("scim_users")
}

model ScimGroup {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  externalId  String?  @map("external_id")
  displayName String   @map("display_name")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members ScimGroupMember[]

  @@unique([workspaceId, displayName])
  @@map("scim_groups")
}

model ScimGroupMember {
  groupId String @map("group_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  group ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("scim_group_members")
}

/// A single-use SSO login transaction: state, nonce and PKCE live here, never
/// in the browser. Consumed by one guarded update; purged after expiry.
model SsoAuthRequest {
  id               String    @id @default(uuid()) @db.Uuid
  providerId       String    @map("provider_id") @db.Uuid
  stateHash        String    @unique @map("state_hash")
  nonce            String?
  codeVerifier     String?   @map("code_verifier")
  samlRequestId    String?   @map("saml_request_id")
  returnTo         String    @map("return_to")
  /// The 60 s fragment code the web trades for a session (never the token itself).
  exchangeCodeHash String?   @unique @map("exchange_code_hash")
  userId           String?   @map("user_id") @db.Uuid
  /// The IdP's session id (OIDC `sid`), carried from the callback to the session the exchange opens.
  idpSessionId     String?   @map("idp_session_id")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sso_auth_requests")
}

/// A named instant in a workspace (#81): "v2.3", "Q3 audit". Not a git tag —
/// a point on the graph's valid-time axis that `asOf=tag:<name>` resolves to.
model ReleaseTag {
  id          String   @id @default(uuid()) @db.Uuid
  /// No FK, house policy.
  workspaceId String   @map("workspace_id") @db.Uuid
  /// null = the whole workspace; set = shown in that project's views only.
  projectId   String?  @map("project_id") @db.Uuid
  name        String
  at          DateTime @db.Timestamptz
  note        String?
  /// users.id, or the dev principal's zeros. No FK, house policy.
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([workspaceId, name])
  @@index([workspaceId, at])
  @@map("release_tags")
}

/// A contradiction between two pages (#81), found by the arbiter. A proposal,
/// never a change: a person resolves, dismisses or proposes a fix for it.
model KnowledgeConflict {
  id             String    @id @default(uuid()) @db.Uuid
  /// No FK, house policy.
  workspaceId    String    @map("workspace_id") @db.Uuid
  /// CONFLICT_KINDS.
  kind           String
  /// CONFLICT_STATUSES.
  status         String    @default("open")
  /// sha256 over both sides' page and normalized quote, order-free: the same
  /// disagreement found twice is one row.
  fingerprint    String
  aDocumentId    String    @map("a_document_id") @db.Uuid
  aRevisionId    String    @map("a_revision_id") @db.Uuid
  aChunkId       String?   @map("a_chunk_id")
  aQuote         String    @map("a_quote")
  /// Null for a conflict between a page and code (the sentinel's, a later phase).
  bDocumentId    String?   @map("b_document_id") @db.Uuid
  bRevisionId    String?   @map("b_revision_id") @db.Uuid
  bChunkId       String?   @map("b_chunk_id")
  bQuote         String?   @map("b_quote")
  codeRef        Json?     @map("code_ref")
  explanation    String
  confidence     Float
  agentRunId     String?   @map("agent_run_id") @db.Uuid
  /// The finding on that run that reported it, so "propose a fix" reuses the finding's path.
  findingIndex   Int?      @map("finding_index")
  mergeRequestId String?   @map("merge_request_id") @db.Uuid
  detectedAt     DateTime  @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolution     String?

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status, detectedAt])
  @@index([aDocumentId, status])
  @@index([bDocumentId, status])
  @@map("knowledge_conflicts")
}

// ---------------------------------------------------------------------------
// #79 usage & search analytics. Event rows only: one row per thing that
// happened, and every dashboard number a rollup over them at read time. No FK
// on workspace/project/document/search ids (house policy) — an event outlives
// the page it describes, as activity_log does. Never a user id: a reader is
// `reader_key`, an HMAC per workspace, so readers can be counted but not named.

/// One page open. A web view is one row however long it stays open: the
/// heartbeat folds read time into it rather than adding a row per tick.
model PageView {
  /// The web's own viewId (so a replayed beacon is a no-op), else a server uuid.
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Denormalized at write time by the recorder; a later move keeps the old one.
  projectId   String?  @map("project_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  revisionId  String?  @map("revision_id") @db.Uuid
  /// ANALYTICS_CHANNELS
  channel     String
  /// HMAC(secret, workspaceId:userId); null under DNT / GPC.
  readerKey   String?  @map("reader_key")
  apiKeyId    String?  @map("api_key_id") @db.Uuid
  /// Set when the view came from a search result (?sid=&rank=).
  searchId    String?  @map("search_id") @db.Uuid
  searchRank  Int?     @map("search_rank")
  /// Web only; capped at ANALYTICS_READ_TIME_CAP_MS.
  activeMs    Int      @default(0) @map("active_ms")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([documentId, createdAt])
  @@index([searchId])
  @@map("page_views")
}

/// One executed search, from any surface.
model SearchQuery {
  id           String   @id @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// The project filter the caller applied (string[]).
  projectIds   Json     @default("[]") @map("project_ids")
  /// Trimmed, NFC, at most 500 chars. Nulled by retention after ANALYTICS_QUERY_TEXT_DAYS.
  queryText    String?  @map("query_text")
  /// sha256 of the folded text: the grouping key that survives redaction.
  queryHash    String   @map("query_hash")
  mode         String
  resultCount  Int      @map("result_count")
  /// The top 10 document ids returned, in rank order.
  resultDocIds Json     @default("[]") @map("result_doc_ids")
  channel      String
  readerKey    String?  @map("reader_key")
  apiKeyId     String?  @map("api_key_id") @db.Uuid
  durationMs   Int      @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([workspaceId, queryHash, createdAt])
  @@index([workspaceId, resultCount, createdAt])
  @@map("search_queries")
}

/// One MCP tool invocation, HTTP or stdio.
model McpToolCall {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null when the tool takes no workspace (whoami) or names it some other way.
  workspaceId String?  @map("workspace_id") @db.Uuid
  tool        String
  ok          Boolean
  /// The thrown error's class name, or `tool-error` for an isError result.
  errorCode   String?  @map("error_code")
  readerKey   String?  @map("reader_key")
  apiKeyId    String?  @map("api_key_id") @db.Uuid
  durationMs  Int      @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt])
  @@index([apiKeyId, createdAt])
  @@map("mcp_tool_calls")
}

/// Embeds (#470, docs/features/64). Which Figma files a connector's allowlist
/// reaches, as last listed: Figma's file metadata does not name a file's
/// project, so membership is resolved by listing the allowlisted projects. The
/// read-time check is this row + its connector's current allowlist. Mutable;
/// re-listed when a file is not found or the row is stale.
model EmbedFile {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  provider    String   @default("figma")
  fileKey     String   @map("file_key")
  name        String
  connectorId String   @map("connector_id") @db.Uuid
  projectId   String   @map("project_id")
  teamId      String?  @map("team_id")
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz

  @@unique([workspaceId, provider, fileKey])
  @@index([connectorId])
  @@map("embed_files")
}

/// One pinned item, rendered (#470). Content-addressed by (workspace, provider,
/// file, node, version) and shared by every page and revision that references
/// it; immutable once rendered, because a pinned version never changes. A
/// failed render is a row with `error` and `retryAt`, not a missing row.
/// `nodeId` is '' for a whole-file item.
model EmbedNode {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  provider    String    @default("figma")
  fileKey     String    @map("file_key")
  nodeId      String    @map("node_id")
  version     String
  name        String?
  /// Text layers of the node, deduplicated and capped (EMBED_TEXT_MAX_BYTES). Untrusted.
  text        String?
  subtreeHash String?   @map("subtree_hash")
  snapshotKey String?   @map("snapshot_key")
  width       Int?
  height      Int?
  error       String?
  retryAt     DateTime? @map("retry_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, provider, fileKey, nodeId, version])
  @@map("embed_nodes")
}

/// What a revision embeds (#470), written by the ingestion worker from the
/// revision's markdown: one row per item, in group and position order. The
/// snapshot route serves an item only when a row ties it to the document.
/// `warning` is what the markdown itself got wrong (unknown-provider,
/// unpinned, over-limit); allowlist state is derived on read, never stored.
/// No FK, as for revision_diffs: the project cascade deletes it explicitly.
model RevisionEmbed {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  documentId  String  @map("document_id") @db.Uuid
  revisionId  String  @map("revision_id") @db.Uuid
  groupIndex  Int     @map("group_index")
  position    Int
  url         String
  provider    String?
  fileKey     String? @map("file_key")
  /// '' for a whole-file item; null when no provider claims the URL.
  nodeId      String? @map("node_id")
  version     String?
  caption     String  @default("")
  warning     String?

  @@unique([revisionId, groupIndex, position])
  @@index([documentId, fileKey, nodeId, version])
  @@index([workspaceId, fileKey])
  @@map("revision_embeds")
}

/// One internal link on a page's default-branch head (#673): `/documents/<id>`
/// or the same path on WEB_BASE_URL, with its `#anchor` when it has one. The
/// worker replaces a page's rows whenever its head is indexed, so the table
/// only ever holds what the pages say now; backlinks read it by target. No FK
/// on either document (house policy): a target may not exist, and the source's
/// rows go with it in `cascadeDocuments`.
model PageLink {
  id               String  @id @default(uuid()) @db.Uuid
  workspaceId      String  @map("workspace_id") @db.Uuid
  sourceDocumentId String  @map("source_document_id") @db.Uuid
  sourceRevisionId String  @map("source_revision_id") @db.Uuid
  targetDocumentId String  @map("target_document_id") @db.Uuid
  targetAnchor     String? @map("target_anchor")

  @@index([sourceDocumentId])
  @@index([workspaceId, targetDocumentId])
  @@map("page_links")
}

/// A pinned node as it is in Figma now (#470): the file's current version and
/// the node's subtree hash, written by the Figma connector's change check.
/// "Design changed" is derived on read — this hash against the pinned one in
/// `embed_nodes` — and never stored. Mutable; one row per node.
model EmbedNodeHead {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  provider       String   @default("figma")
  fileKey        String   @map("file_key")
  nodeId         String   @map("node_id")
  currentVersion String   @map("current_version")
  currentHash    String   @map("current_hash")
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz

  @@unique([workspaceId, provider, fileKey, nodeId])
  @@map("embed_node_heads")
}

/// A recording uploaded for transcription (#551, docs/features/68). A row of
/// its own, never a document: not indexed, not searchable, and read only by
/// its uploader (`created_by`; platform admins bypass) and its own analysis
/// run. No FK on workspace_id / created_by, house policy.
model Memo {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  createdBy   String  @map("created_by") @db.Uuid
  title       String
  filename    String
  contentType String  @map("content_type")
  sizeBytes   Int     @default(0) @map("size_bytes")
  /// `workspaces/{ws}/memos/{id}/source.<ext>`; kept after a purge so the
  /// delete path never has to guess it.
  audioKey      String    @map("audio_key")
  /// Set when the retention sweeper (or a delete) removed the audio; the
  /// transcript stays.
  audioPurgedAt DateTime? @map("audio_purged_at") @db.Timestamptz
  /// The browser's claim until the worker's ffprobe replaces it.
  durationSeconds Int?    @map("duration_seconds")
  /// The language the speech server detected first; never a translation target.
  language        String?

  /// MemoStatus: pending → uploaded → transcribing → transcribed → analysing → done | failed.
  status String  @default("pending")
  /// The step a failed memo failed in — what Retry resumes from.
  stage  String?
  error  String?

  /// MemoSegment[] — masked before it is written. Never selected by the list.
  transcript   Json?
  summary      String?
  /// MemoDropped[] — proposals the analysis made and the code refused, with why.
  dropped      Json?
  agentRunId   String?   @map("agent_run_id") @db.Uuid
  /// Claimed by MemoPublishSweeper before it opens anything, so it publishes once.
  publishedAt  DateTime? @map("published_at") @db.Timestamptz
  /// The uploader's language, frozen for the worker and the sweeper.
  locale       String    @default("en")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([workspaceId, createdBy, createdAt])
  @@index([status])
  @@map("memos")
}
