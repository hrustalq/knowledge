exports[`renderCaptureKit > renders the cursor kit > .cursor/hooks/knowledge-capture.sh 1`] = `
"#!/bin/sh
# Knowledge capture kit v1 for Cursor: generated by https://kb.example.com/api/v1/mcp/capture-kit.
# Re-fetch it to update — local edits are overwritten.
#
#   knowledge-capture.sh edited   afterFileEdit: the session changed a file
#   knowledge-capture.sh stop     stop: remind the model to capture, once per session, only after an edit
#
# It holds no key and calls nothing; it only prints a reminder. Hook JSON is on stdin.
in=$(tr -d '\\n\\r')
id=$(printf '%s' "$in" | sed -n 's/.*"conversation_id"[[:space:]]*:[[:space:]]*"\\([A-Za-z0-9._-]\\{1,200\\}\\)".*/\\1/p')
[ -n "$id" ] || exit 0
dir="\${TMPDIR:-/tmp}/knowledge-capture"
mkdir -p "$dir" 2>/dev/null || exit 0
case "\${1:-}" in
  edited)
    : >"$dir/$id.edited"
    ;;
  stop)
    case "$in" in *'"status":"completed"'* | *'"status": "completed"'*) ;; *) exit 0 ;; esac
    [ -f "$dir/$id.edited" ] || exit 0
    # mkdir is atomic: whichever stop gets here first reminds, every later one is silent.
    mkdir "$dir/$id.reminded" 2>/dev/null || exit 0
    msg=$(printf 'Before you finish: this session changed files. If it settled a decision, hit a non-obvious gotcha, followed a team convention or answered a question that took real digging, record each one with the knowledge-capture rule (knowledge_capture_decision, knowledge_capture_note) and session.client cursor, session.sessionId %s. Call knowledge_find_similar first and skip what the knowledge base already says. Never include secrets. If nothing is worth keeping, say so in one line and stop. This reminder comes once per session.' "$id")
    printf '{"followup_message":"%s"}\\n' "$msg"
    ;;
esac
exit 0
"
`;

