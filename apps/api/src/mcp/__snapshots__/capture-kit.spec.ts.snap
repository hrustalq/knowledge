  k=$(printf '%s' "$1" | grep -oE 'https?://[^" ]+/(issues|browse|issue)/[A-Za-z0-9_-]+' | head -n 1 | sed 's#.*/##')
  [ -n "$k" ] || k=$(printf '%s' "$1" | grep -oE '[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+' | head -n 1 | sed 's/.*#//')
  [ -n "$k" ] || k=$(printf '%s' "$1" | grep -oE '(^|[^A-Za-z0-9_-])[A-Z][A-Z0-9]{1,9}-[0-9]{1,7}' | sed 's/^[^A-Z]*//' | grep -vE '^(UTF|ISO|SHA|GPT|RFC|TLS|SSL|HTTP|IPV|ES|MD)-' | head -n 1)
  printf '%s' "$k" | tr -cd 'A-Za-z0-9_-' | cut -c 1-64
}
# Once per ticket per session: mkdir is atomic, so a second read of the same ticket is silent.
# Collects the new keys; tell then words one nudge naming all of them, or exits.
keys=
nudge() {
  [ -n "$1" ] || return 0
  mkdir "$dir/$id.ticket.$1" 2>/dev/null || return 0
  keys="\${keys:+$keys, }$1"
}
tell() {
  [ -n "$keys" ] || exit 0
  msg=$(printf 'Ticket %s: before you start, call knowledge_context once per ticket with query = the ticket title and key terms, repo = git remote get-url origin, exclude = ids already shown. Open a page only if the task needs it.' "$keys")
}

case "\${1:-}" in
  ticket)
    tool=$(printf '%s' "$in" | sed -n 's/.*"tool_name"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p')
    # The tool's input only: its output can name any number of other tickets.
    case "$in" in *'"tool_input"'*) ;; *) exit 0 ;; esac
    args=\${in#*'"tool_input"'}
    args=\${args%%'"tool_response"'*}
    args=\${args%%'"tool_output"'*}
    case "$tool" in
      Bash | Shell)
        # Every read in the command, each ending at a shell separator or an escape
        # (a JSON \\n): \`gh issue view 1; gh issue view 2\` reads two tickets.
        # A here-document, not a pipe, so the loop's nudges stay in this shell.
        while IFS= read -r cmd; do
          k=$(ticket "$cmd")
          [ -n "$k" ] || k=$(printf '%s' "$cmd" | sed -n 's/^[a-z]* issue view \\([0-9][0-9]*\\).*/\\1/p')
          nudge "$k"
        done <<KNOWLEDGE_CMDS
$(printf '%s' "$args" | grep -oE '(gh|glab|jira) issue view [^"\\;&|]*')
KNOWLEDGE_CMDS
        ;;
      *)
        printf '%s' "$tool" | grep -qiE 'jira|linear|atlassian|issue|ticket' || exit 0
        k=$(ticket "$args")
        [ -n "$k" ] || k=$(printf '%s' "$args" | grep -oE '"(issue_number|issueNumber|issue_id|issueId|iid|number)"[[:space:]]*:[[:space:]]*"?[0-9]+' | head -n 1 | grep -oE '[0-9]+$')
        nudge "$k"
        ;;
    esac
    tell
    printf '{"additional_context":"%s"}\\n' "$msg"
    ;;
  edited)
    : >"$dir/$id.edited"
    ;;
  stop)
    case "$in" in *'"status":"completed"'* | *'"status": "completed"'*) ;; *) exit 0 ;; esac
    [ -f "$dir/$id.edited" ] || exit 0
    # mkdir is atomic: whichever stop gets here first reminds, every later one is silent.
    mkdir "$dir/$id.reminded" 2>/dev/null || exit 0
    msg=$(printf 'Before you finish: this session changed files. If it settled a decision, hit a non-obvious gotcha, followed a team convention or answered a question that took real digging, record each one with the knowledge-capture rule (knowledge_capture_decision, knowledge_capture_note) and session.client cursor, session.sessionId %s. Call knowledge_find_similar first with the title and kind you will capture with, and skip it when decision is duplicate. Never include secrets. If nothing is worth keeping, say so in one line and stop. This reminder comes once per session.' "$id")
    printf '{"followup_message":"%s"}\\n' "$msg"
    ;;
esac
exit 0
"
`;

exports[`renderCaptureKit > renders the cursor kit > .cursor/rules/knowledge-capture.mdc 1`] = `
"---
description: Record the decisions, gotchas, conventions and hard-won answers from this session in the Knowledge platform at kb.example.com, as merge requests a person reviews. Use when finishing a piece of work or when the knowledge-capture hook asks.
alwaysApply: false
---

# Knowledge capture

The capture tools are \`knowledge_*\` tools of the \`knowledge\` MCP server (\`https://kb.example.com/api/v1/mcp\`). If they are not
available, the server is not connected: say so once, and do not improvise with web requests. The
\`knowledge-platform\` skill covers reading and searching the knowledge base.

## Where to capture

Pick the project the work belongs to. \`knowledge_whoami\` is the live answer if this list looks stale.

- Eng ops team — \`workspaceId: 11111111-1111-4111-8111-111111111111\`
  - Billing — \`projectId: 22222222-2222-4222-8222-222222222222\`

Captured merge requests are reviewed at \`https://kb.example.com/merge-requests\`; every capture is listed at
\`https://kb.example.com/captures\`.

## Capture memory

What this session learned disappears when it ends unless it is written down. The capture tools propose it back into
the knowledge base: each capture is staged, checked against what the knowledge base already says, and opened as a merge
request a person reviews. Nothing you capture changes a page until someone merges it.

### What is worth capturing

Capture at the end of a piece of work, or when a hook reminds you — not after every edit — and only what the next
person or agent would otherwise have to rediscover:

| Learned | Tool |
| --- | --- |
| A decision, with its reasons and the options ruled out | \`knowledge_capture_decision\` |
| A gotcha: a non-obvious failure and its cause | \`knowledge_capture_note\`, \`kind: "gotcha"\` |
| A convention the team holds | \`knowledge_capture_note\`, \`kind: "convention"\` |
| A how-to that took real digging | \`knowledge_capture_note\`, \`kind: "howto"\` |
| A term the codebase uses in its own sense | \`knowledge_propose_glossary_term\` |
| A dependency a page should record | \`knowledge_propose_relation\` |
| An answer that took many tool calls, citing its pages | \`knowledge_propose_answer\` |

### What is not

- Secrets, credentials, tokens or personal data. A capture carrying one is refused; never rephrase around the check.
- Transient debugging, the steps of this session, or what the diff already shows.
- Anything the knowledge base already says. Call \`knowledge_find_similar\` first with the \`title\`, \`kind\` and
  \`projectId\` you will capture with, so it scores what the capture will, and skip it when \`decision\` is \`duplicate\`.
- Text copied from a page. Point at the page (\`relatedDocumentIds\`) instead.

### How

1. One capture per fact: two decisions are two calls.
2. Write for a reader who was not here. The title is the claim; the body says why.
3. Always pass \`session\`: \`client\` (\`claude-code\`, \`cursor\`, \`codex\`, \`gemini\` or \`other\`), the \`sessionId\` a hook
   gave you, \`repo\` (\`git remote get-url origin\`), \`branch\` (\`git rev-parse --abbrev-ref HEAD\`), \`commit\`
   (\`git rev-parse HEAD\`) and \`files\` — the repository paths involved, paths only, never their contents.
4. Read the reply. \`state: "duplicate"\` means the knowledge base already says it: stop there. Otherwise give the user
   \`webUrl\`, the merge request a person will review.
5. A \`429\` means the capture budget is spent for now. Say so and move on; do not retry in a loop.
"
`;

exports[`renderCaptureKit > renders the cursor kit 1`] = `
[
  [
    ".cursor/rules/knowledge-capture.mdc",
    "write",
    false,
  ],
  [
    ".cursor/hooks/knowledge-capture.sh",
    "write",
    true,
  ],
  [
    ".cursor/hooks.json",
    "merge",
    false,
  ],
]
`;
