{
  "name": "@knowledge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node server",
    "lint": "echo web: lint via typecheck",
    "typecheck": "vue-tsc -b",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@knowledge/contracts": "workspace:*",
    "@lucide/vue": "^1.38.0",
    "@tanstack/vue-query": "^5.102.8",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.14",
    "express": "^5.2.1",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "pinia": "^3.0.3",
    "reka-ui": "^2.10.4",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.32",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "^0.1.0",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.6"
  }
}
