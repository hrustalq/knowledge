{
  "name": "@knowledge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --ssr --outDir dist/server && node scripts/check-ssr-chunks.mjs",
    "analyze:bundle": "cross-env BUNDLE_ANALYZE=1 npm run build:client",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "cross-env NODE_ENV=production node server",
    "lint": "eslint src",
    "depcruise": "depcruise src --output-type err-long --ignore-known",
    "depcruise:baseline": "depcruise src --baseline --baseline-mode shrink-only",
    "depcruise:graph": "depcruise src --output-type archi | dot -T svg > dependency-graph.svg",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:docs": "node scripts/generate-docs-reference.mjs",
    "lint:i18n-baseline": "eslint src --prune-suppressions"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@hocuspocus/provider": "4.9.0",
    "@knowledge/api-client": "workspace:*",
    "@knowledge/contracts": "workspace:*",
    "@knowledge/editor-schema": "workspace:*",
    "@knowledge/observability": "workspace:*",
    "@knowledge/ui": "workspace:*",
    "@knowledge/workflow": "workspace:*",
    "@tanstack/vue-query": "^5.108.2",
    "@tanstack/vue-virtual": "^3.13.52",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-collaboration": "3.35.0",
    "@tiptap/extension-collaboration-caret": "3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "@tiptap/y-tiptap": "3.3.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.21.1",
    "compression": "^1.8.2",
    "d3-force": "^3.0.1",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.1",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.2.1",
    "mermaid": "^11.17.2",
    "motion-v": "^2.13.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.11.0",
    "rxjs": "^7.8.2",
    "sirv": "^3.0.2",
    "turndown": "^7.2.5",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "xstate": "^5.33.4",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.5.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "openapi-typescript-helpers": "^0.1.0",
    "rollup-plugin-visualizer": "7.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.2.6",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
