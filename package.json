{
  "name": "knowledge",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "depcruise": "turbo depcruise && pnpm run depcruise:packages",
    "depcruise:packages": "depcruise packages --output-type err-long",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "dependency-cruiser": "^18.3.0",
    "husky": "^9.1.7",
    "turbo": "^2.10.12"
  },
  "dependencies": {
    "xstate": "^5.32.6"
  }
}
