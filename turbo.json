{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "NODE_TLS_REJECT_UNAUTHORIZED"],
  "globalPassThroughEnv": ["NODE_OPTIONS", "NODE_EXTRA_CA_CERTS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "dev:worker": {
      "cache": false,
      "persistent": true
    }
  }
}
